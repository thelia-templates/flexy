{% extends 'base.html.twig' %}

{% block title %}{{ 'Sign up'|trans }}{% endblock %}

{% block body %}
    <twig:Molecules:CheckoutSteps:Base
        :steps="[{text: 'Your login', link: path('customer_register')}, {text: 'Your informations', link: path('customer_informations')}]"
        current="2"
        noCart
    />

    <div class="container-m pt-8 pb-14 lg:pt-12 lg:pb-30">
        <h2 class="h2 text-black mb-4">{{ 'Create account'|trans }}</h2>
        <p class="paragraph-2 text-black mb-8">
            {{ newsletter_enabled() ? 'With your account, you can track your orders, manage your profile, receive the newsletter, manage your wish lists...'|trans : 'With your account, you can track your orders, manage your profile, manage your wish lists...'|trans }}
        </p>

        <twig:Forms:CustomerInformation:Base :formData="{firstname: firstname, lastname: lastname}" />
    </div>
{% endblock %}
