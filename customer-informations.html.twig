{% extends 'base.html.twig' %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}

{% block title %}Register
{% endblock %}

{% block body %}
    {{ component('Flexy:Checkout:CheckoutSteps',{
        steps: [
            {
                text: 'Your login'|trans
            },
            {
                text: 'Your informations'|trans,
            },
        ],
        current: 2,
    } ) }}

    <div class="w-full max-w-[400px] px-[25px] pt-[30px] pb-[54px] lg:px-0 lg:pt-[50px] lg:pb-[120px] mx-auto">
        <h1 class="mb-4 text-black h2">{{ 'Create account'|trans }}</h1>
        <p class="mb-8">
            {{ 'With your account, you can track your orders, manage your profile, receive the newsletter, manage your wish lists...'|trans }}
        </p>
        {{ component('Flexy:CustomerInformationForm', {
            formData : {
                firstname,
                lastname,
                success_url: path('customer_activation', {email})
            }
        }) }}
    </div>
{% endblock %}
