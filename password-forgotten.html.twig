{% extends 'base.html.twig' %}

{% block title %}{{ 'Forgot password?'|trans }}{% endblock %}

{% block body %}
    {% set form = getForm('thelia_customer_lost_password') %}
    {% form_theme form with flexy_form_themes only %}

    <div class="container-s pt-8 pb-14 lg:pt-12 lg:pb-30">
        <h2 class="h2 text-black mb-4">{{ 'Forgot your password ?'|trans }}</h2>
        <p class="paragraph-2 text-black mb-6">{{ 'Enter your e-mail address to receive a reset link.'|trans }}</p>

        {% do override_labels(form, {
            email: 'Email'|trans,
        }) %}
        {{ form_start(form, {attr: {
            action: path('password_forgotten_send'),
            method: 'POST',
            class: 'flex flex-col gap-6',
        }}) }}
        {{ form_row(form.success_url, {value: path('password_reset_link')}) }}
        {{ form_row(form.error_url, {value: path('password_forgotten')}) }}
        {{ form_row(form.email, {placeholder: 'Your email'|trans}) }}

        <twig:Molecules:Button:Base text="{{ 'Send link'|trans }}" type="submit" class="w-max" />
        {{ form_end(form) }}

        <hr class="my-10" />

        <twig:Molecules:Link:Base href="{{ path('customer_login') }}" customText="{{ 'Back to login'|trans }}" />
    </div>
{% endblock %}
