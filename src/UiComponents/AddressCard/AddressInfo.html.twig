{% if title %}
    {% set name = address.label ? address.label : address.firstname ~ ' ' ~ address.lastname %}
{% else %}
    {% set title = address.label %}
    {% set name = address.firstname ~ ' ' ~ address.lastname %}
{% endif %}
<span>
    <span class="AddressCard-title">
        {{ title }}
    </span>
    <span class="AddressCard-name">
        {{ name }}
    </span>
    <span class="AddressCard-address">
        <span class="block">
            {{ [address.address1,address.address2 ?? '',address.address3 ?? '']|join(', ') }}
        </span>
        <span class="block">
            {% set country = resources('/api/front/countries/' ~ address.countryId) %}
            {{ [address.zipcode,address.city ?? '',country.isoalpha3 ?? '']|join(', ') }}
        </span>
        <span class="AddressCard-phone">
            {{ address.phone }}
        </span>
    </span>
</span>
