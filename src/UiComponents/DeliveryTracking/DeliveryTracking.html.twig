<div class="DeliveryTracking">
    <div class="DeliveryTracking-content">
        <div>
            <div class="DeliveryTracking-title">
                {{ 'Delivery tracking'|trans }}
            </div>
            <div class="DeliveryTracking-desc">
                {{ 'Tracking number'|trans }}
                {{ ref }}
            </div>
        </div>
        {% if trackLink %}
            {{ component('Flexy:Button', {
                text: 'Track my package'|trans|trans,
                href: trackLink,
                size: 'small',
            }) }}
        {% endif %}
    </div>
    <hr/>
    <ul class="DeliveryTracking-steps">
        {% for index, step in this.steps %}
            <li class="DeliveryTracking-step {% if index == status %}DeliveryTracking-step--active{% endif %}">
                <span class="DeliveryTracking-icon">
                    {% if index <= status %}
                        {{ ux_icon('checkmark') }}
                    {% endif %}
                </span>
                {{ step|trans }}
            </li>
        {% endfor %}
    </ul>
</div>
