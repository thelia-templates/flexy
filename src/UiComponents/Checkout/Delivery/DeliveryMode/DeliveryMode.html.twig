
<div {{attributes.defaults({class: 'DeliveryMode DeliveryModule ' ~ (this.checked ? 'selected ' : '') ~ type })}}  {% block stimulus %}{% endblock %}>

    <label class='DeliveryMode-content'>
        {{ component('Flexy:RadioButton', {
            'data-action': 'live#emit',
            'data-live-event-param': constant('FlexyBundle\\UiComponents\\Checkout\\CheckoutEvents::SET_DELIVERY_MODULE_OPTION'),
            'data-live-option-code-param': this.optionCode,
            'data-live-module-id-param': this.moduleId,
            checked : this.checked
        })}}

        <span>
			<div class='flex justify-between'>
				<div>
					<span class='DeliveryMode-title'>{{ this.title }}</span>
		            <span class='DeliveryMode-description'>{{ this.description }}</span>
                    {% if moduleDescription %}
                        <span class='DeliveryMode-moduleDescription'>{{ moduleDescription|raw }}</span>
                    {% endif %}
				</div>
				{% if icon %}
                    <div class="w-12 h-12 text-theme-medium">
					{{ ux_icon(icon) }}
				</div>
                {% endif %}
			</div>
			<div class='flex items-center mt-6'>
				<span class='DeliveryMode-price'>{{ this.price ? this.price|format_currency('EUR', locale: lang_code) : 'Free'|trans }}</span>
			</div>

            {% block content %}{% endblock %}

            <div class="DeliveryMode-children {% if not this.checked %}hidden{% endif %}">
                {% block children %}{% endblock %}
            </div>

		</span>
    </label>
    {% block footer %}{% endblock %}
</div>
