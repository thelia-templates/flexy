<div {{ attributes }}>
    <h1 class="text-black h4">
        {{ 'Choose a delivery address'|trans }}
    </h1>
    <div class="my-8">
        {% if this.showNewAddressForm %}
            {% component ('Flexy:AddressesForm') %}
                {% block footer %}

                    {{ component('Flexy:Button', {
                        type: 'button',
                        color: 'secondary',
                        text: 'Cancel'|trans,
                        'data-action': 'live#emitUp',
                        'data-live-event-param': 'cancelAddressForm',
                    }) }}

                    {{ component('Flexy:Button', {
                        type: 'submit',
                        text: 'Confirm'|trans,
                    }) }}

                {% endblock %}
            {% endcomponent %}
        {% elseif this.editingAddressId %}
            <div>
                {% component ('Flexy:AddressesForm') with {addressId: this.editingAddressId} %}
                    {% block footer %}

                        {{ component('Flexy:Button', {
                            type: 'button',
                            color: 'secondary',
                            text: 'Cancel'|trans,
                            'data-action': 'live#emitUp',
                            'data-live-event-param': 'cancelAddressForm',
                        }) }}

                        {{ component('Flexy:Button', {
                            type: 'submit',
                            text: 'Confirm'|trans,
                        }) }}

                    {% endblock %}
                {% endcomponent %}
            </div>
        {% else %}
            <div>
                {% if this.addressList|length <= 0 %}
                    <div class="flex flex-col items-start">
                        <span class="HomeDelivery-noAddress">
                            {{ 'You have no registered address'|trans }}
                            :
                        </span>
                        {{ component('Flexy:Button', {
                            type: 'button',
                            text: 'Add an address'|trans,
                            'data-action': 'live#action',
                            'data-live-action-param': 'toggleNewAddressForm',
                        }) }}
                    </div>
                {% else %}
                    <ul class="flex flex-col gap-2">
                        {% for address in this.addressList %}
                            <li>
                                {{ component('Flexy:Checkout:AddressCardCheckout', {
                                    addressId: address.id
                                })
                                }}
                            </li>
                        {% endfor %}
                    </ul>

                    <div class="flex flex-col gap-2 mt-4 lg:flex-row lg:items-center">

                        {{ component('Flexy:Button', {
                            type: 'button',
                            text: 'Use another address'|trans,
                            'data-action': 'live#action',
                            'data-live-action-param': 'toggleNewAddressForm',
                        }) }}
                    </div>
                {% endif %}
            </div>
        {% endif %}
    </div>
    <h2 class="text-black h4">
        {{ 'Choose a delivery method'|trans }}
    </h2>
    <div class="flex flex-col gap-3.5 my-5">
        {% if this.deliveryModulesOptions is defined and this.deliveryModulesOptions|length > 0 %}

            {% for moduleName,option in this.deliveryModulesOptions %}
                {% if option.deliveryMode == enum('Thelia\\Domain\\Checkout\\Enum\\DeliveryMode').DELIVERY.value %}
                    {{ component('Flexy:Checkout:Delivery:HomeDelivery', {
                        title: option.title,
                        date: 'TODO BACK',
                        price: option.postage ?? '0',
                        optionCode: option.code,
                        moduleId: option.moduleId,
                        deliveryAddressId: this.deliveryAddressId,
                        invoiceAddressId: this.invoiceAddressId,
                        icon: 'reinsurance-homedelivery',
                        type: 'HomeDelivery',
                    }) }}
                {% endif %}
                {% if option.deliveryMode == enum('Thelia\\Domain\\Checkout\\Enum\\DeliveryMode').LOCAL_PICKUP.value %}
                    {{ component('Flexy:Checkout:Delivery:StoreDelivery', {
                        title: option.title,
                        price: option.postage,
                        optionCode: option.code,
                        moduleId: option.moduleId,
                        icon: 'reinsurance-store',
                    }) }}
                {% endif %}
                {% if option.deliveryMode == enum('Thelia\\Domain\\Checkout\\Enum\\DeliveryMode').PICKUP.value %}
                    {{ component('Flexy:Checkout:Delivery:PickupDelivery', {
                        title: option.title,
                        description: 'Delivery within 24 to 48 hours in France'|trans,
                        optionCode: option.code,
                        moduleId: option.moduleId,
                        price: option.postage,
                        deliveryAddressId: this.deliveryAddressId,
                        invoiceAddressId: this.invoiceAddressId,
                        icon: 'reinsurance-pickup',
                    }) }}
                {% endif %}
            {% endfor %}
        {% else %}
            <div class="alert alert-warning">
                {{ include('@components/Organisms/SnackBar/SnackBar.html.twig', {
                    text: 'No delivery method is available for this address.'|trans,
                    variant: 'warning',
                    withIcon: true
                }) }}
            </div>
        {% endif %}
    </div>

</div>
