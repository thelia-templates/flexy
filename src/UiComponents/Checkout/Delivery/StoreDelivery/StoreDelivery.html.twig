{% extends '@UiComponents/Checkout/Delivery/DeliveryMode/DeliveryMode.html.twig' %}

{% block content %}
    {% if this.closed != null %}
        <span class="StoreDelivery-opening  {% if this.closed %}closed {% endif %}">
            {{ closed ? 'Close' : 'Open'|trans }}
            {{ 'currently'|trans }}
        </span>
    {% endif %}

    {% if this.address is defined %}
        <span class="StoreDelivery-address">
            {% set completeAddress = [
                this.address.address1,
                this.address.address2,
                this.address.address3 ?? null,
            ] %}
            <span class="block">{{ completeAddress|filter(i => i)|join(', ') }}</span>
            {% set city = [
                this.address.zipCode,
                this.address.city,
            ] %}
            <span class="block">{{ city|filter(i => i)|join(', ') }}</span>
        </span>
    {% endif %}
{% endblock %}

{% block footer %}
    {% if this.hours is not empty %}
        <div class="StoreDelivery-bottom" {{ stimulus_controller('store-delivery') }}>
            <div class="flex items-center gap-2">
                {{ ux_icon('clock',{class: 'w-4 h-4'}) }}
                {{ component('Flexy:Button', {
                    class: 'StoreDelivery-hours',
                    'data-show-hours': 'See opening hours'|trans,
                    'data-hide-hours': 'hide opening times'|trans,
                    'data-action': 'store-delivery#toggle',
                    text: 'See opening hours'|trans,
                    color: 'minimal',
                }) }}
            </div>
            <div class="StoreDelivery-hoursListing md:hidden" data-store-delivery-target="list">
                <table>
                    {% for hour in this.hours %}
                        <tr>
                            <td>
                                {{ hour.day }}
                            </td>
                            <td>
                                {{ hour.hours }}
                            </td>
                        </tr>
                    {% endfor %}
                </table>
            </div>
        </div>
    {% endif %}
{% endblock %}
