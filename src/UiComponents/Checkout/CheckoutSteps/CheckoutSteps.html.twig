{% set percent = (current|default(1) / steps|length * 100)|round %}
<div class="CheckoutSteps">
    <div class="flex items-center">
        <div class="CheckoutSteps-mobile">
            <div class="w-5 h-5 mr-0.5">
                {{ ux_icon('chevron-left') }}
            </div>
        </div>
        <div class="CheckoutSteps-steps">
            {% for step in steps %}
                <div class="Step {% if loop.index == current %}current{% elseif loop.index > current %}next{% else %}previous{% endif %}">
                    <span class="Step-number" style="--p: {{ percent }}%;">
                        <span>
                            {{ loop.index }}
                        </span>
                    </span>
                    <span class="Step-label">
                       {% if current != loop.length and (loop.index == current or loop.index < current) %}
                            {% if step.link %}
                                    <a href="{{step.link}}" class="no-underline">
                            {% endif %}
                        {% endif %}
                        {{ step.text|trans }}
                        {% if current != loop.length and (loop.index == current or loop.index < current) %}
                            {% if step.link %}
                                </a>
                            {% endif %}
                        {% endif %}
                    </span>
                </div>
            {% endfor %}
        </div>
    </div>
    {{ component('Flexy:Checkout:MiniSummary', {step : step ?? constant('FlexyBundle\\UiComponents\\Checkout\\CheckoutSteps\\CheckoutSteps::CART')}) }}
</div>
