<div class="my-8" {{ attributes }}>
    <div class="flex gap-2 justify-between mb-4">
        <p class="paragraph-1 font-bold  text-black items-center">{{ 'Billing address'|trans }}</p>
        {% if this.invoiceAddressId and not this.showAddressList and not this.editingAddressId %}
            <button
                type="button"
                class="Link Link--medium"
                data-action="live#emit"
                data-live-event-param="toggleShowAddressList">
                {{ 'Change invoice address'|trans }}
            </button>
        {% endif %}
    </div>

    {% if this.invoiceAddressId and this.editingAddressId %}
        <div class="flex flex-col gap-2 py-6 px-10 bg-theme-lightest">
            {% component ('Flexy:AddressesForm') with {addressId: this.editingAddressId} %}
                {% block footer %}
                    {{ component('Flexy:Button', {
                        type: 'button',
                        color: 'secondary',
                        text: 'Cancel'|trans,
                        'data-action': 'live#emitUp',
                        'data-live-event-param': 'cancelAddressForm',
                    }) }}

                    {{ component('Flexy:Button', {
                        type: 'submit',
                        text: 'Confirm'|trans,
                    }) }}
                {% endblock %}
            {% endcomponent %}
        </div>
    {% elseif this.invoiceAddressId and not this.showAddressList %}
        {{ component('Flexy:InvoiceCard', {
            addressId: this.invoiceAddressId
        }) }}
    {% else %}
        <ul class="flex flex-col gap-2 py-6 px-10 bg-theme-lightest">
            {% for address in this.addressList %}
                <li>
                    {{ component('Flexy:Checkout:AddressCardCheckout', {
                        addressId: address.id,
                        type: "invoice",
                    })
                    }}
                </li>
            {% endfor %}
            {% if this.showAddressList %}
                <div class="flex justify-end">
                    {{ component('Flexy:Button', {
                        type: 'button',
                        color: 'secondary',
                        text: 'Cancel'|trans,
                        'data-action': 'live#emit',
                        'data-live-event-param': 'cancelAddressForm',
                    }) }}
                </div>
            {% endif %}
        </ul>
    {% endif %}
</div>
