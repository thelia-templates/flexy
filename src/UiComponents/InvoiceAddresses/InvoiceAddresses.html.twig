<div class="my-5" {{ attributes }}>
    {% set invoiceAddress = addresses|find(a => a.id == invoiceAddressId) %}

    <h2 class="mb-4 font-bold text-black paragraph-1">
        {{ 'Billing address'|trans }}
    </h2>
    <div class="HomeDelivery p-[30px]">
        <div class="flex flex-col">
            {% if switchView %}
                {% set addressId = create ? null : update %}
                {% set key = create ? 'create' : 'update_' ~ update %}
                <div class={{ (update or create) ? '' : 'hidden' }}>
                    {{ component('Flexy:AddressesForm', {addressId: addressId, key: key}) }}
                </div>
                <div class={{ (update or create) ? 'hidden' : '' }}>
                    {% if addresses|length <= 0 %}
                        <div class="flex flex-col items-start">
                            <span class="HomeDelivery-noAddress">
                                {{ 'You have no registered address'|trans }}
                                :
                            </span>

                            {{ component('Flexy:Button', {
                                text: 'Add an address'|trans,
                                classes: 'mt-4',
                            }) }}
                        </div>
                    {% else %}
                        <div>
                            <ul class="flex flex-col gap-2">
                                {% for address in addresses %}
                                    <li>
                                        {{ component('Flexy:Checkout:AddressCardCheckout', {addressId: address.id, type: 'invoice'}) }}
                                    </li>
                                {% endfor %}
                            </ul>

                            <div class="flex flex-col gap-2 mt-4 lg:flex-row lg:items-center">
                                {{ component('Flexy:Button', {
                                    text: 'Choose this address'|trans,
                                    fill: true,
                                    disabled: not invoiceAddressId,
                                    classes: 'lg:w-1/2',
                                    liveAction: 'switchAddress'
                                }) }}
                                {{ component('Flexy:Button', {
                                    text: 'Use another address'|trans,
                                    fill: true,
                                    color: 'secondary',
                                    classes: 'lg:w-1/2',
                                    liveAction: 'newAddress'
                                }) }}
                            </div>
                        </div>
                    {% endif %}
                </div>
            {% else %}
                <span class="HomeDelivery-title">
                    {{ invoiceAddress.label }}
                </span>
                <span class="block mb-[20px]">
                    {{ [invoiceAddress.firstname ~ ' ' ~ invoiceAddress.lastname, invoiceAddress.address1, invoiceAddress.address2, invoiceAddress.address3, invoiceAddress.zipcode ~ ' ' ~ invoiceAddress.city, invoiceAddress.phone]|filter(f =>f)|join(', ') }}
                </span>
                {{ component('Flexy:Button', {
                    text: 'Edit the address'|trans,
                    color: 'secondary',
                    size: 'large',
                    liveAction: 'switchAddress',
                    classes: 'self-end'
                }) }}
            {% endif %}

        </div>
    </div>
</div>
