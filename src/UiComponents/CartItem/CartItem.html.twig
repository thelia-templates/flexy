{% props index = null, disabled = false %}
<div class="{{ this.outOfStock ? 'bg-theme-lightest p-4 border-error border' : '' }}" {{ attributes.defaults(stimulus_controller('quantity', { min: 0, max: this.cartItem.stock })) }} data-loading="addClass(opacity-50 pointer-events-none)">
    {% if this.outOfStock %}
        <div class="flex paragraph-4 mb-[10px]">
            <span class="w-5 h-5 mr-1">
                {{ ux_icon('error') }}
            </span>
            <span>
                [{{ this.title }}]
                {{ 'is no longer available and cannot be ordered.'|trans }}
            </span>
        </div>
    {% endif %}
    <div class="CartItem {{ classes }} {{ this.outOfStock ? 'CartItem--outOfStock' : '' }}">
        <div class="CartItem-mainContent">
            <a class="CartItem-imgLink" href="{{ this.url }}">
                {{ getImages({
                    source_type: 'product',
                    img_id: this.pseImageId,
                    filters: 'add_to_cart',
                    limit: 1,
                    wrapper: 'figure',
                    wrapper_attrs: {
                        class: 'CartItem-img',
                    },
                    img_attrs: {
                        class: 'mx-auto',
                        loading: 'lazy',
                        widht: '105',
                        height: '112',
                    },
                    placeholder: asset('dist/images/placeholder.webp'),
                })|raw }}
            </a>
            <div class="CartItem-desc">
                <a href="{{ this.url }}" class="ProductCard-title">
                    {{ this.title }}
                </a>
                <div class="CartItem-orderInfos paragraph-6">

                    {% if this.desc %}
                        <span>
                            {{ this.desc}}
                        </span>
                    {% endif %}
                    {% set attrs = [] %}
                    {% for attribute, value in attributesAv %}
                        {% set attrs = attrs|merge([attribute~' : '~value]) %}
                    {% endfor %}
                    <span class="CartItem-secondarySize">
                            {{ attrs|join(', ') }}
                        </span>
                    {% if cartItem.quantity %}
                        <span>
                            {{ 'Quantity:'|trans }}
                            {{ cartItem.quantity }}
                        </span>
                    {% endif %}
                </div>

                <div class="CartItem-footer">
                    {% if this.pse.promo %}
                        <div class="CartItem-footerRight">
                            <div class="CartItem-price">
                                {{ this.prices.promoTaxedPrice|format_currency('EUR', locale: lang_code) }}
                            </div>
                            <div class="CartItem-originalPrice">
                                {{ this.prices.taxedPrice|format_currency('EUR', locale: lang_code) }}
                            </div>
                        </div>
                    {% else %}
                        <div class="CartItem-price">
                            {{ this.prices.taxedPrice|format_currency('EUR', locale: lang_code) }}
                        </div>
                    {% endif %}

                    {% if this.outOfStock %}
                        <div class="CartItem-unavailable">
                            {{ 'Unavailable'|trans }}
                        </div>
                    {% else %}
                        <div class="CartItem-quantity">
                            <label for="{{ id }}" class="Button Button--secondary Button-quantity Button--small {% if disabled %}disabled{% endif %}">
                                <button type="button" data-action="live#action" data-live-action-param="minus" data-live-index-param="{{index}}" {% if this.cartItem.quantity <= 0 %}class="invisible"{% endif %}>-</button>
                                <input data-model="on(change)|min_value(0)|max_value({{this.cartItem.stock}})|items[{{index}}].quantity" data-base-quantity="{{this.cartItem.quantity}}" min="0" max="{{this.cartItem.stock}}" type="text" data-live-index-param="{{index}}">
                                <button type="button" data-action="live#action" data-live-action-param="plus" data-live-index-param="{{index}}" {% if this.cartItem.quantity >= this.cartItem.stock %}class="invisible"{% endif %}>+</button>
                            </label>
                        </div>
                    {% endif %}

                </div>
            </div>
        </div>

        <div class="bottom-card-buttons">
            <a href='{{ this.url }}' class="hover:bg-theme-lighter" {% if disabled %} disabled {% endif %} type="button">
                <span>
                    {{ ux_icon('show') }}
                </span>
                {{ 'View product'|trans }}
            </a>
            <button type="button" class="hover:bg-theme-lighter" {% if disabled %} disabled {% endif %} {{ live_action('remove', {index}) }}>
                <span>
                    {{ ux_icon('delete') }}
                </span>
                {{ 'Delete'|trans }}
            </button>
        </div>

    </div>
    {% if this.outOfStock %}
        <div class="flex md:justify-end">
            {{ component('Flexy:Button', {
                text: 'View similar products'|trans,
                href: "#O",
                size: "medium",
                class: 'mt-4'
            }) }}
        </div>
    {% endif %}
</div>
