<div {{ attributes }}>
    {{ form_start(form, {attr: {
        class: "flex flex-col gap-6",
        action: this.action,
        method: 'POST'
    }}) }}
    {{ form_errors(form) }}
    {{ form_row(form.success_url, {value: path('account_addresses', {(successParam) : true})}) }}

    <div class="flex flex-col gap-6 order-1">
        {{ form_row(form.country)}}
        {% if form.state is defined %}
            {{ form_row(form.state) }}
        {% endif %}
        {{ form_row(form.phone)}}
        {{ form_row(form.cellphone)}}
        {{ form_row(form.is_default)}}
        <div>
            {{ component('Flexy:Button', {
                text: 'Confirm'|trans,
                type: 'submit'
            }) }}
        </div>
    </div>
    <div class="flex flex-col gap-6 order-0">
        {{ form_rest(form) }}
    </div>
    {{ form_end(form) }}
</div>
