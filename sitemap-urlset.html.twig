<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{% for url in urls %}
    <url>
        <loc>{{ url.loc }}</loc>
        {%- if url.lastmod %}
        <lastmod>{{ url.lastmod|date('c') }}</lastmod>
        {%- endif %}
        {%- if url.changefreq %}
        <changefreq>{{ url.changefreq }}</changefreq>
        {%- endif %}
        {%- if url.priority is not null %}
        <priority>{{ url.priority }}</priority>
        {%- endif %}
    </url>
{% endfor %}
{# The addresses modules add to this section, the language left to them. #}
{{ theme_hook('sitemap.urls', {context: section|default(''), lang: ''}) }}
</urlset>
