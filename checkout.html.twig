{% extends 'base.html.twig' %}

{% block title %}
	{{'Checkout'|trans}}
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	{{ encore_entry_script_tags('checkout') }}
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	{{ encore_entry_link_tags('checkout') }}
{% endblock %}

{% block header %}
	{% include '@components/Layout/Header/HeaderCheckout.html.twig' %}
{% endblock %}

{% block body %}

	{% include '@components/Layout/CheckoutSteps/CheckoutSteps.html.twig' with {steps: ["Your cart", "Delivery", "Payment", "Confirmation"], current: current} %}
	{{ component('Flexy:Layout:Checkout', {page: page, step: current}) }}

{% endblock %}
{% block footer %}
	{% include '@components/Layout/Footer/FooterCheckout.html.twig' %}
{% endblock %}
