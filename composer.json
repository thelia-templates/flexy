{
    "name": "thelia/flexy",
    "type": "thelia-frontoffice-template",
    "description": "thelia design system",
    "keywords": [
        "thelia-frontoffice-template",
        "thelia-flexy"
    ],
    "license": "GPL-3.0-or-later",
    "homepage": "https://thelia.net",
