{% extends 'base.html.twig' %}

{% block title %}{{ 'My profile'|trans }}{% endblock %}

{% block body %}
    {# Read as a resource only to feed the account hook points with the same object shape as the
       rest of the theme's extension contract; the page's own fields come from its components.
       attr('customer', …) reads the security context, so it resolves on this controller route. #}
    {% set customer = resources('/api/front/account/customers/' ~ attr('customer', 'id')) %}

    {{ theme_hook('account.top', {customer: customer}) }}

    <twig:Layouts:Subheader:Account
        title="{{ 'My profile'|trans }}"
        selected="profile"
        :breadcrumb="[{title: 'My profile'|trans}]"
    />

    <div class="container-l pt-10 pb-15 lg:pb-30">
        <div class="max-w-4xl mx-auto grid lg:grid-cols-2 gap-8 lg:gap-14">
            {% set notices = {
                profile: 'Your information has been successfully modified'|trans,
                password: 'Your password has been changed successfully'|trans,
            } %}
            {% set notice = notices[app.request.query.get('success')]|default(null) %}

            {% if notice %}
                <twig:Molecules:SnackBar:Base
                    variant="success"
                    :withIcon="true"
                    text="{{ notice }}"
                    class="col-span-full"
                />
            {% endif %}

            <div class="flex flex-col gap-6">
                <h2 class="h4 text-black">{{ 'My contact information'|trans }}</h2>
                <twig:Forms:Customer:Update />
            </div>

            <div class="flex flex-col gap-6">
                <h2 class="h4 text-black">{{ 'Change my password'|trans }}</h2>

                {% set form = getForm('thelia_customer_password_update') %}
                {% form_theme form with flexy_form_themes only %}

                {{ form_start(form, {
                    action: path('account_password'),
                    method: 'POST',
                    attr: {class: 'flex flex-col gap-6 px-10 pt-8 pb-6 rounded-lg bg-lighter'},
                }) }}
                {{ form_row(form.success_url, {value: path('account_index', {success: 'password'})}) }}
                {{ form_row(form.error_url, {value: path('account_index')}) }}
                {{ form_rest(form) }}

                <twig:Molecules:Button:Base text="{{ 'Update my password'|trans }}" type="submit" class="w-max" />
                {{ form_end(form) }}
            </div>

            <div class="flex flex-col gap-6">
                <h2 class="h4 text-black">{{ 'My personal data'|trans }}</h2>

                {% if app.request.query.get('error') %}
                    <twig:Molecules:SnackBar:Base
                        variant="error"
                        :withIcon="true"
                        text="{{ 'Your data could not be prepared. Please try again.'|trans }}"
                    />
                {% endif %}

                <form method="post" action="{{ path('account_personal_data') }}"
                      class="flex flex-col gap-4 px-10 pt-8 pb-6 rounded-lg bg-lighter">
                    <input type="hidden" name="_token" value="{{ csrf_token('personal_data') }}">
                    <p>
                        {{ 'Download a copy of everything we hold about you. The archive contains your account, your addresses, your orders, your carts and your newsletter subscription. It is sent to you as the answer to this request and is never stored on the shop.'|trans }}
                    </p>
                    <twig:Molecules:Button:Base
                        text="{{ 'Download my data'|trans }}"
                        type="submit"
                        class="mt-1.5 w-max"
                    />
                </form>
            </div>
        </div>
    </div>

    {{ theme_hook('account.bottom', {customer: customer}) }}
{% endblock %}

{% block footer %}
    <twig:Layouts:Footer:Checkout />
{% endblock %}
