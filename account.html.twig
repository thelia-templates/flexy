{% extends 'base.html.twig' %}

{% block title %}
    {{ 'Account'|trans }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}

{% block body %}
    {% set customerId = attr('customer', 'id') %}
    {% set customer = resources('/api/front/account/customers/' ~ customerId) %}

    {{ theme_hook('account.top', {customer: customer}) }}

    {{ component('Flexy:AccountHero', {
        title: 'My profile'|trans,
        selected: "profile",
        breadcrumb: [
            {
                title: 'My account'|trans,
                url: path('account_index')
            },
            {
                title: 'My profile'|trans
            }]
    }) }}

    <div class="container mt-10">
        <div class="max-w-4xl mx-auto grid lg:grid-cols-2 gap-8 lg:gap-14 pb-[60px] lg:pb-[120px]">
            {% if app.request.get('success') == 1 %}
                {{ include('@components/Organisms/SnackBar/SnackBar.html.twig', {
                    text: 'Your information has been successfully modified'|trans,
                    variant: 'validated',
                    withIcon: true,
                    class: 'col-span-full'
                }) }}
            {% endif %}
            <div class="flex flex-col gap-6">
                <div class="text-black h4">
                    {{ 'My contact information'|trans }}
                </div>
                {{ component('Flexy:AccountCustomerUpdate', {
                    customer
                }) }}
            </div>
            <div class="flex flex-col gap-6" {{ attributes }}>
                <div class="text-black h4">
                    {{ 'Change my password'|trans }}
                </div>

                {% set form = getForm('thelia_customer_password_update') %}

                {{ form_start(form, {
                    attr: {
                        class: 'flex flex-col gap-6 px-10 pt-8 pb-6 rounded-lg bg-theme-lighter',
                        action: path('account_password'),
                    },
                }) }}

                {{ form_row(form.success_url, {value: path('account_index', {success: 1})}) }}
                {{ form_row(form.error_url, {value: path('account_index')}) }}
                {{ form_rest(form) }}
                {{ component('Flexy:Button', {
                    text: 'Update my password'|trans,
                    type: 'submit',
                    size: 'medium',
                    class: 'mt-1.5',
                }) }}
                {{ form_end(form) }}
            </div>
            <div class="flex flex-col gap-6">
                <div class="text-black h4">
                    {{ 'My personal data'|trans }}
                </div>
                {% if app.request.query.get('error') == 1 %}
                    {{ include('@components/Organisms/SnackBar/SnackBar.html.twig', {
                        text: 'Your data could not be prepared. Please try again.'|trans,
                        variant: 'error',
                        withIcon: true,
                    }) }}
                {% endif %}
                <form method="post" action="{{ path('account_personal_data') }}"
                      class="flex flex-col gap-4 px-10 pt-8 pb-6 rounded-lg bg-theme-lighter">
                    <input type="hidden" name="_token" value="{{ csrf_token('personal_data') }}">
                    <p>
                        {{ 'Download a copy of everything we hold about you. The archive contains your account, your addresses, your orders, your carts and your newsletter subscription. It is sent to you as the answer to this request and is never stored on the shop.'|trans }}
                    </p>
                    {{ component('Flexy:Button', {
                        text: 'Download my data'|trans,
                        type: 'submit',
                        size: 'medium',
                        class: 'mt-1.5 self-start',
                    }) }}
                </form>
            </div>
        </div>
    </div>

    {{ theme_hook('account.bottom', {customer: customer}) }}
{% endblock %}

{% block footer %}
    {{ include('@components/Layout/Footer/FooterCheckout.html.twig') }}
{% endblock %}

