{% extends 'checkout-base.html.twig' %}

{% block title %}{{ 'Your order'|trans }}{% endblock %}

{% block checkoutContent %}
    {{ theme_hook('order-placed.top') }}
    <div class="flex flex-col items-center justify-center text-center text-black">
        {{ ux_icon('cart-illustration', {class: 'w-40 h-auto block mx-auto mb-6'}) }}
        <h3 class="mt-4 h3">{{ 'Thanks for your order !'|trans }}</h3>
        <p class="paragraph-3 mt-4 mb-8">
            {# Paid only when the payment module says so: a cheque, a bank transfer or a
               payment the gateway confirms later leave the order waiting for its money. #}
            {% if placed_order|default(null) and placed_order.isPaid() %}
                <span class="block">{{ 'Your payment has been confirmed'|trans }}</span>
            {% else %}
                <span class="block">{{ 'Your order has been placed'|trans }}</span>
                <span class="block">{{ 'It is waiting for its payment.'|trans }}</span>
            {% endif %}
            <span>{{ "We'll do everything we can to send your order as quickly as possible!"|trans }}</span>
        </p>
        {# What the payment module has left to say about the order: where to send a cheque,
           which bank account to transfer to. Each module answers for its own orders. #}
        {% if placed_order|default(null) %}
            {{ theme_hook('order-placed.additional-payment-info', {order: placed_order}) }}
        {% endif %}
        {# What was bought and where it goes, read off the order itself: the buyer leaves this
           page with the reference to quote and the amount they owe, whatever the payment. #}
        {% if placed_order_view|default(null) %}
            {% set recap = placed_order_view %}
            <section class="w-full max-w-3xl mb-8 text-start" data-testid="order-recap">
                <h2 class="h4 mb-2">{{ 'Order N°'|trans }} <span dir="ltr" data-testid="order-recap-ref">{{ recap.ref }}</span></h2>
                <p class="paragraph-3 mb-6">
                    <bdi>{{ recap.createdAt|format_date() }}</bdi>
                    &middot;
                    {% set recapTotal = order_total(recap) %}
                    {{ 'Total'|trans }}
                    <strong><span dir="ltr" data-testid="order-recap-total">{{ recapTotal.amount|format_currency(recap.currencyCode, locale: lang_code) }}</span><twig:Atoms:TaxMention:Base :display="recapTotal.display" /></strong>
                </p>

                <div class="flex flex-col gap-2">
                    <twig:Layouts:OrderProducts:Base
                        :orderProducts="recap.orderProducts"
                        :order="recap"
                        currencyCode="{{ recap.currencyCode }}"
                    />
                    <twig:Organisms:Summary:Order :order="recap" currencyCode="{{ recap.currencyCode }}" />
                </div>

                <h3 class="h4 mt-8 mb-4">{{ 'Delivery & payment'|trans }}</h3>
                {% if recap.deliveryModuleTitle or recap.paymentModuleTitle %}
                    <ul class="paragraph-3 mb-4">
                        {% if recap.deliveryModuleTitle %}
                            <li data-testid="order-recap-delivery">{{ 'Delivery'|trans }}: <strong>{{ recap.deliveryModuleTitle }}</strong></li>
                        {% endif %}
                        {% if recap.paymentModuleTitle %}
                            <li data-testid="order-recap-payment">{{ 'Payment'|trans }}: <strong>{{ recap.paymentModuleTitle }}</strong></li>
                        {% endif %}
                    </ul>
                {% endif %}
                <div class="flex flex-col gap-2">
                    <twig:Organisms:AddressCard:Base
                        :addressId="recap.deliveryOrderAddress.id"
                        title="{{ 'Delivery address'|trans }}"
                        :inOrder="true"
                    />
                    <twig:Organisms:AddressCard:Base
                        :addressId="recap.invoiceOrderAddress.id"
                        title="{{ 'Billing address'|trans }}"
                        :inOrder="true"
                    />
                </div>

                {# A guest has the tracking link below; an account holder finds the order in theirs. #}
                {% if not guest_order_token|default(null) %}
                    <twig:Molecules:Button:Base
                        text="{{ 'See my order'|trans }}"
                        href="{{ path('account_order', {orderId: recap.id}) }}"
                        color="secondary"
                        class="mt-6"
                    />
                {% endif %}
            </section>
        {% endif %}
        {# An order placed without an account: the only way back to it is the link, which
           the buyer also receives by email. Offered here while it is still on screen. #}
        {% if guest_order_token|default(null) %}
            <div class="flex flex-col items-center gap-4 mb-8">
                <p class="paragraph-3">
                    {{ 'A link to follow your order has been sent to your email address.'|trans }}
                </p>
                <div class="flex flex-col sm:flex-row gap-4">
                    <twig:Molecules:Button:Base
                        text="{{ 'Follow my order'|trans }}"
                        href="{{ path('guest_order_track', {token: guest_order_token}) }}"
                        color="secondary"
                    />
                    <twig:Molecules:Button:Base
                        text="{{ 'Create my account'|trans }}"
                        href="{{ path('guest_order_account', {token: guest_order_token}) }}"
                        color="secondary"
                    />
                </div>
            </div>
        {% endif %}

        <twig:Molecules:Button:Base
            text="{{ 'Back to the store'|trans }}"
            size="large"
            href="{{ path('index') }}"
        />
    </div>
    {{ theme_hook('order-placed.bottom') }}
{% endblock %}
