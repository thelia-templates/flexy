{% extends 'base.html.twig' %}
{% set productId = attr('product', 'id') %}

{% set images = getImagesData({
	source_id: productId,
	source_type: 'product',
	filters: 'default',
	limit: 1,
}) %}

{% block og_image %}{{ ((images|first)?.sources|first)?.url ?: parent()  }}{% endblock %}
{% block og_type %}product{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('product-css') }}
{% endblock %}


{% set product = resources('/api/front/products/' ~ productId) %}
{% set productCategory = product.productCategories|filter(c => c.defaultCategory)|first.category %}
{% set currentPse = resources('/api/front/products/' ~ productId)|first %}

{% if app.request.get('ref') %}
    {% set currentPse = resources('/api/front/product_sale_elements', {ref: app.request.get('ref')})|first %}
{% endif %}

{% block body %}
    {{ theme_hook('product.top', {product: product}) }}
    <div class="ProductPage">
        <div class="p-5 lg:justify-between lg:items-center lg:flex">
            {{ component('Molecules:Breadcrumb:Breadcrumb', {breadcrumb: breadcrumb}) }}
        </div>
        <div class="container">
            <div class="ProductPage-grid">
                {{ component('Flexy:Pages:Product', {product: product}) }}
                {{ theme_hook('product.details.bottom', {product: product}) }}

                <section id="description" class="ProductPage-description">

                    {% if product.i18ns.description %}
                        {% set descriptionContent %}
                        <div>{{ product.i18ns.description|raw }}</div>
                        {% endset %}

                        {{ include('@components/Molecules/Accordion/Accordion.html.twig', {
            title: 'Description'|trans,
            content: descriptionContent,
            iconPlus: 'plus',
            iconMinus: 'minus',
            open: true,
          }) }}
                    {% endif %}

                    {% set featuresContent %}
                    {% for featuresProduct in product.featureProducts %}
                        <dl class="flex gap-2">
                            <dt>{{ featuresProduct.feature.i18ns.title }}
                                :
                            </dt>
                            <dd>{{ featuresProduct.featureAv.i18ns.title }}</dd>
                        </dl>
                    {% endfor %}
                    {% endset %}
                    {{ include('@components/Molecules/Accordion/Accordion.html.twig', {
              title: 'Features'|trans,
              content: featuresContent,
              iconPlus: 'plus',
              iconMinus: 'minus',
            }) }}
                </section>
            </div>
        </div>
        <div class="container mx-auto">
            {{ component('Flexy:Blocks', {item_type: 'product', item_id: product.id}) }}
        </div>
        <div class="bg-theme-lighter mt-[50px]">
            {{ component('Flexy:CrossSelling', {categoryId: productCategory.id, title: 'Last seen products'|trans}) }}
        </div>
        {{ include('@components/Layout/Reinsurance/Reinsurance.html.twig', {data: [
      {
        strongText: 'Free delivery'|trans,
        text: 'For any order over €100'|trans,
        linkLabel: 'See conditions'|trans,
        link: '#',
        icon: 'reinsurance-delivery',
      },
      {
        strongText: 'Secure payment'|trans,
        text: 'Credit card, Paypal'|trans,
        linkLabel: 'See conditions'|trans,
        link: '#',
        icon: 'reinsurance-payment',
      },
      {
        strongText: 'Satisfied or refunded'|trans,
        text: 'Exchange or refund offered within 30 days'|trans,
        linkLabel: 'See conditions'|trans,
        link: '#',
        icon: 'reinsurance-satisfied',
      },
    ]}) }}
    </div>
    {{ component('Flexy:AddToCartToast') }}

    {{ theme_hook('product.bottom', {product: product}) }}
{% endblock %}
