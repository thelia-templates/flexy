{% extends 'base.html.twig' %}
{% set page = app.request.get('page')|default(1) %}
{% set categoryId = attr('category', 'id') %}

{% set firstImage = getImagesData({
	source_id: categoryId,
	source_type: 'category',
	filters: 'default',
	limit: 1,
}) %}

{% block og_image %}{{ ((firstImage|first)?.sources|first)?.url ?: parent()  }}{% endblock %}

{% set category = resources('/api/front/categories/'~categoryId) %}

{% set childCategories = resources('/api/front/categories', {
  'parent': categoryId,
  'order[position]': 'asc',
  'visible' : true
}) %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('category-css') }}
{% endblock %}

{% block stimulus_controller %}
    {{ stimulus_controller('drawer') }}
{% endblock %}

{% block body %}
  {{ theme_hook('category.top', {category: category}) }}
  {{ component('Flexy:CatHero', {
    title: SEOnePageH1(),
    chapo: category.i18ns.chapo|default(null),
    breadcrumb,
    next: category.i18ns.postscriptum|default(null) or category.i18ns.description|default(null),
    displayProducts : not childCategories|length
  }) }}

  {% if childCategories|length %}
    <div class="container mt-[50px] lg:mt-[100px]">
      <ul class="grid xs:grid-cols-2 gap-4  md:grid-cols-3 lg:grid-cols-4 lg:gap-8">
        {% for category in childCategories %}
          <li>
            {% include '@components/Organisms/CategoryCard/CategoryCard.html.twig' with category|merge({classes: "h-full"}) %}
          </li>
        {% endfor %}
      </ul>
      <div id="description" class="lg:pt-[56px] lg:pb-[96px]  pt-[102px] pb-[52px]">
        {% if category.i18ns.postscriptum or category.i18ns.description %}
          <div class="wysiwyg">
            {% if category.i18ns.description %}
              <div>
                {{ category.i18ns.description|raw }}
              </div>
            {% endif %}
            {{ component('Flexy:Blocks', {item_type: 'category', item_id: categoryId}) }}
            {% if category.i18ns.postscriptum %}
              <div class="mt-8">
                {{ category.i18ns.postscriptum|raw }}
              </div>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
    {% else %}
      {{ component('Flexy:CategoryFilters', {
        initialCategoryId: categoryId,
        initialPage: page,
        initSearchQuery: null,
        sourceData : {
          title: category.i18ns.title|default(null),
          chapo: category.i18ns.chapo|default(null),
          description: category.i18ns.description|default(null),
          breadcrumb
        }}) }}
  {% endif %}
  {{ theme_hook('category.bottom', {category: category}) }}
{% endblock %}
