{% extends 'base.html.twig' %}

{% block title %}{{ 'Sign up'|trans }}{% endblock %}

{% block body %}
    {% set form = getForm('flexybundle_form_customer_register_form') %}
    {% form_theme form with flexy_form_themes only %}

    <twig:Molecules:CheckoutSteps:Base
        :steps="[{text: 'Your login', link: path('customer_register')}, {text: 'Your informations', link: path('customer_informations')}]"
        current="1"
        noCart
    />

    <div class="container-s pt-8 pb-14 lg:pt-12 lg:pb-30">
        {% for error in form.vars.errors %}
            <twig:Molecules:SnackBar:Base variant="error" text="{{ error.message }}" />
        {% endfor %}

        <h2 class="h2 text-black mb-4">{{ 'Create account'|trans }}</h2>
        <p class="paragraph-2 text-black mb-8">
            {{ 'With your account, you can track your orders, manage your profile, receive the newsletter, manage your wish lists...'|trans }}
        </p>

        {{ form_start(form, {attr: {
            action: path('customer_register_create'),
            method: 'POST',
            class: 'flex flex-col gap-6 mb-3',
        }}) }}
        {{ form_row(form.success_url, {value: path('customer_informations')}) }}
        {{ form_row(form.error_url, {value: path('customer_register')}) }}
        {{ form_row(form.firstname) }}
        {{ form_row(form.lastname) }}
        {{ form_row(form.email) }}
        {{ form_row(form.password) }}

        <div class="flex flex-col items-start gap-9">
            <twig:Molecules:Button:Base text="{{ 'Next step'|trans }}" type="submit" size="large" icon_right="chevron-right" />

            <div class="flex flex-col gap-2">
                <p class="paragraph-2 text-black">{{ 'You already have an account ?'|trans }}</p>
                <twig:Molecules:Link:Base href="{{ path('customer_login') }}" customText="{{ 'Log in'|trans }}" />
            </div>
        </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
