{% extends 'checkout-base.html.twig' %}

{% block title %}{{ 'Payment'|trans }}{% endblock %}

{% block checkoutContent %}
    <twig:Organisms:Payment:Base />

    {# A wallet is one of the payment methods, and once chosen its button takes the place of
       the order button. Rendered here, with the page, so that the scripts the modules put
       next to their buttons run; the dock controller carries the chosen one into the order
       button's place. #}
    <div {{ stimulus_controller('express-payment-dock') }} hidden>
        <div {{ stimulus_target('express-payment-dock', 'content') }}>
            {{ theme_hook('checkout.express-payment') }}
        </div>
    </div>
{% endblock %}

{# The step before this one is whichever the configuration puts there — the delivery on
   a shop that asks for one, the cart on a shop that does not. #}
{% block checkoutBackButton %}
    {%- if previous_step_url|default(null) -%}
        <twig:Molecules:Link:Base
            iconLeft="chevron-left"
            customText="{{ 'Previous Step'|trans }}"
            href="{{ previous_step_url }}"
            class="gap-2 mt-6 inline-flex"
        />
    {%- endif -%}
{% endblock %}

{% block checkoutSummary %}
    <twig:Organisms:Summary:Checkout />
{% endblock %}

{% block checkoutNextButton %}
    <twig:Organisms:NextButton:Base
        :step="current"
        href="{{ next_step_url }}"
    />
{% endblock %}
