{% form_theme form with flexy_form_themes only %}
<div {{ attributes }}>
    {{ form_start(form, {
        attr: {
            'data-action': 'live#action:prevent',
            'data-live-action-param': 'save',
        },
    }) }}

    <div class="flex flex-col gap-3 font-normal">
        {{ form_row(form.label) }}
        <div class="paragraph-6">
            {{ 'This name will allow you to easily identify each of your addresses'|trans }}
        </div>
        <hr/>
        {{ form_row(form.title) }}
        <div class="grid sm:grid-cols-2 gap-5">
            {{ form_row(form.firstname) }}
            {{ form_row(form.lastname) }}
        </div>
        {# Billing address only, and the identifiers only once a company name is typed:
           the form itself decides, this template just renders what is there. #}
        {% if form.company is defined %}
            {{ form_row(form.company) }}
        {% endif %}
        {% if form.siret is defined %}
            {{ form_row(form.siret) }}
        {% endif %}
        {% if form.vat_number is defined %}
            {{ form_row(form.vat_number) }}
        {% endif %}
        {{ form_row(form.country) }}
        {% if form.state is defined %}
            {{ form_row(form.state) }}
        {% endif %}
        {{ form_row(form.address1) }}
        {{ form_row(form.address2) }}
        <div class="grid sm:grid-cols-2 gap-5">
            {{ form_row(form.zipcode) }}
            {{ form_row(form.city) }}
        </div>
        <div class="grid sm:grid-cols-2 gap-5">
            {{ form_row(form.phone) }}
            {{ form_row(form.cellphone) }}
        </div>
        <div class="paragraph-5">
            {{ 'In case we need to contact you about your order'|trans }}
        </div>
        {{ form_rest(form) }}

        <div class="flex justify-between mt-4">
            {% block footer %}
                <twig:Molecules:Button:Base
                    size="large"
                    color="secondary"
                    type="button"
                    text="{{ 'Cancel'|trans }}"
                    data-action="live#emitUp"
                    data-live-event-param="cancelAddressForm"
                />
                <twig:Molecules:Button:Base
                    size="large"
                    type="submit"
                    text="{{ 'Confirm'|trans }}"
                />
            {% endblock %}
        </div>
    </div>

    {{ form_errors(form) }}
    {{ form_end(form) }}
</div>
