{% form_theme form with flexy_form_themes only %}
<div {{ attributes }}>
    {% do override_labels(form, {
        firstname: 'Firstname'|trans,
        lastname: 'Lastname'|trans,
        company: 'Company'|trans,
        address1: 'Address'|trans,
        phone: 'Phone number'|trans,
        invoice_firstname: 'Firstname'|trans,
        invoice_lastname: 'Lastname'|trans,
        invoice_company: 'Company'|trans,
        invoice_address1: 'Address'|trans,
        invoice_phone: 'Phone number'|trans,
    }) %}
    {{ form_start(form, {attr: {class: 'flex flex-col gap-6'}}) }}

    <h3 class="h5 text-black">{{ 'Your details'|trans }}</h3>

    {{ form_row(form.title) }}

    <div class="flex flex-col md:flex-row gap-6">
        {{ form_row(form.firstname) }}
        {{ form_row(form.lastname) }}
    </div>

    {{ form_row(form.email, {help: 'Your order confirmation and the link to follow your order are sent to this address'|trans}) }}

    <h3 class="h5 text-black mt-4">{{ 'Delivery address'|trans }}</h3>

    {{ form_row(form.company) }}
    {{ form_row(form.address1) }}
    {{ form_row(form.address2) }}

    <div class="flex flex-col md:flex-row gap-6">
        {{ form_row(form.zipcode) }}
        {{ form_row(form.city) }}
    </div>

    <div class="flex flex-col md:flex-row gap-6">
        {{ form_row(form.country) }}
        {% if form.state is defined %}
            {{ form_row(form.state) }}
        {% endif %}
    </div>

    <div class="flex flex-col md:flex-row gap-6">
        {{ form_row(form.phone) }}
        {{ form_row(form.cellphone) }}
    </div>

    {{ form_row(form.invoice_same) }}

    {# The billing fields only exist on the form once the buyer said the two addresses
       differ, so the whole block is keyed on one of them being there. #}
    {% if form.invoice_address1 is defined %}
        <h3 class="h5 text-black mt-4">{{ 'Billing address'|trans }}</h3>

        {{ form_row(form.invoice_title) }}

        <div class="flex flex-col md:flex-row gap-6">
            {{ form_row(form.invoice_firstname) }}
            {{ form_row(form.invoice_lastname) }}
        </div>

        {{ form_row(form.invoice_company) }}
        {% if form.invoice_siret is defined %}
            {{ form_row(form.invoice_siret) }}
        {% endif %}
        {% if form.invoice_vat_number is defined %}
            {{ form_row(form.invoice_vat_number) }}
        {% endif %}

        {{ form_row(form.invoice_address1) }}
        {{ form_row(form.invoice_address2) }}

        <div class="flex flex-col md:flex-row gap-6">
            {{ form_row(form.invoice_zipcode) }}
            {{ form_row(form.invoice_city) }}
        </div>

        <div class="flex flex-col md:flex-row gap-6">
            {{ form_row(form.invoice_country) }}
            {% if form.invoice_state is defined %}
                {{ form_row(form.invoice_state) }}
            {% endif %}
        </div>

        {{ form_row(form.invoice_phone) }}
    {% endif %}

    <div>
        {{ form_row(form.accept_privacy_policy) }}

        {# The document the buyer is agreeing to, named as the shop named it: a consent
           nobody can read is one the merchant cannot show was given. Which content that
           is comes from the shop setting, so the link disappears on a shop that has not
           set one rather than pointing at nothing. #}
        {% set legalContents = attr('config', 'terms_conditions_content_id')
            ? resources('/api/front/contents', {id: attr('config', 'terms_conditions_content_id'), visible: true})
            : [] %}
        {% for legalContent in legalContents %}
            <p class="paragraph-5 mt-2">
                <a href="{{ legalContent.publicUrl }}" target="_blank" rel="noopener">{{ legalContent.i18ns.title }}</a>
            </p>
        {% endfor %}
    </div>

    {{ form_rest(form) }}

    <twig:Molecules:Button:Base
        text="{{ 'Continue without an account'|trans }}"
        type="submit"
        size="large"
        icon_right="chevron-right"
        class="w-max"
    />
    {{ form_end(form) }}
</div>
