<div class="Story">

    {# ── Base ───────────────────────────────────────────────────────────── #}

    <div class="Story-section">
        <h4 class="Story-title">Base</h4>
        <div class="Story-section Story-stage Story-stage--narrow">

            <div class="Story-col">
                <span class="Story-label">default (full range 0–100)</span>
                <twig:Fields:RangeSlider:Base nameMin="toolkit-a-min" nameMax="toolkit-a-max" :min="0" :max="100" />
            </div>

            <div class="Story-col">
                <span class="Story-label">narrowed (20–70)</span>
                <twig:Fields:RangeSlider:Base nameMin="toolkit-b-min" nameMax="toolkit-b-max" :min="0" :max="100" :valueMin="20" :valueMax="70" />
            </div>

            <div class="Story-col">
                <span class="Story-label">stepped (0–500, step 50)</span>
                <twig:Fields:RangeSlider:Base nameMin="toolkit-c-min" nameMax="toolkit-c-max" :min="0" :max="500" :step="50" :valueMin="100" :valueMax="350" />
            </div>

            <div class="Story-col">
                <span class="Story-label">amounts (price facet, 12–120 EUR)</span>
                <twig:Fields:RangeSlider:Base nameMin="toolkit-d-min" nameMax="toolkit-d-max" :min="12" :max="120" :valueMin="20" :valueMax="80" currency="EUR" />
            </div>

            <div class="Story-col">
                <span class="Story-label">amounts with the taxes (group shown prices with taxes)</span>
                <twig:Fields:RangeSlider:Base nameMin="toolkit-e-min" nameMax="toolkit-e-max" :min="12" :max="120" :valueMin="20" :valueMax="80" currency="EUR" taxDisplay="taxed" />
            </div>

            <div class="Story-col">
                <span class="Story-label">amounts without the taxes (group shown prices without taxes)</span>
                <twig:Fields:RangeSlider:Base nameMin="toolkit-f-min" nameMax="toolkit-f-max" :min="12" :max="120" :valueMin="20" :valueMax="80" currency="EUR" taxDisplay="untaxed" />
            </div>

        </div>
    </div>
</div>
