<div class="Story">

    {# ── Base ───────────────────────────────────────────────────────────── #}

    <div class="Story-section">
        <h4 class="Story-title">Base</h4>
        <div class="Story-section Story-stage Story-stage--narrow">

            <div class="Story-col">
                <span class="Story-label">default (full range 0–100)</span>
                <twig:Fields:RangeSlider:Base nameMin="toolkit-a-min" nameMax="toolkit-a-max" :min="0" :max="100" />
            </div>

            <div class="Story-col">
                <span class="Story-label">narrowed (20–70)</span>
                <twig:Fields:RangeSlider:Base nameMin="toolkit-b-min" nameMax="toolkit-b-max" :min="0" :max="100" :valueMin="20" :valueMax="70" />
            </div>

            <div class="Story-col">
                <span class="Story-label">stepped (0–500, step 50)</span>
                <twig:Fields:RangeSlider:Base nameMin="toolkit-c-min" nameMax="toolkit-c-max" :min="0" :max="500" :step="50" :valueMin="100" :valueMax="350" />
            </div>

        </div>
    </div>
</div>
