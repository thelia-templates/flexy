{% set choices = range(1, 10)|map(i => { value: 'option' ~ i, label: 'Option ' ~ i }) %}

<div class="Story">

    {# ── Base ───────────────────────────────────────────────────────────── #}

    <div class="Story-section">
        <h4 class="Story-title">Base</h4>
        <div class="Story-grid Story-grid--2">

            <div class="Story-col">
                <span class="Story-label">default</span>
                <twig:Fields:Select:Base label="Label" placeholder="Choose an option" choices="{{ choices }}" />
            </div>

            <div class="Story-col">
                <span class="Story-label">preselected value</span>
                <twig:Fields:Select:Base label="Label" value="option2" placeholder="Choose an option" choices="{{ choices }}" />
            </div>

            <div class="Story-col">
                <span class="Story-label">with help (tooltip)</span>
                <twig:Fields:Select:Base label="Label" placeholder="Choose an option" choices="{{ choices }}" help="This is a help text" />
            </div>

            <div class="Story-col">
                <span class="Story-label">multiple</span>
                <twig:Fields:Select:Base label="Label" multiple choices="{{ choices }}" help="This is a help text" />
            </div>

            <div class="Story-col">
                <span class="Story-label">error</span>
                <twig:Fields:Select:Base label="Label" error placeholder="Choose an option" choices="{{ choices }}" help="This is a help text" />
            </div>

            <div class="Story-col">
                <span class="Story-label">error with message</span>
                <twig:Fields:Select:Base label="Label" error="oups" placeholder="Choose an option" choices="{{ choices }}" help="This is a help text" />
            </div>

            <div class="Story-col">
                <span class="Story-label">success</span>
                <twig:Fields:Select:Base label="Label" success value="option2" choices="{{ choices }}" help="This is a help text" />
            </div>

            <div class="Story-col">
                <span class="Story-label">disabled</span>
                <twig:Fields:Select:Base label="Label" disabled placeholder="Choose an option" choices="{{ choices }}" help="This is a help text" />
            </div>

        </div>
    </div>

    {# ── Small ──────────────────────────────────────────────────────────── #}

    <div class="Story-section">
        <h4 class="Story-title">Small</h4>
        <div class="Story-grid Story-grid--3 Story-stage">

            <div class="Story-col">
                <span class="Story-label">default</span>
                <twig:Fields:Select:Base label="Label" placeholder="Choose an option" choices="{{ choices }}" size="small" />
            </div>

            <div class="Story-col">
                <span class="Story-label">with help (tooltip)</span>
                <twig:Fields:Select:Base label="Label" placeholder="Choose an option" choices="{{ choices }}" size="small" help="This is a help text" />
            </div>

            <div class="Story-col">
                <span class="Story-label">error</span>
                <twig:Fields:Select:Base label="Label" error placeholder="Choose an option" choices="{{ choices }}" size="small" help="This is a help text" />
            </div>

        </div>
    </div>

</div>
