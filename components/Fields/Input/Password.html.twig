{# @prop showCriteria boolean Whether to show password strength criteria. Defaults to `false` #}
{% props label = null, name = '', id = null, value = null, placeholder = null, error = false, disabled = false, required = false, optional = false, help = null, size = null, showCriteria = false, autocomplete = null %}

{% set fieldId = id ?? name %}
{% set passwordController = 'Fields--Input--password' %}

{# `error` is a message, a list of them, or true for the state alone. #}
{% set errorMessages = error is iterable
    ? error|filter(m => m is not empty)
    : (error is not same as(true) and error is not empty ? [error] : []) %}
{% set hasError = errorMessages|length > 0 or error is same as(true) %}
{% set describedBy = [
    errorMessages|length ? fieldId ~ '-error' : null,
    help ? fieldId ~ '-help' : null,
]|filter(id => id)|join(' ') %}

{% set fieldInput = html_cva(
    base: 'Input',
    variants: {
        size: { small: 'Input--small' },
    }
) %}

<div
    class="{{ fieldInput.apply({size: size}, attributes.render('class')) }}"
    {{ attributes.defaults({
        ...stimulus_controller(passwordController),
    }).without('class') }}
>
    {% if label or help %}
        <div class="Input-header">
            {% if label %}
                <label class="Input-label" for="{{ fieldId }}">
                    {{ label }}{% if required %} *{% endif %}{% if optional %} ({{ 'optional'|trans }}){% endif %}
                </label>
            {% endif %}
            {% if help %}
                <twig:Molecules:Tooltip:Help tooltip="{{ help }}" />
                {# The tooltip hides its text until opened, and a hidden target is not announced. #}
                <span id="{{ fieldId }}-help" class="sr-only">{{ help }}</span>
            {% endif %}
        </div>
    {% endif %}

    <div class="Input-blockInput" {{ stimulus_target(passwordController, 'wrapper') }}>
        <input
            type="password"
            name="{{ name }}"
            id="{{ fieldId }}"
            class="{{ ('Input-input Input-input--unit' ~ (hasError ? ' is-error' : ''))|tailwind_merge }}"
            {% if value is not null %}value="{{ value }}"{% endif %}
            {% if placeholder %}placeholder="{{ placeholder }}"{% endif %}
            {% if disabled %}disabled{% endif %}
            {% if required %}required{% endif %}
            {% if autocomplete %}autocomplete="{{ autocomplete }}"{% endif %}
            {% if hasError %}aria-invalid="true"{% endif %}
            {% if describedBy %}aria-describedby="{{ describedBy }}"{% endif %}
            {{ stimulus_target(passwordController, 'input') }}
            {{ stimulus_action(passwordController, 'control', 'input') }}
            {{ attributes.nested('input') }}
        />
        <div class="Input-buttonIcon">
            <button
                type="button"
                class="Input-togglePassword"
                aria-label="{{ 'Show/hide password'|trans }}"
                {{ stimulus_target(passwordController, 'toggler') }}
            >
                <span>{{ ux_icon('show') }}</span>
            </button>
        </div>
    </div>

    {% if errorMessages|length %}
        <p id="{{ fieldId }}-error" class="Input-error">{{ errorMessages|join(' ') }}</p>
    {% endif %}

    {% if showCriteria %}
        <div class="PasswordCriteria" {{ stimulus_target(passwordController, 'control') }}>
            {{ 'Your Message must contain'|trans }}:
            <ul>
                <li {{ stimulus_target(passwordController, 'size') }}>{{ 'at least 12 characters'|trans }}</li>
                <li {{ stimulus_target(passwordController, 'uppercase') }}>{{ 'at least 1 capital letter'|trans }}</li>
                <li {{ stimulus_target(passwordController, 'lowercase') }}>{{ 'at least 1 low-case letter'|trans }}</li>
                <li {{ stimulus_target(passwordController, 'number') }}>{{ 'at least 1 digit'|trans }}</li>
                <li {{ stimulus_target(passwordController, 'special') }}>{{ 'at least 1 special character'|trans }}</li>
            </ul>
        </div>
    {% endif %}
</div>
