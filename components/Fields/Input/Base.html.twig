{# @prop dir 'ltr'|null Forces the reading direction of the field. Left to null the direction is
    read off the type, which covers the values the browser already knows about; pass it for a
    text field that holds a value rather than a sentence - a company registration number, a VAT
    number, a reference. #}
{% props label = null, name = '', id = null, type = 'text', value = null, placeholder = null, error = false, success = false, disabled = false, required = false, optional = false, unit = null, help = null, size = null, autocomplete = null, dir = null %}

{% set fieldId = id ?? name %}

{# `error` is a message, a list of them, or true for the state alone. #}
{% set errorMessages = error is iterable
    ? error|filter(m => m is not empty)
    : (error is not same as(true) and error is not empty ? [error] : []) %}
{% set hasError = errorMessages|length > 0 or error is same as(true) %}
{% set describedBy = [
    errorMessages|length ? fieldId ~ '-error' : null,
    help ? fieldId ~ '-help' : null,
]|filter(id => id)|join(' ') %}

{# An e-mail address, a phone number, an URL or a figure is a value, not a sentence: the field
   keeps its own order inside a right-to-left page. The unit badge is pinned to the trailing
   edge of that value, so it has to read the same direction as the field it belongs to - an
   inset-inline-* offset resolves against the element's own direction, not the page's. #}
{% set fieldDir = dir ?? (type in ['email', 'tel', 'url', 'number'] ? 'ltr' : null) %}

{% set fieldInput = html_cva(
    base: 'Input',
    variants: {
        size: { small: 'Input--small' },
        success: { true: 'Input--success' },
    }
) %}

<div class="{{ fieldInput.apply({size: size, success: success}|filter(value => value is not null), attributes.render('class')) }}" {{ attributes.without('class') }}>
    {% if label or help %}
        <div class="Input-header">
            {% if label %}
                <label class="Input-label" for="{{ fieldId }}">
                    {{ label }}{% if required %} *{% endif %}{% if optional %} ({{ 'optional'|trans }}){% endif %}
                </label>
            {% endif %}
            {% if help %}
                <twig:Molecules:Tooltip:Help tooltip="{{ help }}" />
                {# The tooltip hides its text until opened, and a hidden target is not announced. #}
                <span id="{{ fieldId }}-help" class="sr-only">{{ help }}</span>
            {% endif %}
        </div>
    {% endif %}

    <div class="Input-blockInput">
        <input
            type="{{ type }}"
            name="{{ name }}"
            id="{{ fieldId }}"
            class="{{ ('Input-input' ~ (unit ? ' Input-input--unit' : '') ~ (hasError ? ' is-error' : ''))|tailwind_merge }}"
            {% if value is not null %}value="{{ value }}"{% endif %}
            {% if placeholder %}placeholder="{{ placeholder }}"{% endif %}
            {% if disabled %}disabled{% endif %}
            {% if required %}required{% endif %}
            {% if autocomplete %}autocomplete="{{ autocomplete }}"{% endif %}
            {% if hasError %}aria-invalid="true"{% endif %}
            {% if describedBy %}aria-describedby="{{ describedBy }}"{% endif %}
            {% if fieldDir %}dir="{{ fieldDir }}"{% endif %}
            {{ attributes.nested('input') }}
        />
        {% if unit %}
            <div class="Input-unit"{% if fieldDir %} dir="{{ fieldDir }}"{% endif %}>{{ unit }}</div>
        {% endif %}
    </div>

    {% if errorMessages|length %}
        <p id="{{ fieldId }}-error" class="Input-error">{{ errorMessages|join(' ') }}</p>
    {% endif %}
</div>
