{% use '@FlexyForm/flexy_form_theme.html.twig' %}
{% props error = false, label, required = false, type = 'checkbox', id = null %}

{# `error` is a message, a list of them, or true for the state alone. #}
{% set errorMessages = error is iterable
    ? error|filter(m => m is not empty)
    : (error is not same as(true) and error is not empty ? [error] : []) %}
{% set hasError = errorMessages|length > 0 or error is same as(true) %}
{% set errorId = errorMessages|length and id ? id ~ '-error' : null %}

{% set inputDefaults = id ? {type: type, id: id} : {type: type} %}

{% set checkbox = html_cva(
    base: 'Checkbox',
    variants: {
        error: {
            false: null,
            true: 'error',
        },
        type: {
            checkbox: null,
            radio: 'Checkbox--radio',
        },
    },
) %}

{# The message is a sibling of the label: inside it, it would be read as part of the name. #}
<div class="{{ ('Checkbox-field ' ~ attributes.render('class'))|tailwind_merge }}" {{ attributes.without('class') }}>
    <label class="{{ checkbox.apply({type, error: hasError}) }}">
        <input
            type="{{ type }}"
            {% if hasError %}aria-invalid="true"{% endif %}
            {% if errorId %}aria-describedby="{{ errorId }}"{% endif %}
            {{attributes.nested('input').defaults(inputDefaults).without('required', 'type')}}
            {{required ? ' required' : ''}}
        />
        <span class="Checkbox__checkmark">
            {{ ux_icon('checkbox') }}
        </span>
        <span class="Checkbox__label">{{ label }}{{required ? ' *' :''}}</span>
    </label>
    {% if errorMessages|length %}
        <p {% if errorId %}id="{{ errorId }}" {% endif %}class="Checkbox-error">{{ errorMessages|join(' ') }}</p>
    {% endif %}
</div>
