<div class="ProductGallery">
	<div class="ProductGallery-list" data-product-target="thumblist">
		<ul>
			{% for image in images %}
				<li class="ProductGallery-item cursor-pointer{% if loop.first  %} is-active{% endif %}">
					<button type="button" data-product-target="thumbnail" {% if image.productSaleElementsId %} {{ live_action('updateCurrentPseFromId', {pseId: image.productSaleElementsId} ) }} data-pse-id="{{image.productSaleElementsId}}" {% endif %}>
						{{getImages({
            'img_id': image.productImageId,
            'source_type': 'product',
            filters: 'default',
            'img_attrs': {
              'class' : 'ProductGallery-thumbnail',
              loading: 'lazy',
            },
            placeholder: asset('dist/images/placeholder.webp')
          })|raw}}
					</button>
				</li>
			{% endfor %}
		</ul>
	</div>
	<div class="ProductGallery-main" data-live-ignore>
		<section class="splide" aria-label="{{"Product's visuals"|trans}}" data-product-target='slider'>
			<div class="splide__track">
				<ul class="splide__list">
					{% for image in images %}
						<li class="splide__slide" data-product-target="slide" data-pse-id="{{image.productSaleElementsId}}">
							{{getImages({
                'img_id': image.productImageId,
                'source_type': 'product',
                filters: 'default',
                'img_attrs': {
                  'class' : 'ProductGallery-thumbnail',
                  loading: 'lazy',
                  'data-image-id': image.productImageId,
                },
                placeholder: asset('dist/images/placeholder.webp')
              })|raw}}
						</li>
					{% endfor %}
				</ul>
			</div>
			{% if images|length %}
				<div class="splide__arrows">
					<button class="splide__arrow splide__arrow--prev">
						{{ ux_icon('arrow-left') }}
					</button>
					<button class="splide__arrow splide__arrow--next">
						{{ ux_icon('arrow-right') }}
					</button>
				</div>
			{% endif %}

		</section>
	</div>
</div>
