<div class="ProductGallery" data-controller="gallery" data-gallery-current-pse-id-value="{{ currentPse.id }}">
	<ul class="ProductGallery-list">
		{% for image in images %}
			<li class="ProductGallery-item cursor-pointer{% if image.productSaleElementsId == currentPse.id  %} is-active{% endif %}">
				<button type="button" {{ live_action('refreshForm', {pseId : image.productSaleElementsId} ) }}>
					{{getImages({
            'img_id': image.productImageId,
            'source_type': 'product',
            filters: 'default',
            'img_attrs': {
              'class' : 'ProductGallery-thumbnail',
              loading: 'lazy',
            }
          })|raw}}
				</button>
			</li>
		{% endfor %}
	</ul>
	<div class="ProductGallery-main">
		<section id="ProductGallery" class="splide" aria-label="{{"Product's visuals"|trans}}" data-count={{images|length}} data-gallery-target='root' data-live-ignore>
			<div class="splide__track">
				<ul class="splide__list">
					{% for image in images %}
						<li class="splide__slide">
							{{getImages({
                'img_id': image.productImageId,
                'source_type': 'product',
                filters: 'default',
                'img_attrs': {
                  'class' : 'ProductGallery-thumbnail',
                  loading: 'lazy',
                  'data-image-id': image.productImageId,
                }
              })|raw}}
						</li>
					{% endfor %}
				</ul>
			</div>
			{% if images|length %}
				<div class="splide__arrows">
					<button class="splide__arrow splide__arrow--prev">
						{{ ux_icon('arrow-left') }}
					</button>
					<button class="splide__arrow splide__arrow--next">
						{{ ux_icon('arrow-right') }}
					</button>
				</div>
			{% endif %}

		</section>
	</div>
</div>
