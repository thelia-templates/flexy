<div class="flex flex-col gap-6" {{attributes}}>
	<div class='text-black h4'>{{'Change my password' | trans}}</div>
	{{ form_start(form, {attr : {
    class: 'flex flex-col gap-6 px-10 pt-8 pb-6 rounded-lg bg-theme-lighter',
    'data-model': 'norender|*',
    'data-action': 'live#action:prevent',
    'data-live-action-param': 'save'
  } }) }}
	{{form_rest(form)}}
	{% include "@components/Molecules/Button/Button.html.twig" with {text: 'Update my password' | trans, classes: 'Button--large mt-1.5 open-modal', type: 'submit' } %}
	{{ form_errors(form) }}
	{{ form_end(form) }}
</div>
