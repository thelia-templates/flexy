{% set withNewsletter = withNewsletter|default(false) %}

{% set footerStoreInfosClasses = 'md:border-r md:border-r-grey-lighter' %}
{% set footerLinksClasses = 'flex flex-col gap-2 md:gap-6 Footer-links mb-[30px] md:mb-0 md:pb-[70px] md:pt-[50px] md:pl-[40px] text-black' %}
{% set footerContainerClasses = 'md:grid-cols-2' %}

{% if withNewsletter %}
    {% set footerLinksClasses = footerLinksClasses ~ 'md:col-span-2 lg:col-span-1 text-black' %}
    {% set footerStoreInfosClasses = 'md:border-l md:border-l-grey-lighter lg:border-r lg:border-r-grey-lighter' %}
    {% set footerContainerClasses = 'md:grid-cols-2 lg:grid-cols-3' %}
{% endif %}

<footer class="Footer">
    <div class="md:grid {{ footerContainerClasses }}">
        {% if withNewsletter %}
            <div class="Footer-newsletter">
                <div class="font-semibold paragraph-1">
                    {{ 'Newsletter'|trans }}
                </div>
                <div class="mb-4 paragraph-5">
                    {{ 'Get our last news and promo'|trans }}
                </div>

                {{ component('Flexy:Button', {
                  text: 'Register to our newsletter'|trans,
                  fill: true,
                  size: 'large',
                  class: 'w-full md:w-auto',
                }) }}
            </div>
        {% endif %}
        <div class="Footer-storeInfos {{footerStoreInfosClasses }}">
            <div class="mb-1 font-semibold paragraph-1">
                {{ attr('config', 'store_name') }}
            </div>
            <div class="Footer-storeAddress">
                {% set idCountry = attr('config', 'store_country') %}
                {% set country = idCountry ? country_name(idCountry) : null %}

                <div class="paragraph-5">
                    {{ attr('config', 'store_address1') }}
                    <br>
                    {{ attr('config', 'store_address2') }}
                    <br>
                    {{ attr('config', 'store_zipcode') }}
                    {{ attr('config', 'store_city') }}
                    <br>
                    {{ country }}
                </div>
                <div class="my-4 paragraph-5">
                    Tel.
                    {{ attr('config', 'store_phone') }}
                </div>
            </div>
            {{ component('Flexy:Button', {
              href: '/contact',
              text: 'Contact Us'|trans,
              color: 'secondary',
              size: 'large',
              icon_right: 'email',
            }) }}
        </div>
        <ul class="lg:pt-[100px] {{ footerLinksClasses }}">
            {% set footerLinkClass = 'underline hover:no-underline focus:no-underline hover:opacity-75 focus:opacity-75' %}
            {% set contents = resources('/api/front/contents', {'contentFolders.folder.id':attr('config','information_folder_id')}) %}

            {% for content in contents %}
                <li class="paragraph-5">
                    <a href="{{ content.publicUrl }}" class="{{ footerLinkClass }}">
                        {{ content.i18ns.title }}
                    </a>
                </li>
            {% endfor %}
        </ul>
    </div>

    <div class="Footer-socialsWrapper">
        <div class="Footer-socials">
            <div class="Footer-icon">
                {{ ux_icon('instagram') }}
            </div>
            <div class="Footer-icon">
                {{ ux_icon('pinterest') }}
            </div>
            <div class="Footer-icon">
                {{ ux_icon('youtube') }}
            </div>
            <div class="Footer-icon">
                {{ ux_icon('twitter') }}
            </div>
            <div class="Footer-icon">
                {{ ux_icon('facebook') }}
            </div>
            <div class="Footer-icon">
                {{ ux_icon('linkedin') }}
            </div>
            <div class="Footer-icon">
                {{ ux_icon('tiktok') }}
            </div>
        </div>

        <div class="text-grey indication indication-small">
            ©
            <a href="https://www.openstudio.fr/">
                OpenStudio
            </a>
            -
            {{ 'now'|date('Y') }}
        </div>
    </div>
</footer>
