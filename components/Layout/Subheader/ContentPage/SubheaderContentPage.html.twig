{% set title = title|default('') %}
{% set description = description|default('') %}

<div class="Subheader Subheader--contentPage">
    <div class="container flex flex-col grow py-6">
        {% if breadcrumb|length %}
            {{ include('@components/Molecules/Breadcrumb/Breadcrumb.html.twig', {items: breadcrumb}) }}
        {% endif %}
        <div class="my-auto">
            <h1 class="Subheader-title">
                {{ title }}
            </h1>
            {% if description %}
                <div class="Subheader-description">
                    {{ description|raw }}
                </div>
            {% endif %}
        </div>
    </div>

</div>
