{# @description The latest contents of a folder under a heading, in a slider: picture, title and date of each. #}
{# @prop title string The heading above the contents #}
{# @prop folderId folder|null The folder whose contents are listed; the contents of the whole site when there is none #}
{# @prop button {href: string, label: string}|null The button under the band, to a page that shows more #}
{# @prop button.href Where the button leads #}
{# @prop button.label What the button says #}
{% props title = '', button = null %}

<div class="{{ ('container-l py-14 xl:py-20 ' ~ attributes.render('class'))|tailwind_merge }}" {{ attributes.without('class') }}>
    <h2 class="pb-6 text-black h4">{{ title }}</h2>
    <div class="SimilarContents" {{ stimulus_controller('simple-slider') }}>
        {% for content in this.contents %}
            <twig:Organisms:SimilarContentCard:Base
                id="{{ content.id }}"
                title="{{ content.title }}"
                date="{{ content.date }}"
                url="{{ content.url }}"
            />
        {% endfor %}
    </div>
    {% if button %}
        <twig:Molecules:Button:Base href="{{ button.href }}" text="{{ button.label }}" icon_right="chevron-right" color="secondary" class="mt-5" />
    {% endif %}
</div>
