{# @prop items list<{strongText: string|null, text: string, icon: icon|null, link: string|null, linkLabel: string|null}> max:6 The reassurance points, side by side #}
{# @prop items.strongText The lead-in, in bold #}
{# @prop items.text The line that follows it #}
{# @prop items.icon The icon drawn above the point #}
{# @prop items.link The address of a page that tells more, optional #}
{# @prop items.linkLabel The words of that link #}
{% props items = [] %}

<div class="{{ ('ReinsuranceModule ' ~ attributes.render('class'))|tailwind_merge }}" {{ attributes.without('class') }}>
    <div class="ReinsuranceModule-wrapper">
        {% for item in items %}
            <div>
                {% if item.icon is defined and item.icon %}
                    <span class="ReinsuranceModule-icon">
                        {{ ux_icon(item.icon) }}
                    </span>
                {% endif %}
                <div>
                    {% if item.strongText is defined and item.strongText %}
                        <strong>{{ item.strongText }}</strong>
                    {% endif %}
                    <div class="ReinsuranceModule-text">
                        {{ item.text }}
                    </div>
                    {% if item.link is defined and item.link %}
                        <div class="ReinsuranceModule-link">
                            <twig:Molecules:Link:Base
                                href="{{ item.link }}"
                                customText="{{ item.linkLabel|default('') }}"
                                size="small"
                            />
                        </div>
                    {% endif %}
                </div>
            </div>
        {% endfor %}
    </div>
</div>
