{% set items = [
    {
        icon: 'reinsurance-delivery',
        strongText: 'Free delivery'|trans,
        text: 'For any order over €100'|trans,
        linkLabel: 'See conditions'|trans,
        link: '#',
    },
    {
        icon: 'reinsurance-payment',
        strongText: 'Secure payment'|trans,
        text: 'Credit card, Paypal'|trans,
        linkLabel: 'See conditions'|trans,
        link: '#',
    },
    {
        icon: 'reinsurance-satisfied',
        strongText: 'Satisfied or refunded'|trans,
        text: 'Exchange or refund offered within 30 days'|trans,
        linkLabel: 'See conditions'|trans,
        link: '#',
    },
] %}

<div class="Story">
    <div class="Story-section">
        <h4 class="Story-title">base</h4>
        <twig:Layouts:ReinsuranceModule:Base :items="items" />
    </div>

    <div class="Story-section">
        <h4 class="Story-title">without links</h4>
        <twig:Layouts:ReinsuranceModule:Base :items="items|map(item => item|merge({link: null}))" />
    </div>

    <div class="Story-section">
        <h4 class="Story-title">two items</h4>
        <twig:Layouts:ReinsuranceModule:Base :items="items|slice(0, 2)" />
    </div>
</div>
