{# @prop id string Id of this section, used by Molecules--MobileDrawer--open triggers rendered outside it (e.g. Layouts/Subheader/Category). Defaults to 'product-listing' #}
{% props id = 'product-listing' %}

{# The Flexy widgets are no longer a global form theme, so the filter form must opt in
   explicitly — without this the pill/fieldset/range blocks below never apply. #}
{% form_theme form with flexy_form_themes only %}

{# container-double-2 splits into sidebar + grid, so it needs both slots: without filters the
   listing is a single full-width column instead. #}
{% set hasFilters = filters|length > 0 %}

<section
    {{ attributes.defaults({
        id: id,
        class: (hasFilters ? 'container-double-2' : 'container-l') ~ ' ProductListing',
        ...stimulus_controller('Molecules--MobileDrawer--base')|stimulus_controller('Layouts--ProductListing--base'),
    }) }}
>
    {# The only way to sort below lg, where the toolbar is hidden — so it is rendered even with no
       filters, carrying the sort section alone, and dropped from lg. #}
    <div class="{{ hasFilters ? '' : 'lg:hidden' }}">
        <twig:Molecules:MobileDrawer:Base staticFrom="lg" class="ProductListing-panel">
            <p class="ProductListing-drawerTitle h4 lg:hidden">{{ (hasFilters ? 'Sort & filter' : 'Sort by')|trans }}</p>

            {# Sorting is a LiveProp rather than a form field: the desktop <select> below and this
               list drive the same action, and it must not end up mixed into the filter values. #}
            <div class="ProductListing-section lg:hidden">
                {# Without filters the drawer title already says it #}
                {% if hasFilters %}
                    <p class="ProductListing-sectionTitle">{{ 'Sort by'|trans }}</p>
                {% endif %}
                <twig:Molecules:Accordion:Base id="{{ id }}-sort">
                    <twig:Molecules:Accordion:Item value="sort" class="FilterAccordion">
                        <twig:Molecules:Accordion:Trigger iconClosed="plus" iconOpen="minus" class="paragraph-2 py-3">
                            {{ 'Choose'|trans }}
                        </twig:Molecules:Accordion:Trigger>
                        <twig:Molecules:Accordion:Content>
                            <ul class="flex flex-col gap-1">
                                {% for choice in sorts %}
                                    <li>
                                        {{ component('Molecules:FilterList:Base', {
                                            type: 'radio',
                                            label: choice.title|trans,
                                            'input:name': id ~ '-sort-choice',
                                            'input:value': choice.value,
                                            'input:checked': sort == choice.value,
                                            'input:data-action': 'Layouts--ProductListing--base#sortChange',
                                        }) }}
                                    </li>
                                {% endfor %}
                            </ul>
                        </twig:Molecules:Accordion:Content>
                    </twig:Molecules:Accordion:Item>
                </twig:Molecules:Accordion:Base>
            </div>

            {% if hasFilters %}
                {# One listener for every pill: the checkboxes themselves are rendered by the form theme #}
                <div class="ProductListing-section" data-action="change->Layouts--ProductListing--base#filterChange">
                    {{ form(form) }}
                </div>
            {% endif %}

            <div class="ProductListing-actions">
                {% if activeFilterCount %}
                    <twig:Molecules:Button:Base
                        text="{{ 'Clear'|trans }} ({{ activeFilterCount }})"
                        color="secondary"
                        size="small"
                        class="ProductListing-clear max-lg:text-sm max-lg:px-6 max-lg:py-3"
                        {{ ...stimulus_action('Layouts--ProductListing--base', 'reset', 'click') }}
                    />
                {% endif %}
                <twig:Molecules:Button:Base
                    text="{{ 'Apply'|trans }}"
                    class="lg:hidden"
                    {{ ...stimulus_action('Molecules--MobileDrawer--base', 'close', 'click') }}
                />
            </div>
        </twig:Molecules:MobileDrawer:Base>
    </div>

    <div>
        <div class="ProductListing-toolbar">
            {% if pagination.totalItems %}
                <span class="paragraph-4">{{ pagination.totalItems }} {{ 'product(s)'|trans }}</span>
            {% endif %}

            <div class="ProductListing-sort">
                {{ component('Fields:Select:Base', {
                    id: id ~ '-sort-select',
                    label: 'Sort by'|trans,
                    choices: sorts|map(choice => {value: choice.value, label: choice.title|trans}),
                    value: sort,
                    placeholder: 'Sort by'|trans,
                    'select:data-action': 'Layouts--ProductListing--base#sortChange',
                }) }}
            </div>
        </div>

        <div class="ProductListing-grid" data-loading="addClass(opacity-50)" data-listing-total="{{ pagination.totalItems }}">
            {% if products|length %}
                {% for product in products %}
                    <twig:Organisms:ProductCard:Base :product="product" class="h-full" />
                {% endfor %}
            {% else %}
                <div class="ProductListing-empty">
                    <h3 class="h4 text-center">
                        {{ (searchTerm is not null and searchTerm|trim is empty
                            ? 'Enter a search term to see products'
                            : 'No products found')|trans }}
                    </h3>
                    {% if activeFilterCount %}
                        <twig:Molecules:Button:Base
                            text="{{ 'Clear filters'|trans }} ({{ activeFilterCount }})"
                            color="secondary"
                            {{ ...stimulus_action('Layouts--ProductListing--base', 'reset', 'click') }}
                        />
                    {% else %}
                        <twig:Molecules:Button:Base href="/" text="{{ 'Home'|trans }}" color="secondary" />
                    {% endif %}
                </div>
            {% endif %}
        </div>

        {% if products|length %}
            {{ include('@Flexy/Molecules/Pagination/Base.html.twig', pagination) }}
        {% endif %}
    </div>
</section>
