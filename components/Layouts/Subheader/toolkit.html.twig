<div class="Story">

    {# ── Title Only ──────────────────────────────────────────────────────── #}

    <div class="Story-section">
        <h4 class="Story-title">Title Only</h4>
        <div class="Story-col">

            <div class="Story-col">
                <span class="Story-label">default (container-l)</span>
                <twig:Layouts:Subheader:Base title="Nom de la page" />
            </div>

            <div class="Story-col">
                <span class="Story-label">container-m</span>
                <twig:Layouts:Subheader:Base title="Nom de la page" container="medium" />
            </div>

            <div class="Story-col">
                <span class="Story-label">container-s</span>
                <twig:Layouts:Subheader:Base title="Nom de la page" container="small" />
            </div>

            <div class="Story-col">
                <span class="Story-label">container-single-3 — single-column text page (e.g. FAQ), aligns with the body below it</span>
                <twig:Layouts:Subheader:Base title="Nom de la page" container="single-3" />
            </div>

            <div class="Story-col">
                <span class="Story-label">centered</span>
                <twig:Layouts:Subheader:Base title="Nom de la page" :centered="true" />
            </div>

            <div class="Story-col">
                <span class="Story-label">with breadcrumb</span>
                <twig:Layouts:Subheader:Base title="Nom de la page" :breadcrumb="[{title: 'Page name'}]" />
            </div>

        </div>
    </div>

    {# ── Content Page ────────────────────────────────────────────────────── #}

    <div class="Story-section">
        <h4 class="Story-title">Content Page</h4>
        <div class="Story-col">

            <div class="Story-col">
                <span class="Story-label">with description</span>
                <twig:Layouts:Subheader:Item title="Nom du contenu" description="<p>Chapo du contenu, potentiellement en HTML.</p>" />
            </div>

            <div class="Story-col">
                <span class="Story-label">without description</span>
                <twig:Layouts:Subheader:Item title="Nom du contenu" />
            </div>

            <div class="Story-col">
                <span class="Story-label">with breadcrumb</span>
                <twig:Layouts:Subheader:Item title="Nom du contenu" :breadcrumb="[{title: 'Content name'}]" />
            </div>

            <div class="Story-col">
                <span class="Story-label">with image (itemType/itemId): fetches a real illustration via getImages() — depends on real database data, no preview in the toolkit</span>
                <twig:Layouts:Subheader:Item title="Nom du contenu" />
            </div>

        </div>
    </div>

</div>
