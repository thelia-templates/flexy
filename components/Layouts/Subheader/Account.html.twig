{# @prop title string Heading text #}
{# @prop selected string Slug of the active section, as given by AccountMenuService ('profile', 'orders', 'addresses', 'payment-methods', 'purchase-lists', 'quick-order', or an entry a provider adds). Defaults to 'profile' #}
{# @prop breadcrumb array Breadcrumb items, forwarded to Molecules:Breadcrumb:Base. Defaults to empty (no breadcrumb rendered) #}
{% props title, selected = 'profile', breadcrumb = [] %}

<div class="{{ ('Subheader Subheader--account ' ~ attributes.render('class'))|tailwind_merge }}" {{ attributes.without('class') }}>
    <twig:Molecules:Breadcrumb:Base :items="breadcrumb" />

    <div class="container-l flex flex-col items-center gap-10">
        <h1 class="Subheader-title">{{ title }}</h1>

        {# A suspended company keeps its buyers signed in and its history readable: the account says why nothing can be ordered. #}
        {% if company_account().suspended %}
            <twig:Molecules:SnackBar:Base
                variant="warning"
                :withIcon="true"
                text="{{ 'Your company account is suspended: orders cannot be placed until it is reactivated.'|trans }}"
                class="w-full max-w-4xl"
                data-testid="company-suspended-banner"
            />
        {% endif %}

        <nav class="w-full flex justify-center" aria-label="{{ 'My account'|trans }}">
            <ul class="Subheader-links">
                {% for item in this.items %}
                    <li class="flex-1">
                        <twig:Molecules:Button:Base
                            text="{{ item.text }}"
                            href="{{ item.href }}"
                            size="small"
                            :sharp="true"
                            color="{{ selected == item.slug ? 'base' : 'secondary' }}"
                            class="w-full h-full"
                            {{ ...(selected == item.slug ? {'aria-current': 'page'} : {}) }}
                        />
                    </li>
                {% endfor %}
            </ul>
        </nav>
    </div>
</div>
