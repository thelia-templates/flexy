{# @prop withNewsletter bool Show the newsletter column and switch to a 3-column layout on desktop #}
{% props withNewsletter = false %}

{% set footer = html_cva(
    base: 'Footer',
    variants: {
        withNewsletter: {
            true: 'Footer--withNewsletter',
        },
    }
) %}

<footer class="{{ footer.apply({withNewsletter}, attributes.render('class')) }}" {{ attributes.without('class') }}>
    <div class="Footer-grid container-l">
        {% if withNewsletter %}
            <div class="Footer-newsletter">
                <div class="Footer-newsletterTitle paragraph-1">{{ 'Newsletter'|trans }}</div>
                <div class="Footer-newsletterText paragraph-5">{{ 'Get our last news and promo'|trans }}</div>
                <twig:Molecules:Button:Base text="{{ 'Register to our newsletter'|trans }}" size="large" class="Footer-newsletterButton" />
            </div>
        {% endif %}
        <div class="Footer-storeInfos">
            {# The shop's own identity and address are typed by the merchant, in whatever language
               the shop is run in. <bdi> isolates each line and reads its direction off its own
               first strong character, so a latin address stays latin ("5 rue Rochon", not "rue
               Rochon 5") on a right-to-left page and an arabic one is left alone. #}
            <div class="Footer-storeName paragraph-1"><bdi>{{ attr('config', 'store_name') }}</bdi></div>
            <div class="Footer-storeAddress">
                {% set address2 = attr('config', 'store_address2') %}
                {% set idCountry = attr('config', 'store_country') %}
                {% set country = idCountry ? country_name(idCountry) : null %}
                <div class="paragraph-5">
                    <bdi>{{ attr('config', 'store_address1') }}</bdi><br>
                    {% if address2 %}<bdi>{{ address2 }}</bdi><br>{% endif %}
                    <bdi>{{ attr('config', 'store_zipcode') }} {{ attr('config', 'store_city') }}</bdi>
                    {% if country %}<br><bdi>{{ country }}</bdi>{% endif %}
                </div>
                {# A phone number never flips: its "+", its brackets and its digits read left to
                   right in every language. dir on the inline span, never on the block, which
                   would re-resolve the line's own text-align: start. #}
                <div class="Footer-storePhone paragraph-5">
                    {# Untranslated, so it stays a Latin string whatever the page's language;
                       <bdi> around it would isolate nothing. #}
                    Tel.
                    <a href="tel:{{ attr('config', 'store_phone')|replace({' ': '', '(': '', ')': ''}) }}">
                        <span dir="ltr">{{ attr('config', 'store_phone') }}</span>
                    </a>
                </div>
            </div>
            <twig:Molecules:Button:Base href="/contact" text="{{ 'Contact Us'|trans }}" color="secondary" size="large" icon_right="email" />
        </div>
        <ul class="Footer-links">
            {% set contents = resources('/api/front/contents', {'contentFolders.folder.id': attr('config', 'information_folder_id'), visible: true}) %}
            {% for content in contents %}
                <li class="paragraph-5">
                    <a href="{{ content.publicUrl }}" class="Footer-link">{{ content.i18ns.title }}</a>
                </li>
            {% endfor %}
        </ul>
    </div>

    <hr class="h-px text-grey-lighter hidden md:block">

    <div class="Footer-socialsWrapper container-l">
        <div class="Footer-socials">
            <div class="Footer-icon">{{ ux_icon('instagram') }}</div>
            <div class="Footer-icon">{{ ux_icon('pinterest') }}</div>
            <div class="Footer-icon">{{ ux_icon('youtube') }}</div>
            <div class="Footer-icon">{{ ux_icon('twitter') }}</div>
            <div class="Footer-icon">{{ ux_icon('facebook') }}</div>
            <div class="Footer-icon">{{ ux_icon('linkedin') }}</div>
            <div class="Footer-icon">{{ ux_icon('tiktok') }}</div>
        </div>
        {# A latin line that never gets translated: kept left to right whole, otherwise the sign,
           the dash and the year end up on the wrong side of the name. #}
        <div class="Footer-copyright text-grey-dark indication indication-small">
            <span dir="ltr">© <a href="https://www.openstudio.fr/">OpenStudio</a> - {{ 'now'|date('Y') }}</span>
        </div>
    </div>
</footer>
