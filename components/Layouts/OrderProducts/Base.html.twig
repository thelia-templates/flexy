{# @prop orderProducts array Order lines, resolved in one batch and handed to each card #}
{# @prop order array|null The owning order, carried only to feed the per-line hook points #}
{# @prop downloadRoute string The route serving a virtual line's file. The account one by
   default; a page reached without an account passes its own, which is guarded by whatever
   let the visitor in — the account route would answer nothing to them. #}
{# @prop downloadRouteParams array Whatever that route needs besides the line id #}
{% props orderProducts = [], order = null, downloadRoute = 'account_order_download', downloadRouteParams = {} %}
{% for line in this.lines %}
	{{ theme_hook('account-order.item.top', {order: order, orderProduct: line.orderProduct}) }}
	<twig:Organisms:ProductCard:Order
		:orderProduct="line.orderProduct"
		:product="line.product"
		:pse="line.pse"
		:imageId="line.imageId"
	/>
	{# A virtual line carries its file only once the order is paid for, and only when a
	   document was attached to it: `virtual` alone says the product was sold as a file,
	   not that one is there to be served. The route answers 404 in every other case, so
	   the link is shown only where it leads somewhere. `default(null)` keeps a core whose
	   order payload predates the property from breaking the whole page over a link. #}
	{% if line.orderProduct.virtualDocument|default(null)
		and order is not null and order.orderStatus.code in ['paid', 'processing', 'sent'] %}
		<twig:Molecules:Button:Base
			text="{{ 'Download my file'|trans }}"
			href="{{ path(downloadRoute, downloadRouteParams|merge({orderProductId: line.orderProduct.id})) }}"
			icon_right="download"
			class="mb-6 w-max"
		/>
	{% endif %}
	{{ theme_hook('account-order.item.bottom', {order: order, orderProduct: line.orderProduct}) }}
{% endfor %}
