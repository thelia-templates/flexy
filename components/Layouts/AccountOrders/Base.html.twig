{% if this.orders|length %}
    <div class="AccountOrders-list">
        {% for order in this.orders %}
            <twig:Organisms:OrderCard:Base :orderId="order.id" />
        {% endfor %}
    </div>

    <div class="flex justify-center mt-10">
        <twig:Molecules:Pagination:Base
            :totalItems="this.pagination.totalItems"
            :itemsPerPage="this.pagination.itemsPerPage"
            :currentPage="this.pagination.currentPage"
        />
    </div>
{% else %}
    <div class="flex flex-col items-center text-center">
        <div class="w-36 h-auto lg:w-60">
            {{ source('assets/images/nothing.svg') }}
        </div>
        <h3 class="h3 mt-4 mb-6">{{ 'You have no orders yet'|trans }}</h3>
    </div>
{% endif %}
