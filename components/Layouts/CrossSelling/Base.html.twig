{% props title = '', button = null %}

{% if this.products is not empty %}
    <div class="{{ ('container-l pt-14 pb-17 xl:pt-17 xl:pb-26 ' ~ attributes.render('class'))|tailwind_merge }}" {{ attributes.without('class') }}>
        <h2 class="pb-6 text-black h2">{{ title }}</h2>
        <div class="CrossSelling" {{ stimulus_controller('simple-slider') }}>
            {% for product in this.products %}
                <twig:Organisms:ProductCard:Base :product="product" />
            {% endfor %}
        </div>
        {% if button %}
            <div class="mt-5">
                <twig:Molecules:Button:Base href="{{ button.href }}" text="{{ button.label }}" icon_right="chevron-right" color="secondary" />
            </div>
        {% endif %}
    </div>
{% endif %}
