{# @description Products under a heading, in a slider: the products picked by hand, in their order, or else the first products of a category. #}
{# @prop title string The heading above the products #}
{# @prop productIds product[] max:12 The products shown, in this order; none picked shows the first products of the category #}
{# @prop categoryId category|null The category whose first products are shown when none is picked; the whole catalogue when there is none either #}
{# @prop button {href: string, label: string}|null The button under the band, to a page that shows more #}
{# @prop button.href Where the button leads #}
{# @prop button.label What the button says #}
{% props title = '', button = null %}

{% if this.products is not empty %}
    <div class="{{ ('container-l pt-14 pb-17 xl:pt-17 xl:pb-26 ' ~ attributes.render('class'))|tailwind_merge }}" {{ attributes.without('class') }}>
        <h2 class="pb-6 text-black h2">{{ title }}</h2>
        <div class="CrossSelling" {{ stimulus_controller('simple-slider') }}>
            {% for product in this.products %}
                <twig:Organisms:ProductCard:Base :product="product" />
            {% endfor %}
        </div>
        {% if button %}
            <div class="mt-5">
                <twig:Molecules:Button:Base href="{{ button.href }}" text="{{ button.label }}" icon_right="chevron-right" color="secondary" />
            </div>
        {% endif %}
    </div>
{% endif %}
