<div class="{{ ('DeliveryTracking ' ~ attributes.render('class'))|tailwind_merge }}" {{ attributes.without('class') }}>
    <div class="DeliveryTracking-content">
        <div>
            <div class="DeliveryTracking-title">{{ 'Delivery tracking'|trans }}</div>
            {% if this.trackingRef %}
                <div class="DeliveryTracking-desc">
                    {{ 'Tracking number'|trans }} <span dir="ltr">{{ this.trackingRef }}</span>
                </div>
            {% endif %}
        </div>
        {% if this.trackLink %}
            {# The carrier site opens in a tab of its own, without a handle on this page. #}
            <twig:Molecules:Button:Base
                text="{{ 'Track my package'|trans }}"
                href="{{ this.trackLink }}"
                target="_blank"
                rel="noopener noreferrer"
                size="small"
                data-testid="delivery-tracking-link"
            />
        {% endif %}
    </div>

    <hr />

    <ul class="DeliveryTracking-steps">
        {% for index, step in this.steps %}
            <li class="DeliveryTracking-step {{ index == this.currentStep ? 'DeliveryTracking-step--active' : '' }}">
                <span class="DeliveryTracking-icon">
                    {% if index <= this.currentStep %}{{ ux_icon('checkmark') }}{% endif %}
                </span>
                {{ step|trans }}
            </li>
        {% endfor %}
    </ul>
</div>
