<div class="{{ ('ProductCard ProductCard--order ' ~ attributes.render('class'))|tailwind_merge }}" {{ attributes.without('class') }}>
	<div class="ProductCard-mainContent">
		{{ getImages({
			source_type: 'product',
			img_id: this.imageId,
			filters: 'order_card_detail',
			limit: 1,
			alt: this.title,
			wrapper: 'figure',
			wrapper_attrs: {class: 'ProductCard-img'},
			img_attrs: {
				loading: 'lazy',
			},
			placeholder: asset('images/placeholder2.webp'),
		})|raw }}
		<div class="ProductCard-desc">
			<a href="{{ this.productUrl|default('#') }}" class="ProductCard-title">{{ this.title }}</a>
			<div class="ProductCard-orderInfos">
				<span class="ProductCard-secondaryTitle basis-full">{{ this.product ? this.product.chapo|raw : "" }}</span>
				{% if this.pse %}
					{% for combination in this.pse.attributeCombinations|default([]) %}
						<span class="ProductCard-secondarySize"><bdi>{{ combination.attribute.i18ns.title }}: {{ combination.attributeAv.i18ns.title }}</bdi></span>
					{% endfor %}
				{% endif %}
				{% if this.orderProduct.quantity %}
					<span><bdi>{{ 'Quantity'|trans }}{{ 'label_colon'|trans }} {{ this.orderProduct.quantity }}</bdi></span>
				{% endif %}
			</div>
			{# dir="ltr" on the inline span, never on the block: a block re-resolves its own
			   text-align: start and would pin the price to the left of a right-to-left card. #}
			{% if this.orderProduct.wasInPromo %}
				<div class="ProductCard-footer">
					<div class="ProductCard-price"><span dir="ltr">{{ this.displayedPrice.amount|format_currency(this.currencyCode, locale: lang_code) }}</span><twig:Atoms:TaxMention:Base :display="this.displayedPrice.display" /></div>
					<div class="ProductCard-originalPrice"><span dir="ltr">{{ this.displayedOriginalPrice.amount|format_currency(this.currencyCode, locale: lang_code) }}</span></div>
				</div>
			{% else %}
				<div class="ProductCard-price"><span dir="ltr">{{ this.displayedPrice.amount|format_currency(this.currencyCode, locale: lang_code) }}</span><twig:Atoms:TaxMention:Base :display="this.displayedPrice.display" /></div>
			{% endif %}
		</div>
	</div>
</div>
