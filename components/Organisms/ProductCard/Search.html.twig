{# The whole tile is the link: a suggestion row has no secondary action to compete with it #}
<a
    href="{{ this.product.publicUrl }}"
    class="{{ ('ProductCard ProductCard--search ' ~ attributes.render('class'))|tailwind_merge }}"
    {{ attributes.without('class') }}
>
    {{ getImages({
        source_type: 'product',
        img_id: this.imageId,
        filters: 'search_card',
        limit: 1,
        alt: this.product.title,
        wrapper: 'figure',
        wrapper_attrs: {class: 'ProductCard-img'},
        img_attrs: {
            loading: 'lazy',
        },
        placeholder: asset('images/placeholder2.webp'),
    })|raw }}

    <span class="ProductCard-desc">
        <span class="ProductCard-title">{{ this.product.title }}</span>
        {# .ProductCard-desc is a stretching flex column here, so these spans are blockified:
           dir="ltr" goes on an inner inline span, never on the flex item itself. #}
        {% if this.displayedPrice %}
            {% if this.isPromo %}
                <span class="ProductCard-price"><span dir="ltr">{{ this.displayedPromoPrice.amount|format_currency(current_currency_code(), locale: lang_code) }}</span><twig:Atoms:TaxMention:Base :display="this.displayedPromoPrice.display" /></span>
                {% if this.showsInitialPrice %}
                    <span class="ProductCard-originalPrice"><span dir="ltr">{{ this.displayedPrice.amount|format_currency(current_currency_code(), locale: lang_code) }}</span></span>
                {% endif %}
            {% else %}
                <span class="ProductCard-price"><span dir="ltr">{{ this.displayedPrice.amount|format_currency(current_currency_code(), locale: lang_code) }}</span><twig:Atoms:TaxMention:Base :display="this.displayedPrice.display" /></span>
            {% endif %}
        {% endif %}
    </span>
</a>
