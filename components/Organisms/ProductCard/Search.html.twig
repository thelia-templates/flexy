{# The whole tile is the link: a suggestion row has no secondary action to compete with it #}
<a
    href="{{ this.product.publicUrl }}"
    class="{{ ('ProductCard ProductCard--search ' ~ attributes.render('class'))|tailwind_merge }}"
    {{ attributes.without('class') }}
>
    {{ getImages({
        source_type: 'product',
        img_id: this.imageId,
        filters: 'search_card',
        limit: 1,
        alt: this.product.title,
        wrapper: 'figure',
        wrapper_attrs: {class: 'ProductCard-img'},
        img_attrs: {
            loading: 'lazy',
        },
        placeholder: asset('images/placeholder2.webp'),
    })|raw }}

    <div class="ProductCard-desc">
        <span class="ProductCard-title">{{ this.product.title }}</span>
        {# The same block as the card and the sheet: a price the buyer is not shown, or may not buy, is not printed here either.
           The tile is the link, so the block keeps its wording and drops its buttons. #}
        <twig:Molecules:PriceBlock:Base
            variant="card"
            :actions="false"
            :mode="this.priceDisplayMode"
            :price="this.shownPrice"
            :originalPrice="this.struckPrice"
            :purchasable="this.purchasable"
        />
    </div>
</a>
