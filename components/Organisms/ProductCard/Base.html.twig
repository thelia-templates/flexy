{# @description One product as a card: its picture, its name, its price and its badges (new, sale, pre-order). #}
{# @prop productId product The product the card shows #}
{# @prop imgWidth int The width of the picture, in pixels #}
{# @prop imgHeight int The height of the picture, in pixels #}
{# @prop wishButton bool Show the button that adds the product to the wishlist #}
{# @prop inWishlist bool Draw that button as already pressed #}
{% props
    imgWidth = 300,
    imgHeight = 300,
    wishButton = false,
    inWishlist = false
%}


<div class="{{ ('ProductCard ' ~ attributes.render('class'))|tailwind_merge }}" {{ attributes.without('class') }}>
	<div class="ProductCard-header">
		<div class="ProductCard-tagList">
			{% if this.isNew %}
				{{ include('@Flexy/Molecules/Tag/Base.html.twig', {customText: 'New'|trans, color: 'warning'}) }}
			{% endif %}
			{% if this.isPreorder %}
				{{ include('@Flexy/Molecules/Tag/Stock.html.twig', {customText: 'Pre-order'|trans, color: 'preorder'}) }}
			{% endif %}
			{% if this.showsInitialPrice %}
				{{ include('@Flexy/Molecules/Tag/Base.html.twig', {customText: this.promoRate|format_number(style: 'percent'), color: 'error'}) }}
			{% endif %}
			{% if this.runningSaleTag and this.runningSaleTag.saleLabel %}
				{{ include('@Flexy/Molecules/Tag/Base.html.twig', {customText: this.runningSaleTag.saleLabel, color: 'sale'}) }}
			{% endif %}
		</div>

		{% if wishButton %}
			<button type="button" class="ButtonWishList {% if inWishlist %}in-wishlist{% endif %}">
				<span class="in-wishlist-icon">
					<span>{{ ux_icon('heart-fill') }}</span>
				</span>
				<span class="not-in-wishlist-icon">
					<span>{{ ux_icon('heart') }}</span>
				</span>
			</button>
		{% endif %}
	</div>
	<div class="ProductCard-mainContent">
		<a class="ProductCard-imgLink" href="{{ this.product.publicUrl }}">
			{{ getImages({
				source_type: 'product',
				img_id: this.imageId,
				filters: 'product_card',
				limit: 1,
				alt: this.product.title,
				wrapper: 'figure',
				wrapper_attrs: {class: 'ProductCard-img'},
				img_attrs: {
					loading: 'lazy',
				},
				placeholder: asset('images/placeholder2.webp'),
			})|raw }}
		</a>
		<div class="ProductCard-desc">
			<a href="{{ this.product.publicUrl }}" class="ProductCard-title">{{ this.product.title }}</a>

			{% if this.product.chapo %}
				{# Editorial html, sanitized by the core on save, like the category description #}
				<div class="ProductCard-subtitle">{{ this.product.chapo|raw }}</div>
			{% endif %}

			<div class="ProductCard-footer">
				{# Same rule as the rating component itself, so the column it lives in is not
				   rendered empty for a product that has neither review nor colour variant. #}
				{% set hasRating = this.rate is not null and this.reviewCount > 0 %}
				{% if hasRating or this.product.colors|length > 0 %}
					<div class="ProductCard-footerLeft">
						<twig:Molecules:Rating:Base :average="this.rate" :count="this.reviewCount" />
						{% if this.product.colors|length > 0 %}
							<div class="Colors">
								{% set limit = 6 %}
								{% for color in this.product.colors %}
									{% if loop.index0 < limit %}
										<a href="#" class="Colors-item" style="background-color:{{ color }}"></a>
									{% else %}
										<div class="Colors-others">...</div>
									{% endif %}
								{% endfor %}
							</div>
						{% endif %}
					</div>
				{% endif %}
				{# A price keeps its own order, so it carries dir="ltr" — on the inline span only.
				   On the block it would re-resolve the block's own text-align: start and pin the
				   figure to the left of a right-to-left card while the title stays on the right. #}
				{# The mention follows every figure: the price a buyer reads is with or without the taxes
				   according to its group, and the card says which. #}
				<twig:Molecules:PriceBlock:Base
					variant="card"
					class="ProductCard-footerRight"
					:mode="this.priceDisplayMode"
					:price="this.shownPrice"
					:originalPrice="this.struckPrice"
					:purchasable="this.purchasable"
					:reference="this.reference"
					:productReference="this.product.ref"
				/>
			</div>
			{# The price per litre, per kilogram, of the price shown above: only for a sale element that
			   says what one unit sold contains. #}
			{% set shownPrice = this.isPromo ? this.displayedPromoPrice : this.displayedPrice %}
			{% set referencePrice = shownPrice ? reference_unit_price(shownPrice.amount, this.quantityRule) : null %}
			{% if referencePrice %}
				<p class="ProductCard-referencePrice paragraph-6 text-grey">{{ 'reference_unit_price'|trans({'%price%': referencePrice.price|format_currency(current_currency_code(), locale: lang_code), '%unit%': referencePrice.per}) }}</p>
			{% endif %}
			{% if this.runningSaleTag and this.runningSaleTag.shouldDisplayCountdown and this.runningSaleTag.countdownRemainingSeconds is not null %}
				<twig:Molecules:Countdown:Base :remainingSeconds="this.runningSaleTag.countdownRemainingSeconds" size="sm" class="ProductCard-countdown" />
			{% endif %}

			{# Public extension point: a module adds a control under the price (wish list, compare...).
			   Rendered once per card, so an answer must not cost a query per product. Outside the
			   two links, so a button it adds does not nest inside an anchor. #}
			{{ theme_hook('product-card.bottom', {productId: this.product.id}) }}
		</div>
	</div>
</div>
