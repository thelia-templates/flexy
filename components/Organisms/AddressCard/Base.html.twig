{# @prop title string Optional card title (falls back to the address label) #}
{# @prop disabled bool Disables the action buttons #}
{% props title = '', disabled = false %}
{% set address = this.address %}
<div
    class="{{ ('AddressCard ' ~ (this.checked ? 'selected ' : '') ~ attributes.render('class'))|tailwind_merge }}"
    {{ attributes.defaults(this.withModal ? stimulus_controller('Organisms--AddressCard--base') : {}).without('class') }}
>
    <div class="AddressCard-top">
        {% block header %}
            {% if not this.inOrder %}
                <twig:Molecules:Favorite:Base
                    text="{{ 'Favourite'|trans }}"
                    :selected="address.isDefault ? true : false"
                    confirmUrl="{{ path('account_address_default', {addressId: this.addressId}) }}"
                />
            {% endif %}
        {% endblock %}
    </div>

    <label class="AddressCard-content">
        {% block form %}{% endblock %}

        {% block infos %}
            {% if title %}
                {% set cardTitle = title %}
                {% set name = address.label ?: (address.firstname ~ ' ' ~ address.lastname) %}
            {% else %}
                {% set cardTitle = address.label %}
                {% set name = address.firstname ~ ' ' ~ address.lastname %}
            {% endif %}
            <span>
                <span class="AddressCard-title">{{ cardTitle }}</span>
                {# Customer-entered, so the direction of each value follows its own content:
                   a Latin street line keeps "10 rue du Tunnel" in order inside a right-to-left
                   card, an Arabic one still reads right to left. #}
                <span class="AddressCard-name"><bdi>{{ name }}</bdi></span>
                {% if address.company %}
                    <span class="AddressCard-company">
                        <span class="block"><bdi>{{ address.company }}</bdi></span>
                        {% if address.siret %}
                            <span class="block">{{ 'Company registration number'|trans }} : <span dir="ltr">{{ address.siret }}</span></span>
                        {% endif %}
                        {% if address.vatNumber %}
                            <span class="block">{{ 'VAT number'|trans }} : <span dir="ltr">{{ address.vatNumber }}</span></span>
                        {% endif %}
                    </span>
                {% endif %}
                <span class="AddressCard-address">
                    <span class="block">
                        <bdi>{{ [address.address1, address.address2 ?? '', address.address3 ?? '']|filter(i => i)|join(', ') }}</bdi>
                    </span>
                    <span class="block">
                        <bdi>{{ [address.zipcode, address.city ?? '', this.countryIsoAlpha3 ?? '']|filter(i => i)|join(', ') }}</bdi>
                    </span>
                    <span class="AddressCard-phone" dir="ltr">{{ address.phone }}</span>
                </span>
            </span>
        {% endblock %}
    </label>

    {% if not this.inOrder %}
        <div class="AddressCard-actions">
            {% block bottom %}
                <a {% if disabled %}disabled{% endif %} href="{{ path('account_address', {addressId: this.addressId}) }}">
                    <span>{{ ux_icon('edit') }}</span>
                    {{ 'Modify'|trans }}
                </a>

                {% if not address.isDefault %}
                    <button
                        type="button"
                        {% if disabled %}disabled{% endif %}
                        {{ stimulus_action('Organisms--AddressCard--base', 'openModal', 'click') }}
                        data-modal="confirmDeleteAddress"
                        data-confirm="{{ path('account_address_delete', {addressId: this.addressId}) }}"
                    >
                        <span>{{ ux_icon('delete') }}</span>
                        {{ 'Delete'|trans }}
                    </button>
                {% endif %}
            {% endblock %}
        </div>
    {% endif %}
</div>
