{# @prop media array List of {type, id, pseIds, alt} — plus {provider, embedUrl, fileUrl, thumbnailImageId} on a video. pseIds lists the PSEs a visual illustrates, empty for a product-level one #}
{# @prop currentPseId int|null Selected PSE, used to seed the active thumbnail and slide #}
{# @prop tags array Badges overlaid on the visual: [{text, color}], color being a Molecules/Tag one #}
{% props media = [], currentPseId = null, tags = [] %}

{% set galleryController = 'Organisms--ProductGallery--base' %}
{% set placeholder = asset('images/placeholder2.webp') %}

<div
    class="{{ ('ProductGallery ' ~ attributes.render('class'))|tailwind_merge }}"
    {{ attributes.defaults({
        ...stimulus_controller(galleryController, {currentPseId: currentPseId}),
    }).without('class') }}
>
    {# Rendered even with nothing in it: morphing pairs children by position, and dropping this
       element would shift that pairing onto the two ignored siblings below. #}
    <div class="ProductGallery-tags">
        {% for tag in tags %}
            <twig:Molecules:Tag:Base customText="{{ tag.text }}" color="{{ tag.color }}" />
        {% endfor %}
    </div>

    {# data-live-ignore on the rail and on the slider rather than on the gallery as a whole, so the
       tags above stay in sync with the current PSE. Both siblings hold client state a morph would
       wipe: the active thumbnail, owned by the controller, Splide's clones and inline styles, and
       the player a shopper started — see Organisms/VideoPlayer.
       Live actions inside still fire — data-live-ignore only opts out of DOM morphing. #}
    <div class="ProductGallery-list" data-live-ignore {{ stimulus_target(galleryController, 'thumblist') }}>
        <ul>
            {% for item in media %}
                {% set pseIds = item.pseIds|default([])|join(',') %}
                {# A visual with no PSE of its own stays accurate whichever variant is selected:
                   the controller falls back to it, and recognises it by this extra target name. #}
                {% set thumbnailTargets = pseIds ? 'thumbnail' : 'thumbnail productImg' %}
                {# The button is named whatever its visual carries: a decorative image has an empty
                   alt on purpose, and without this the button would have no name at all. #}
                {% if item.type == 'video' %}
                    {% set thumbnailLabel = item.alt ?: 'Play video'|trans %}
                {% else %}
                    {% set thumbnailLabel = item.alt ?: 'Show visual %number%'|trans({'%number%': loop.index}) %}
                {% endif %}
                {# The active thumbnail is not marked server-side: the controller owns it, so a live
                   re-render can't reset it to the first image while another PSE is selected.
                   The click action sits on the list item because the button's own data-action is
                   already taken by live_action() below — an element carries only one. The event has
                   to be spelled out: Stimulus only infers a default event for a handful of tags
                   (a, button, form, input…), and silently binds nothing on an <li>. #}
                <li
                    class="ProductGallery-item"
                    {{ stimulus_target(galleryController, 'item') }}
                    {{ stimulus_action(galleryController, 'select', 'click') }}
                >
                    <button
                        type="button"
                        {{ stimulus_target(galleryController, thumbnailTargets) }}
                        {% if pseIds %}
                            {{ live_action('updateCurrentPseFromId', {pseIds: pseIds}) }}
                            data-pse-id="{{ pseIds }}"
                        {% endif %}
                        data-index="{{ loop.index0 }}"
                        aria-label="{{ thumbnailLabel }}"
                    >
                        {% if item.type == 'video' %}
                            {# The poster carries no alternative text of its own: the button it sits
                               in is already named, and repeating it would read the video twice. #}
                            <span class="ProductGallery-videoThumbnail">
                                {{ media_image(
                                    {img_id: item.thumbnailImageId, source_type: 'product', filters: 'product_gallery_thumbnail', placeholder: placeholder},
                                    {alt: '', class: 'ProductGallery-thumbnail', loading: 'lazy'}
                                ) }}
                                <span class="ProductGallery-videoBadge" aria-hidden="true">{{ ux_icon('play') }}</span>
                            </span>
                        {% else %}
                            {{ media_image(
                                {img_id: item.id, source_type: 'product', filters: 'product_gallery_thumbnail', placeholder: placeholder},
                                {alt: item.alt, class: 'ProductGallery-thumbnail', loading: 'lazy'}
                            ) }}
                        {% endif %}
                    </button>
                </li>
            {% endfor %}
        </ul>
    </div>

    <div class="ProductGallery-main" data-live-ignore>
        <section class="splide" aria-label="{{ 'Product visuals'|trans }}" {{ stimulus_target(galleryController, 'slider') }}>
            <div class="splide__track">
                <ul class="splide__list">
                    {% for item in media %}
                        <li
                            class="splide__slide"
                            {{ stimulus_target(galleryController, 'slide') }}
                            data-pse-ids="{{ item.pseIds|default([])|join(',') }}"
                        >
                            {% if item.type == 'video' %}
                                <twig:Organisms:VideoPlayer:Base
                                    :alt="item.alt"
                                    :provider="item.provider|default(null)"
                                    :embedUrl="item.embedUrl|default(null)"
                                    :fileUrl="item.fileUrl|default(null)"
                                    :thumbnailImageId="item.thumbnailImageId|default(null)"
                                />
                            {% else %}
                                {{ media_image(
                                    {img_id: item.id, source_type: 'product', filters: 'product_gallery', placeholder: placeholder},
                                    {alt: item.alt, loading: 'lazy', 'data-image-id': item.id}
                                ) }}
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            </div>

            {% if media|length > 1 %}
                <div class="splide__arrows">
                    <button class="splide__arrow splide__arrow--prev" aria-label="{{ 'Previous visual'|trans }}">
                        {{ ux_icon('arrow-left') }}
                    </button>
                    <button class="splide__arrow splide__arrow--next" aria-label="{{ 'Next visual'|trans }}">
                        {{ ux_icon('arrow-right') }}
                    </button>
                </div>
            {% endif %}
        </section>
    </div>
</div>
