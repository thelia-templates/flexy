<div class='flex-1' {{ attributes }}>
	{% set addressId = create ? null : update %}
	{% set key =  create ? 'create' : 'update_' ~ update %}
	<div class={{ (update or create) ? '' : 'hidden' }}>
		{{ component('Flexy:Organisms:Modules:AddressesForm', {addressId:addressId, key: key }) }}
	</div>
	<div class={{ (update or create) ? 'hidden' : '' }}>
		{% if addresses|length <= 0 %}
			<div class="flex flex-col items-start">
				<span class="HomeDelivery-noAddress">
					{{ 'You have no registered address' |trans }}:
				</span>

				{% include '@components/Molecules/Button/Button.html.twig' with {text: 'Add an address'|trans, classes:'mt-4'} %}
			</div>
		{% else %}
			<div>
				<ul class='flex flex-col gap-2'>
					{% for address in addresses %}
						<li>
							{% include '@components/Organisms/Card/Address/AddressCardCheckout.html.twig' with { address, selected:deliveryAddressId == address.id , isDefault:address.isDefault, model: 'deliveryAddressId'} %}
							{% if deliveryAddressId == address.id %}

								<div class='my-4'>
									{% include '@components/Atoms/Form/Checkbox.html.twig' with { label: "Use this address for billing"|trans, checked : invoiceAddressId == address.id,value: address.id, model: "invoiceAddressId" } %}
								</div>
							{% endif %}
						</li>
					{% endfor %}
				</ul>

				<div class='flex flex-col gap-2 mt-4 lg:flex-row lg:items-center'>
					{% include '@components/Molecules/Button/Button.html.twig' with {text: 'Choose this address'|trans, classes:'Button--fill lg:w-1/2', disabled : not deliveryAddressId ,liveEvent: 'showDeliveryModuleView'} %}
					{% include '@components/Molecules/Button/Button.html.twig' with {text: 'Use another address'|trans, classes:'Button--secondary lg:w-1/2', liveAction: 'newAddress'} %}
				</div>
			</div>
		{% endif %}
	</div>
</div>
