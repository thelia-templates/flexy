{% set order = this.order %}

<div class="{{ ('Summary ' ~ attributes.render('class'))|tailwind_merge }}" {{ attributes.without('class') }}>
    <div class="Summary-list">
        <div class="Summary-line">
            <div>{{ 'Subtotal without taxes'|trans }}</div>
            <div><span dir="ltr">{{ order.totalAmountWithoutTaxes|format_currency('EUR', locale: lang_code) }}</span></div>
        </div>

        {% if this.hasShipping %}
            <div class="Summary-line">
                <div>{{ 'Delivery'|trans }}</div>
                <div><span dir="ltr">{{ order.totalShippingWithTaxes|format_currency('EUR', locale: lang_code) }}</span></div>
            </div>
        {% endif %}

        {% if this.hasDiscount %}
            <div class="Summary-line">
                <div>{{ 'Discount'|trans }}</div>
                <div><span dir="ltr">&minus;{{ order.amountDiscountWithTaxes|format_currency('EUR', locale: lang_code) }}</span></div>
            </div>
        {% endif %}

        <div class="Summary-line">
            <div>{{ 'Number of articles'|trans }}</div>
            <div>{{ this.itemCount }}</div>
        </div>
    </div>

    <div class="Summary-footer">
        <div class="Summary-total">
            <div>{{ (this.hasTax ? 'Total (including VAT)' : 'Total')|trans }}</div>
            <div><span dir="ltr">{{ order.totalAmount|format_currency('EUR', locale: lang_code) }}</span></div>
        </div>
        {% if this.hasTax %}
            <div class="italic">
                {{ 'Taxes of'|trans }}
                <span dir="ltr">{{ this.taxAmount|format_currency('EUR', locale: lang_code) }}</span>
                {{ 'included'|trans }}
            </div>
        {% endif %}
    </div>
</div>
