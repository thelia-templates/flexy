{% set order = this.order %}

<div class="{{ ('Summary ' ~ attributes.render('class'))|tailwind_merge }}" {{ attributes.without('class') }}>
    <div class="Summary-list">
        <div class="Summary-line">
            <div>{{ 'Subtotal without taxes'|trans }}</div>
            <div>{{ order.totalAmountWithoutTaxes|format_currency('EUR', locale: lang_code) }}</div>
        </div>

        {% if this.hasShipping %}
            <div class="Summary-line">
                <div>{{ 'Delivery'|trans }}</div>
                <div>{{ order.totalShippingWithTaxes|format_currency('EUR', locale: lang_code) }}</div>
            </div>
        {% endif %}

        {% if this.hasDiscount %}
            <div class="Summary-line">
                <div>{{ 'Discount'|trans }}</div>
                <div>&minus;{{ order.amountDiscountWithTaxes|format_currency('EUR', locale: lang_code) }}</div>
            </div>
        {% endif %}

        <div class="Summary-line">
            <div>{{ 'Number of articles'|trans }}</div>
            <div>{{ this.itemCount }}</div>
        </div>
    </div>

    <div class="Summary-footer">
        <div class="Summary-total">
            <div>{{ (this.hasTax ? 'Total (including VAT)' : 'Total')|trans }}</div>
            <div>{{ order.totalAmount|format_currency('EUR', locale: lang_code) }}</div>
        </div>
        {% if this.isVatExempted %}
            <div class="italic">
                {{ 'VAT exempted (reverse charge), buyer VAT number %number%'|trans({'%number%': this.invoiceVatNumber}) }}
            </div>
        {% elseif this.hasTax %}
            <div class="italic">
                {{ 'Taxes of'|trans }}
                {{ this.taxAmount|format_currency('EUR', locale: lang_code) }}
                {{ 'included'|trans }}
            </div>
        {% endif %}
    </div>
</div>
