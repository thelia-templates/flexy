{# A buyer whose VAT is exempted (reverse charge) pays no tax: a figure is not said to be with or without it, the notice below says why. #}
{% set vatExempted = this.isVatExempted %}
<div class="{{ ('Summary ' ~ attributes.render('class'))|tailwind_merge }}" {{ attributes.without('class') }}>
    <div class="Summary-list">
        <div class="Summary-line">
            {# The goods are published untaxed whatever the display, and the mention says so: a buyer
               shown prices with their taxes reads it as the base of the taxes below. #}
            <div>{{ 'Subtotal'|trans }}</div>
            <div><span dir="ltr">{{ this.subtotal.amount|format_currency(this.currencyCode, locale: lang_code) }}</span>{% if not vatExempted %}<twig:Atoms:TaxMention:Base :display="this.subtotal.display" />{% endif %}</div>
        </div>

        {% if this.hasShipping %}
            <div class="Summary-line">
                <div>{{ 'Delivery'|trans }}</div>
                <div><span dir="ltr">{{ this.shipping.amount|format_currency(this.currencyCode, locale: lang_code) }}</span>{% if not vatExempted %}<twig:Atoms:TaxMention:Base :display="this.shipping.display" />{% endif %}</div>
            </div>
        {% endif %}

        {% for service in this.services %}
            <div class="Summary-line" data-summary-service>
                <div>{{ service.title }}</div>
                <div>
                    {% if service.price.amount %}
                        <span dir="ltr">{{ service.price.amount|format_currency(this.currencyCode, locale: lang_code) }}</span>{% if not vatExempted %}<twig:Atoms:TaxMention:Base :display="service.price.display" />{% endif %}
                    {% else %}
                        {{ 'Free'|trans }}
                    {% endif %}
                </div>
            </div>
        {% endfor %}

        {% if this.hasDiscount %}
            <div class="Summary-line">
                <div>{{ 'Discount'|trans }}</div>
                <div><span dir="ltr">&minus;{{ this.discount.amount|format_currency(this.currencyCode, locale: lang_code) }}</span>{% if not vatExempted %}<twig:Atoms:TaxMention:Base :display="this.discount.display" />{% endif %}</div>
            </div>
        {% endif %}

        <div class="Summary-line">
            <div>{{ 'Number of articles'|trans }}</div>
            <div>{{ this.itemCount }}</div>
        </div>

        {# Read untaxed, the order states what it comes to before its taxes, the taxes, then what is paid. #}
        {% if not this.display.isTaxed %}
            <div class="Summary-line">
                <div>{{ 'Total excl. tax'|trans }}</div>
                <div><span dir="ltr">{{ this.totalWithoutTaxes.amount|format_currency(this.currencyCode, locale: lang_code) }}</span></div>
            </div>
            <div class="Summary-line">
                <div>{{ 'VAT'|trans }}</div>
                <div><span dir="ltr">{{ this.taxAmount|format_currency(this.currencyCode, locale: lang_code) }}</span></div>
            </div>
        {% endif %}
    </div>

    <div class="Summary-footer">
        <div class="Summary-total">
            {% if this.display.isTaxed %}
                <div>{{ 'Total'|trans }}</div>
                <div><span dir="ltr">{{ this.total.amount|format_currency(this.currencyCode, locale: lang_code) }}</span>{% if not vatExempted %}<twig:Atoms:TaxMention:Base :display="this.total.display" />{% endif %}</div>
            {% else %}
                <div>{{ 'Total incl. tax to pay'|trans }}</div>
                <div><span dir="ltr">{{ this.totalToPay.amount|format_currency(this.currencyCode, locale: lang_code) }}</span></div>
            {% endif %}
        </div>
        {% if vatExempted %}
            <div class="italic">
                {{ 'VAT exempted (reverse charge), buyer VAT number %number%'|trans({'%number%': this.invoiceVatNumber}) }}
            </div>
        {% elseif this.hasTax %}
            <div class="italic">
                {{ 'Taxes of'|trans }}
                <span dir="ltr">{{ this.taxAmount|format_currency(this.currencyCode, locale: lang_code) }}</span>
                {{ 'included'|trans }}
            </div>
        {% endif %}
    </div>
</div>
