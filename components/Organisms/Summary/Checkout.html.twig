<div {{ attributes.defaults(stimulus_controller('live-refresh-on-focus')) }}>
    {# A buyer whose VAT is exempted (reverse charge) pays no tax: a figure is not said to be with or without it, the notice below says why. #}
    {% set vatExempted = this.isVatExempted %}
    {% set summary = this.summary %}
    {% set coupons = summary.coupons ?? [] %}
    {% set discounts = summary.discounts %}

    <div class="Summary">
        {% if this.showPromoCodeForm %}
            <div class="mb-4">
                <twig:Forms:PromoCode:Base />
            </div>
        {% endif %}

        <div class="Summary-list">
            <div class="Summary-line">
                <div>
                    {{ 'Subtotal'|trans }}
                    <span class="font-normal paragraph-6">
                        <bdi>({{ summary.item_count }} {{ (summary.item_count > 1 ? 'items' : 'item')|trans }})</bdi>
                    </span>
                </div>
                <div>
                    <span dir="ltr">{{ summary.subtotal.amount|format_currency(current_currency_code(), locale: lang_code) }}</span>{% if not vatExempted %}<twig:Atoms:TaxMention:Base :display="summary.subtotal.display" />{% endif %}
                </div>
            </div>
            {# No postage to show until a carrier is chosen: 0 is only a free delivery once one is. #}
            {% if summary.delivery_module_id %}
                <div class="Summary-line">
                    <div>{{ 'Delivery'|trans }}</div>
                    <div>
                        {% if summary.postage.amount %}
                            <span dir="ltr">{{ summary.postage.amount|format_currency(current_currency_code(), locale: lang_code) }}</span>{% if not vatExempted %}<twig:Atoms:TaxMention:Base :display="summary.postage.display" />{% endif %}
                        {% else %}
                            {{ 'Free delivery'|trans }}
                        {% endif %}
                    </div>
                </div>
            {% endif %}
            {% if summary.delivery_date %}
                <div class="Summary-line" data-testid="summary-delivery-date">
                    <div>{{ 'Delivery date'|trans }}</div>
                    <div class="text-end">
                        {{ summary.delivery_date.date|format_date('medium') }}
                        {% if summary.delivery_date.start %}
                            <br><span dir="ltr">{{ 'from %start% to %end%'|trans({'%start%': summary.delivery_date.start, '%end%': summary.delivery_date.end}) }}</span>
                        {% endif %}
                    </div>
                </div>
            {% endif %}
            {# After the delivery, before the promotions: the order of a bill — what is
               bought, what it costs to send, what is added to it, then what comes off. #}
            {% if this.hasGiftWrapping %}
                <div class="Summary-line" data-summary-gift-wrapping>
                    <div>{{ summary.gift_wrapping_title }}</div>
                    <div>
                        {% if summary.gift_wrapping_price.amount %}
                            <span dir="ltr">{{ summary.gift_wrapping_price.amount|format_currency(current_currency_code(), locale: lang_code) }}</span>{% if not vatExempted %}<twig:Atoms:TaxMention:Base :display="summary.gift_wrapping_price.display" />{% endif %}
                        {% else %}
                            {{ 'Free'|trans }}
                        {% endif %}
                    </div>
                </div>
            {% endif %}
            {% if coupons|length %}
                <div class="Summary-line flex-wrap">
                    <div>{{ 'Promo Code'|trans }}</div>
                    <ul class="flex gap-1 flex-wrap">
                        {% for coupon in coupons %}
                            <li>
                                <button type="button" class="FilterPill" data-action="live#emit" data-live-event-param="removeCoupon" data-live-code-param="{{ coupon }}">
                                    <span>{{ coupon }}</span>
                                    <span class="FilterPill-iconClose">{{ ux_icon('close') }}</span>
                                </button>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}
            {# Named lines when the core publishes them, the single global line otherwise:
               the theme has to render against both, the core and the theme ship apart. #}
            {% if discounts|length %}
                {% for discount in discounts %}
                    <div class="Summary-line Summary-discountLine" data-summary-discount-label="{{ discount.label }}">
                        <div>{{ discount.label ?: 'Discount'|trans }}</div>
                        <div><span dir="ltr">&minus;{{ discount.displayed.amount|format_currency(current_currency_code(), locale: lang_code) }}</span>{% if not vatExempted %}<twig:Atoms:TaxMention:Base :display="discount.displayed.display" />{% endif %}</div>
                    </div>
                {% endfor %}
            {% elseif this.hasDiscount %}
                <div class="Summary-line">
                    <div>{{ 'Discount'|trans }}</div>
                    <div><span dir="ltr">&minus;{{ summary.discount_price.amount|format_currency(current_currency_code(), locale: lang_code) }}</span>{% if not vatExempted %}<twig:Atoms:TaxMention:Base :display="summary.discount_price.display" />{% endif %}</div>
                </div>
            {% endif %}
            {# Read untaxed, the cart states what it comes to before its taxes, the taxes, then what is paid. #}
            {% if not summary.display.isTaxed %}
                <div class="Summary-line" data-summary-total-without-taxes>
                    <div>{{ 'Total excl. tax'|trans }}</div>
                    <div><span dir="ltr">{{ summary.total_without_taxes.amount|format_currency(current_currency_code(), locale: lang_code) }}</span></div>
                </div>
                <div class="Summary-line" data-summary-tax-amount>
                    <div>{{ 'VAT'|trans }}</div>
                    <div><span dir="ltr">{{ summary.total_tax_amount|format_currency(current_currency_code(), locale: lang_code) }}</span></div>
                </div>
            {% endif %}
        </div>

        <div class="Summary-footer">
            <div class="Summary-total">
                {% if summary.display.isTaxed %}
                    <div>
                        {{ 'Total'|trans }}
                    </div>
                    <div>
                        <span dir="ltr">{{ summary.total.amount|format_currency(current_currency_code(), locale: lang_code) }}</span>{% if not vatExempted %}<twig:Atoms:TaxMention:Base :display="summary.total.display" />{% endif %}
                    </div>
                {% else %}
                    <div>
                        {{ 'Total incl. tax to pay'|trans }}
                    </div>
                    <div>
                        <span dir="ltr">{{ summary.total_to_pay.amount|format_currency(current_currency_code(), locale: lang_code) }}</span>
                    </div>
                {% endif %}
            </div>
            {% if vatExempted %}
                <div class="italic">
                    {{ 'VAT exempted (reverse charge), buyer VAT number %number%'|trans({'%number%': summary.invoice_vat_number}) }}
                </div>
            {% elseif summary.display.isTaxed and this.hasTax %}
                <div class="italic">
                    {{ 'Taxes of'|trans }}
                    <span dir="ltr">{{ summary.total_tax_amount|format_currency(current_currency_code(), locale: lang_code) }}</span>
                    {{ 'included'|trans }}
                </div>
            {% endif %}
            {% if summary.vat_exemption_state == 'verification_expired' %}
                <div class="italic">
                    {{ 'The verification of VAT number %number% has expired: the order is no longer exempted from VAT.'|trans({'%number%': summary.invoice_vat_number}) }}
                </div>
            {% elseif summary.vat_exemption_state == 'not_verified' %}
                <div class="italic">
                    {{ 'VAT number %number% is not verified: the order is not exempted from VAT.'|trans({'%number%': summary.invoice_vat_number}) }}
                </div>
            {% endif %}
            {# Under the total, once every discount is taken off: a module paying part of the order
               another way (a gift card, a store credit) adds its form here, and the lines that
               say what it pays and what is left to pay. #}
            {{ theme_hook('checkout.summary.bottom', {summary: summary}) }}
        </div>
    </div>
</div>
