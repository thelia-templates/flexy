{# @prop showPromoCodeForm bool Renders the coupon form above the totals #}
{% props showPromoCodeForm = true %}
<div {{ attributes.defaults(stimulus_controller('live-refresh-on-focus')) }}>
    {% set summary = this.summary %}
    {% set coupons = summary.coupons ?? [] %}
    {% set discounts = summary.discounts %}

    <div class="Summary">
        {% if showPromoCodeForm %}
            <div class="mb-4">
                <twig:Forms:PromoCode:Base />
            </div>
        {% endif %}

        <div class="Summary-list">
            <div class="Summary-line">
                <div>
                    {{ 'Subtotal'|trans }}
                    <span class="font-normal paragraph-6">
                        <bdi>({{ summary.item_count }} {{ (summary.item_count > 1 ? 'items' : 'item')|trans }})</bdi>
                    </span>
                </div>
                <div>
                    <span dir="ltr">{{ summary.raw_taxed_total_price|format_currency('EUR', locale: lang_code) }}</span>
                </div>
            </div>
            <div class="Summary-line">
                <div>{{ 'Delivery'|trans }}</div>
                <div>
                    {% if summary.taxed_postage %}
                        <span dir="ltr">{{ summary.taxed_postage|format_currency('EUR', locale: lang_code) }}</span>
                    {% else %}
                        {{ 'Free delivery'|trans }}
                    {% endif %}
                </div>
            </div>
            {% if coupons|length %}
                <div class="Summary-line flex-wrap">
                    <div>{{ 'Promo Code'|trans }}</div>
                    <ul class="flex gap-1 flex-wrap">
                        {% for coupon in coupons %}
                            <li>
                                <button type="button" class="FilterPill" data-action="live#emit" data-live-event-param="removeCoupon" data-live-code-param="{{ coupon }}">
                                    <span>{{ coupon }}</span>
                                    <span class="FilterPill-iconClose">{{ ux_icon('close') }}</span>
                                </button>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}
            {# Named lines when the core publishes them, the single global line otherwise:
               the theme has to render against both, the core and the theme ship apart. #}
            {% if discounts|length %}
                {% for discount in discounts %}
                    <div class="Summary-line Summary-discountLine" data-summary-discount-label="{{ discount.label }}">
                        <div>{{ discount.label ?: 'Discount'|trans }}</div>
                        <div><span dir="ltr">&minus;{{ discount.taxed_amount|format_currency('EUR', locale: lang_code) }}</span></div>
                    </div>
                {% endfor %}
            {% elseif this.hasDiscount %}
                <div class="Summary-line">
                    <div>{{ 'Discount'|trans }}</div>
                    <div><span dir="ltr">&minus;{{ summary.taxed_discount|format_currency('EUR', locale: lang_code) }}</span></div>
                </div>
            {% endif %}
        </div>

        <div class="Summary-footer">
            <div class="Summary-total">
                <div>
                    {{ (this.hasTax ? 'Total (including VAT)' : 'Total')|trans }}
                </div>
                <div>
                    <span dir="ltr">{{ summary.total_taxed_price|format_currency('EUR', locale: lang_code) }}</span>
                </div>
            </div>
            {% if this.hasTax %}
                <div class="italic">
                    {{ 'Taxes of'|trans }}
                    <span dir="ltr">{{ summary.total_tax_amount|format_currency('EUR', locale: lang_code) }}</span>
                    {{ 'included'|trans }}
                </div>
            {% endif %}
        </div>
    </div>
</div>
