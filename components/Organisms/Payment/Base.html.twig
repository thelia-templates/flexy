<div {{ attributes.defaults(stimulus_controller('live-refresh-on-focus')) }} data-loading="addClass(opacity-50 pointer-events-none)">
    {% if this.stockRefusal %}
        {# SnackBar prints its text raw: the sentence carries the reference of a product, which is the merchant's. #}
        <twig:Molecules:SnackBar:Base variant="error" withIcon role="alert" class="mb-5" text="{{ this.stockRefusal|escape('html') }}" data-testid="checkout-stock-refusal" />
    {% endif %}
    <{{ this.headingLevel }} class="text-black h4">
        {{ 'Choose a payment method'|trans }}
    </{{ this.headingLevel }}>
    {% set parts = this.parts %}

    {% if this.notice == 'stored_method_refused' %}
        <twig:Molecules:SnackBar:Base
            variant="warning"
            withIcon
            role="alert"
            class="my-5"
            text="{{ 'This saved payment method can no longer be used: choose another or pay with a new one.'|trans|escape('html') }}"
        />
    {% endif %}

    {# The means that pay part of the order inside the shop (a gift card, a credit note, a
       wallet). Each module applies its own part, from the point it draws here; the amounts
       and what is left are the core's composition of the payment, not a sum made here. #}
    {% if parts.parts|length %}
        <section class="my-5" aria-labelledby="payment-parts-title">
            <{{ this.partsHeadingLevel }} id="payment-parts-title" class="text-black h4">
                {{ 'Pay part of your order with'|trans }}
            </{{ this.partsHeadingLevel }}>
            <ul class="flex flex-col gap-3.5 my-5">
                {% for part in parts.parts %}
                    <li class="PaymentCard">
                        <span class="PaymentCard-title">{{ part.title }}</span>
                        {% if part.amount|number_format(2) != '0.00' %}
                            <span dir="ltr">&minus;{{ part.amount|format_currency('EUR', locale: lang_code) }}</span>
                        {% endif %}
                        {{ theme_hook('checkout.payment.parts', {
                            module: part.moduleId,
                            amount: part.amount,
                        }) }}
                    </li>
                {% endfor %}
            </ul>

            {% if parts.coversTheOrder %}
                <twig:Molecules:SnackBar:Base
                    variant="success"
                    withIcon
                    text="{{ 'Nothing is left to pay: your order is paid in full with the means above.'|trans|escape('html') }}"
                />
            {% elseif parts.balance is not null %}
                <p class="paragraph-3 text-black">
                    {{ 'Left to pay'|trans }}
                    <strong dir="ltr">{{ parts.balance|format_currency('EUR', locale: lang_code) }}</strong>
                </p>
            {% elseif this.noProviderCanChargeTheBalance %}
                <twig:Molecules:SnackBar:Base
                    variant="warning"
                    withIcon
                    role="alert"
                    text="{{ 'This means cannot be combined with another payment method: remove the part or cover the whole total.'|trans|escape('html') }}"
                />
            {% elseif parts.refusal == 'provider-cannot-charge-balance' %}
                <twig:Molecules:SnackBar:Base
                    variant="warning"
                    withIcon
                    role="alert"
                    text="{{ 'The payment method you chose cannot be combined with another payment means: choose another one.'|trans|escape('html') }}"
                />
            {% elseif parts.refusal %}
                <twig:Molecules:SnackBar:Base
                    variant="warning"
                    withIcon
                    text="{{ 'Choose how to pay the rest of your order.'|trans|escape('html') }}"
                />
            {% endif %}
        </section>
    {% endif %}

    {% if not parts.coversTheOrder %}
        <ul class="flex flex-col gap-3.5 my-5">
            {% for module in this.providers %}
                <li>
                    <twig:Organisms:PaymentCard:Base :module="module" :optionChoices="this.paymentOptionChoices" :storedMethodId="this.storedMethodId" />
                </li>
            {% endfor %}
        </ul>
    {% endif %}
    <twig:Organisms:Invoice:Base />

    {# On this step and not on the delivery one: the wrapping is charged, so the buyer picks
       it where they can see what it adds to the total they are about to pay. Rendered from
       inside this organism rather than from the payment page, so the one-screen layout —
       which stacks step components and has no page of its own to hang it on — gets it too. #}
    <twig:Organisms:GiftWrapping:Base :headingLevel="this.headingLevel" />

    {% set consents = this.consents %}
    {% if consents|length %}
        <h2 class="text-black h4">
            {{ 'Before placing your order'|trans }}
        </h2>
        {# Each box carries its own live action instead of a form: the answer is kept by
           the server (session), so the state rendered here is the state the order is
           checked against, and it survives the morph that follows every answer. #}
        <ul class="flex flex-col gap-2 my-5">
            {% for consent in consents %}
                <li>
                    <div class="flex flex-wrap items-center gap-2">
                        {{ component('Fields:Checkbox:Base', {
                            label: consent.title,
                            required: consent.mandatory,
                            'input:id': 'consent-' ~ consent.code,
                            'input:checked': consent.accepted,
                            'input:data-action': 'change->live#action',
                            'input:data-live-action-param': 'toggleConsent',
                            'input:data-live-code-param': consent.code,
                            'input:data-live-accepted-param': consent.accepted ? 'false' : 'true',
                        }|merge(consent.description ? {'input:aria-describedby': 'consent-description-' ~ consent.code} : {})) }}
                        {% if consent.url %}
                            <twig:Molecules:Link:Base
                                size="small"
                                href="{{ consent.url }}"
                                customText="{{ 'Read'|trans }}"
                                aria-label="{{ 'Read %consent%'|trans({'%consent%': consent.title}) }}"
                                target="_blank"
                                rel="noopener"
                            />
                        {% endif %}
                    </div>
                    {% if consent.description %}
                        <p id="consent-description-{{ consent.code }}" class="paragraph-4 text-grey-dark mt-1">
                            {{ consent.description }}
                        </p>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</div>
