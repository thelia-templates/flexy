<div class="Story">

    <div class="Story-section">
        <h4 class="Story-title">Base (plain link, no API call)</h4>
        <div class="HeaderMock">
            <ul class="HeaderMock-list">
                <twig:Organisms:HeaderMenuItem:Base title="New arrivals" href="/new-arrivals" />
                <twig:Organisms:HeaderMenuItem:Base title="Sales" href="/sales" />
            </ul>
        </div>
    </div>

    <div class="Story-section">
        <h4 class="Story-title">CustomFrontMenu (Gestion intégrale du menu depuis le BO)</h4>
        <div class="HeaderMock">
            <ul class="HeaderMock-list">
                <twig:Organisms:HeaderMenuItem:Base
                id="1"
                title="Living Room"
                children="{{[
                    {
                        id: 2,
                        title: 'Couch',
                        href: '#0',
                        children : [
                            {
                                id: 3,
                                title: 'New products',
                                href: '#0',
                            }
                        ]
                    }
                ]}}"
                />
            </ul>
        </div>
    </div>

    <div class="Story-section">
        <h4 class="Story-title">Category — no title/href (auto-resolved from id)</h4>
        <div class="HeaderMock">
            <ul class="HeaderMock-list">
                <twig:Organisms:HeaderMenuItem:Category id="1" />
            </ul>
        </div>
    </div>

    <div class="Story-section">
        <h4 class="Story-title">Folder (mega-menu, subfolders only)</h4>
        <div class="HeaderMock">
            <ul class="HeaderMock-list">
                <twig:Organisms:HeaderMenuItem:Folder id="1" title="Information" href="/information" />
            </ul>
        </div>
    </div>

    <div class="Story-section">
        <h4 class="Story-title">Folder with includeContents (subfolders + contents mixed)</h4>
        <div class="HeaderMock">
            <ul class="HeaderMock-list">
                <twig:Organisms:HeaderMenuItem:Folder id="1" title="Information" href="/information" includeContents="{{ true }}" />
            </ul>
        </div>
    </div>

</div>
