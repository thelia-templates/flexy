{# Must match the controller identifier declared in Layouts/Header/Base.html.twig. #}
{% set headerController = 'Layouts--Header--base' %}

{% set isActive = false %}
{% set hasSubMenu = columns|length or leafLinks|length %}

<li
    class="{{ ('HeaderMenuItem ' ~ attributes.render('class'))|tailwind_merge }}"
    {{ attributes.defaults({...stimulus_controller('Organisms--HeaderMenuItem--base')}).without('class') }}
>
    {% if hasSubMenu %}
        <button
            type="button"
            class="HeaderMenuItem-link{% if isActive %} is-active{% endif %}"
            {{ stimulus_action('Organisms--HeaderMenuItem--base', 'toggle', 'click') }}
            {{ stimulus_target('Organisms--HeaderMenuItem--base', 'toggler') }}
        >
            {{ title }}
        </button>

        <button
            type="button"
            class="HeaderMenuItem-back"
            {{ stimulus_action(headerController, 'displaySubMenu', 'click', {item: menuKey}) }}
            aria-label="{{ 'Open the submenu'|trans }}"
        >
            {{ ux_icon('arrow-right') }}
        </button>

        <ul
            class="Submenu{% if columns is empty %} Submenu--flat{% endif %}"
            data-menu-sub="{{ menuKey }}"
            data-menu-previous="0"
            {{ stimulus_target(headerController, 'sub') }}
        >
            {% if showSeeMore %}
                <li class="HeaderMenuItem-all">
                    <twig:Molecules:Button:Base
                        text="{{ 'See more'|trans }}"
                        href="{{ href }}"
                        class="w-full lg:w-auto mt-4 lg:mt-auto"
                    />
                </li>
            {% endif %}

            {% for column in columns %}
                {# The controller opens the first sub-list carrying the key it is asked for, so each
                   column needs its own: the position is unique within the menu, whose key is unique
                   in the header. #}
                {% set columnKey = menuKey ~ '_' ~ loop.index %}
                <li class="Submenu-column">
                    {% if column.branch.href %}
                        <a href="{{ column.branch.href }}" class="Submenu-heading"{% if column.branch.opensInNewWindow|default(false) %} target="_blank" rel="noopener"{% endif %}>
                            {{ column.branch.title }}
                        </a>
                    {% else %}
                        <span class="Submenu-heading">{{ column.branch.title }}</span>
                    {% endif %}

                    <button
                        type="button"
                        class="HeaderMenuItem-back"
                        {{ stimulus_action(headerController, 'displaySubMenu', 'click', {item: columnKey}) }}
                        aria-label="{{ 'Open the submenu'|trans }}"
                    >
                        {{ ux_icon('arrow-right') }}
                    </button>

                    <ul class="Submenu-sub" data-menu-sub="{{ columnKey }}" data-menu-previous="{{ menuKey }}" {{ stimulus_target(headerController, 'sub') }}>
                        {% for child in column.children %}
                            <li class="Submenu-subItem">
                                {% if child.href %}
                                    <a href="{{ child.href }}" class="Submenu-link"{% if child.opensInNewWindow|default(false) %} target="_blank" rel="noopener"{% endif %}>
                                        {{ child.title }}
                                    </a>
                                {% else %}
                                    <span class="Submenu-link">{{ child.title }}</span>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                </li>
            {% endfor %}

            {% if leafLinks|length %}
                <li class="Submenu-column Submenu-column--links">
                    {% for leaf in leafLinks %}
                        {% if leaf.href %}
                            <a href="{{ leaf.href }}" class="Submenu-link"{% if leaf.opensInNewWindow|default(false) %} target="_blank" rel="noopener"{% endif %}>
                                {{ leaf.title }}
                            </a>
                        {% else %}
                            <span class="Submenu-link">{{ leaf.title }}</span>
                        {% endif %}
                    {% endfor %}
                </li>
            {% endif %}
        </ul>
    {% elseif href %}
        <a
            href="{{ href }}"
            class="HeaderMenuItem-link"
            {% if opensInNewWindow %}target="_blank" rel="noopener"{% endif %}
            {{ stimulus_target('Organisms--HeaderMenuItem--base', 'toggler') }}
        >
            {{ title }}
        </a>
    {% else %}
        <span class="HeaderMenuItem-link">{{ title }}</span>
    {% endif %}
</li>
