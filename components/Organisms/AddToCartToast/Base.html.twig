{# Stays in the DOM, hidden, so the LiveComponent is mounted and able to receive the addToCart
   event emitted by Layouts/ProductDetails. Being present from the start also makes role="status"
   work: the live region is registered before its content changes, which is what gets announced. #}
<div
    class="{{ ('AddToCartToast ' ~ (pseId ? '' : 'hidden') ~ ' ' ~ attributes.render('class'))|tailwind_merge }}"
    role="status"
    {{ attributes.without('class') }}
>
    <button
        type="button"
        class="AddToCartToast-iconClose"
        aria-label="{{ 'Close'|trans }}"
        data-action="live#action"
        data-live-action-param="closeToast"
    >
        {{ ux_icon('close') }}
    </button>

    <p class="AddToCartToast-message">
        {{ 'Your product has been added to the cart'|trans }}
    </p>

    <div class="AddToCartToast-mainContent">
        <a class="AddToCartToast-imgLink" href="{{ productUrl }}">
            {{- getImages({
                source_type: 'product',
                img_id: imageId,
                filters: 'add_to_cart',
                wrapper: 'figure',
                wrapper_attrs: {class: 'AddToCartToast-img'},
                img_attrs: {
                    class: 'mx-auto',
                    loading: 'lazy',
                    width: '360',
                    height: '360',
                },
                placeholder: asset('images/placeholder2.webp'),
            })|raw -}}
        </a>

        <div class="AddToCartToast-desc">
            <a href="{{ productUrl }}" class="AddToCartToast-title">{{ title }}</a>

            <div class="AddToCartToast-infos paragraph-6">
                {% if secondaryTitle %}
                    <span class="AddToCartToast-secondaryTitle">{{ secondaryTitle }}</span>
                {% endif %}
                {% for attribute, value in attributesAv %}
                    <span><bdi>{{ attribute }} : {{ value }}</bdi></span>
                {% endfor %}
                {% if quantity %}
                    <span><bdi>{{ 'Quantity:'|trans }} {{ quantity }}</bdi></span>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="AddToCartToast-bottom">
        <twig:Molecules:Button:Base
            text="{{ 'View my cart'|trans }}"
            href="{{ path('checkout_cart') }}"
        />
        <twig:Molecules:Button:Base
            text="{{ 'Continue shopping'|trans }}"
            color="secondary"
            data-action="live#action"
            data-live-action-param="closeToast"
        />
    </div>
</div>
