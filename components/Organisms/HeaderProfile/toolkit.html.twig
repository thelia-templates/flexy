<div class="Story">
<div class="Story-section">
    <h4 class="Story-title">Base (requires an authenticated front session)</h4>
    {% if getCurrentCustomer() %}
        <div class="Story-bar Story-bar--stretch">
            <twig:Organisms:HeaderProfile:Base />
        </div>
    {% else %}
        <span class="Story-label">
            Log in on the front office to preview this component — it reads the current customer via <code>getCurrentCustomer()</code>.
        </span>
    {% endif %}
</div>
</div>
