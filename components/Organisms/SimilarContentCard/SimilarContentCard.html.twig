{% set classes = classes|default('') %}
{% set title = title|default('') %}
{% set date = date|default('') %}
{% set url = url|default('') %}

<div class="SimilarContentCard {{ classes }}">
    <div class="SimilarContentCard-imgLink">
        {% set product_image_params = {
      source_type: 'content',
      source_id: id,
      filters: 'default',
      wrapper: 'figure',
      wrapper_attrs: {
        class: 'SimilarContentCard-img',
      },
      position: 1,
      img_attrs: {
          loading: 'lazy',
      },
      placeholder: asset('dist/images/placeholder.webp'),
    } %}
        {% set productImage = getImages(product_image_params) %}

        {{ productImage|raw }}
    </div>
    <div class="SimilarContentCard-desc">

        <a href="{{ url|default(publicUrl)|default('#') }}" class="SimilarContentCard-title">{{ title }}</a>

        <div class="SimilarContentCard-footer">
            {{ date|date('d/m/Y') }}
        </div>
    </div>
</div>
