{% set content = resources('/api/front/contents/1') %}

<div class="Story">
<div class="Story-section">
    <h4 class="Story-title">Base</h4>
    <div class="Story-grid Story-grid--2 Story-stage">

        <div class="Story-col">
            <span class="Story-label">real data (content #1 — image falls back to placeholder unless one was added in the BO)</span>
            <twig:Organisms:SimilarContentCard:Base
                id="1"
                title="{{ content.i18ns.title|default('Care instructions') }}"
                date="{{ content.createdAt|default('2026-01-15') }}"
                url="{{ content.publicUrl|default('/content/1') }}"
            />
        </div>

        <div class="Story-col">
            <span class="Story-label">manual data, no matching content (placeholder image)</span>
            <twig:Organisms:SimilarContentCard:Base id="99999" title="How to choose your size" date="2026-02-03" url="/content/99999" />
        </div>

    </div>
</div>
</div>
