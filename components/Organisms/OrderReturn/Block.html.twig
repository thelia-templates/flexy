{% if this.isVisible %}
    <div {{ attributes.defaults({class: 'flex flex-col gap-4'}) }}>
        <h2 class="h4">{{ 'Returns'|trans }}</h2>

        {% if this.returns is not empty %}
            <ul class="flex flex-col gap-2 list-none p-0 m-0">
                {% for orderReturn in this.returns %}
                    <twig:Organisms:OrderReturnCard:Base :orderReturn="orderReturn" />
                {% endfor %}
            </ul>
        {% endif %}

        {% if this.canOpen %}
            <twig:Molecules:Button:Base
                text="{{ 'Request a return'|trans }}"
                href="{{ path('account_order_return_new', {orderId: this.orderId}) }}"
                class="w-max"
            />
        {% endif %}
    </div>
{% endif %}
