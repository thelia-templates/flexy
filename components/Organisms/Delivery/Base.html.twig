<div {{ attributes.defaults(stimulus_controller('live-refresh-on-focus')) }} data-loading="addClass(opacity-50 pointer-events-none)">
    <{{ this.headingLevel }} class="text-black h4">
        {{ 'Choose a delivery address'|trans }}
    </{{ this.headingLevel }}>
    <div class="my-8">
        {% if this.showNewAddressForm %}
            <twig:Forms:Address:Base />
        {% elseif this.editingAddressId %}
            <twig:Forms:Address:Base :addressId="this.editingAddressId" />
        {% else %}
            <div>
                {% if this.addressList|length <= 0 %}
                    <div class="flex flex-col items-start gap-3">
                        <span>
                            {{ 'You have no registered address'|trans }}:
                        </span>
                        <twig:Molecules:Button:Base
                            type="button"
                            text="{{ 'Add an address'|trans }}"
                            data-action="live#action"
                            data-live-action-param="toggleNewAddressForm"
                        />
                    </div>
                {% else %}
                    <ul class="flex flex-col gap-2">
                        {% for address in this.addressList %}
                            <li>
                                <twig:Organisms:AddressCard:Checkout :addressId="address.id" />
                            </li>
                        {% endfor %}
                    </ul>

                    <div class="flex flex-col gap-2 mt-4 lg:flex-row lg:items-center">
                        <twig:Molecules:Button:Base
                            type="button"
                            text="{{ 'Use another address'|trans }}"
                            data-action="live#action"
                            data-live-action-param="toggleNewAddressForm"
                        />
                    </div>
                {% endif %}
            </div>
        {% endif %}
    </div>

    {% if this.restrictedProducts is not empty %}
        {# SnackBar prints its text raw: the labels are the merchant's, escaped one by one before they join the sentence. #}
        {% set restrictedLabels = this.restrictedProducts|map(label => label|e)|join(', ') %}
        {% if this.restrictedProducts|length == 1 %}
            {% set restrictedMessage = '%products% cannot be shipped to this address. Remove it from your cart or choose another address.'|trans({'%products%': restrictedLabels}) %}
        {% else %}
            {% set restrictedMessage = '%products% cannot be shipped to this address. Remove them from your cart or choose another address.'|trans({'%products%': restrictedLabels}) %}
        {% endif %}
        <twig:Molecules:SnackBar:Base variant="warning" withIcon class="mb-5" text="{{ restrictedMessage }}" data-testid="delivery-destination-restricted" />
    {% endif %}
    <h2 class="text-black h4">
        {{ 'Choose a delivery method'|trans }}
    </h2>
    {% if this.deliveryDateNotice %}
        {% set noticeText = this.deliveryDateNotice == 'carrier_gone'
            ? 'The carrier you chose does not deliver to this address: your delivery date was cleared. Please choose a delivery method again.'|trans
            : 'The delivery date you picked is no longer available for this address. Please choose another one.'|trans %}
        <twig:Molecules:SnackBar:Base variant="warning" withIcon text="{{ noticeText }}" data-testid="delivery-date-notice" />
    {% endif %}
    <div class="flex flex-col gap-3.5 my-5">
        {% set deliveryOptions = this.deliveryModulesOptions %}
        {% set datePickerShown = false %}
        {% if deliveryOptions|length > 0 %}
            {% for option in deliveryOptions %}
                {% if option.deliveryMode == enum('Thelia\\Domain\\Checkout\\Enum\\DeliveryMode').DELIVERY.value %}
                    <twig:Organisms:DeliveryMode:Home
                        title="{{ option.title }}"
                        price="{{ option.price ?? '0' }}"
                        optionCode="{{ option.code }}"
                        :moduleId="option.moduleId"
                        :deliveryAddressId="this.deliveryAddressId"
                        :invoiceAddressId="this.invoiceAddressId"
                        icon="reinsurance-homedelivery"
                    />
                {% elseif option.deliveryMode == enum('Thelia\\Domain\\Checkout\\Enum\\DeliveryMode').LOCAL_PICKUP.value %}
                    <twig:Organisms:DeliveryMode:Store
                        title="{{ option.title }}"
                        description="{{ option.description ?? '' }}"
                        price="{{ option.price ?? '' }}"
                        optionCode="{{ option.code }}"
                        :moduleId="option.moduleId"
                        icon="reinsurance-store"
                    />
                {% elseif option.deliveryMode == enum('Thelia\\Domain\\Checkout\\Enum\\DeliveryMode').PICKUP.value %}
                    <twig:Organisms:DeliveryMode:Pickup
                        title="{{ option.title }}"
                        price="{{ option.price ?? '' }}"
                        optionCode="{{ option.code }}"
                        :moduleId="option.moduleId"
                        icon="reinsurance-pickup"
                    />
                {% endif %}
                {# Under the carrier selected, outside its card: a click in the calendar must
                   not reach the radio of the card, which a label around it would do. #}
                {% if not datePickerShown and option.moduleId == this.deliveryModuleId and (option.deliveryDateChoice ?? 'none') != 'none' %}
                    {% set datePickerShown = true %}
                    <twig:Organisms:DeliveryDatePicker:Base :moduleId="option.moduleId" key="delivery-date-{{ option.moduleId }}" />
                {% endif %}
            {% endfor %}
        {% else %}
            {% set blockingProducts = this.productsBlockingEveryCarrier %}
            {# The snack bar prints its text raw: the titles are the merchant's and the postal code is
               the buyer's, each escaped before it joins the sentence. #}
            {% if blockingProducts is not empty %}
                {% set blockingTitles = blockingProducts|map(title => title|e)|join(', ') %}
                {% if blockingProducts|length == 1 %}
                    {% set blockingMessage = 'No carrier can ship: %products%. Remove it from your cart to complete your order.'|trans({'%products%': blockingTitles}) %}
                {% else %}
                    {% set blockingMessage = 'No carrier can ship: %products%. Remove them from your cart to complete your order.'|trans({'%products%': blockingTitles}) %}
                {% endif %}
            {% else %}
                {% set postalCodeWithoutCarrier = this.postalCodeWithoutCarrier %}
                {% if postalCodeWithoutCarrier %}
                    {% set blockingMessage = 'No carrier delivers to the postal code %code%. Check it, or choose another delivery address.'|trans({'%code%': postalCodeWithoutCarrier|e}) %}
                {% else %}
                    {% set blockingMessage = 'No delivery method is available for this order.'|trans %}
                {% endif %}
            {% endif %}
            <twig:Molecules:SnackBar:Base
                variant="warning"
                withIcon
                text="{{ blockingMessage }}"
            />
        {% endif %}
    </div>
</div>
