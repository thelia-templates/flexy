{# Must match the controller identifier declared in Layouts/Header/Base.html.twig. #}
{% set headerController = 'Layouts--Header--base' %}

<div class="{{ ('HeaderNav ' ~ attributes.render('class'))|tailwind_merge }}" {{ attributes.without('class') }}>
    <twig:Organisms:LangSelect:Base />

    {# Opens the search panel held by Layouts/Header. A disclosure button: aria-expanded and
       aria-controls only, no aria-haspopup — the panel is a form, not a menu. #}
    <twig:Molecules:HeaderButton:Base
        icon="search"
        color="light"
        class="HeaderNav-btn HeaderNav-search"
        text="{{ 'Search'|trans }}"
        aria-expanded="false"
        aria-controls="HeaderSearch"
        {{...stimulus_action(headerController, 'togglePanel', 'click', {panel: 'search'})}}
    />

    {# Not isAuthenticatedFront(): that one is also true of a guest checking out, and the
       account menu it opens leads nowhere for them. #}
    {% if hasCustomerAccount() %}
        <twig:Organisms:HeaderProfile:Base />
    {% else %}
        <twig:Molecules:HeaderButton:Base
            href="{{ path('customer_login') }}"
            icon="account"
            color="theme"
            class="HeaderNav-btn"
            text="{{ 'Login'|trans }}"
        />
    {% endif %}

    <twig:Organisms:CartButton:Base />

    <twig:Molecules:HeaderButton:Base
        icon="menu"
        color="light"
        class="HeaderNav-btn lg:hidden"
        text="{{ 'Menu'|trans }}"
        aria-haspopup="true"
        aria-expanded="false"
        aria-controls="Menu"
        {{...stimulus_action(headerController, 'togglePanel', 'click', {panel: 'menu'})}}
    />
</div>
