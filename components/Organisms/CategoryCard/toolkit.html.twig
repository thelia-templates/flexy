{% set category = resources('/api/front/categories/1') %}

<div class="Story">
<div class="Story-section">
    <h4 class="Story-title">Base</h4>
    <div class="Story-grid Story-grid--2 Story-stage">
        <div class="Story-col">
            <span class="Story-label">real data (category #1 — image falls back to placeholder unless one was added in the BO)</span>
            <twig:Organisms:CategoryCard:Base
                id="1"
                title="{{ category.i18ns.title|default('Category one') }}"
                href="{{ category.publicUrl|default('/category/1') }}"
            />
        </div>

        <div class="Story-col">
            <span class="Story-label">manual data, no matching category (placeholder image)</span>
            <twig:Organisms:CategoryCard:Base id="99999" title="Category two" href="/category/99999" />
        </div>
    </div>
</div>
</div>
