{% set title = category.i18ns.title|default('') %}
{% set href = category.publicUrl|default('#0') %}
{% set classes = classes|default('') %}
{% set id = id|default(null) %}

<div class="CategoryCard {{ classes }}">

  <div class="CategoryCard-mainContent">
    <a class="CategoryCard-imgLink" href="{{ href }}">
      {{getImages({
        'source_id': id,
        'source_type': 'category',
        filters: {
          '1024px': 'category',
          '768px': 'category_md',
          'default': 'category_sm'
        },
        alt: ('Category'|trans)~' '~title,
        'img_attrs': {
          loading: 'lazy',
          width: 190,
          height: 190
        },
        wrapper: 'picture',
        'wrapper_attrs': {
          'class' : 'CategoryCard-img'
        },
        placeholder: asset('dist/images/placeholder.webp'),
        limit: 1
      })|raw}}
    </a>
    <div class="CategoryCard-desc">
      <span class="CategoryCard-title">{{ title }}</span>
      <div class="CategoryCard-footer">
        {{ component('Flexy:Button', {
          href,
          text: 'Discover'|trans,
          icon_right: 'chevron-right',
        }) }}
      </div>
    </div>
  </div>
</div>
