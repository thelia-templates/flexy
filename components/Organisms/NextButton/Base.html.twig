{# @prop label string Text of the call-to-action button #}
{% props label = 'Order' %}
{% set buttonProps = {text: label|trans, disabled: not this.isValid} %}
{# A null href would crash ComponentAttributes: only pass it when clickable. #}
{% if this.isValid %}
    {% set buttonProps = buttonProps|merge({href}) %}
{% endif %}
{# What is left to do before the button comes alive. A disabled button that says nothing
   leaves the buyer clicking at it; the component names the refusal, the sentences live
   here so they stay translatable. #}
{% set disabledReason = this.isValid ? null : this.disabledReason %}
{% set expressPaymentModuleCode = this.expressPaymentModuleCode %}
<div class="{{ ('flex flex-col items-end gap-2 ' ~ attributes.render('class'))|tailwind_merge }}" {{ attributes.without('class').defaults(stimulus_controller('live-refresh-on-focus')) }}>
    {% if expressPaymentModuleCode %}
        {# The buyer chose a wallet: its own button stands where the order button was,
           live exactly when the order button would be. It is rendered with the page and
           carried in here by the express-payment-dock controller, since the script next
           to it would not run if this re-render inserted it. The slot itself is left alone
           by the re-renders; the state around it is not. #}
        <div class="w-full" data-express-payment-slot data-module="{{ expressPaymentModuleCode }}" data-enabled="{{ this.isValid ? '1' : '0' }}">
            <div id="checkout-express-payment-slot" data-live-ignore class="w-full"></div>
        </div>
    {% else %}
        {{ component('Molecules:Button:Base', buttonProps) }}
    {% endif %}
    {% if disabledReason %}
        <p class="paragraph-4 text-grey-dark text-end" role="status">
            {% if disabledReason == 'cart_empty' %}
                {{ 'Your cart is empty.'|trans }}
            {% elseif disabledReason == 'delivery_address' %}
                {{ 'Choose a delivery address to continue.'|trans }}
            {% elseif disabledReason == 'delivery_module' %}
                {{ 'Choose a delivery method to continue.'|trans }}
            {% elseif disabledReason == 'payment_method' %}
                {{ 'Choose a payment method to continue.'|trans }}
            {% elseif disabledReason == 'billing_address' %}
                {{ 'Choose a billing address to continue.'|trans }}
            {% elseif disabledReason == 'billing_address_identifiers' %}
                {{ 'Complete your billing address with your company identifiers to continue.'|trans }}
            {% elseif disabledReason == 'consents' %}
                {{ 'Accept the required terms to continue.'|trans }}
            {% endif %}
        </p>
    {% endif %}
</div>
