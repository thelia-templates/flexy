{# @prop label string Text of the call-to-action button #}
{% props label = 'Order' %}
<div class="{{ ('flex justify-end ' ~ attributes.render('class'))|tailwind_merge }}" {{ attributes.without('class') }}>
    <twig:Molecules:Button:Base
        text="{{ label|trans }}"
        :disabled="not this.isValid"
        :href="this.isValid ? href : null"
    />
</div>
