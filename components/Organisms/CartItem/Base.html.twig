{# @prop index int Position of the item in the parent Cart items list (live actions target it) #}
{# @prop disabled bool Renders the item read-only and actionless (no controls at all) #}
{% props index = null, disabled = false %}
{# A line the shop offers is read-only for the same reason a summary line is: the customer
   does not own it. The server refuses to change it either way. #}
{% set readOnly = disabled or this.isOffered %}
<div
    class="{{ (this.outOfStock ? 'CartItem-wrapper CartItem-wrapper--outOfStock ' : 'CartItem-wrapper ') ~ attributes.render('class')|tailwind_merge }}"
    {{ attributes.without('class') }}
    data-loading="addClass(opacity-50 pointer-events-none)"
>
    {% if this.outOfStock or this.insufficientStock %}
        <div class="flex paragraph-4 mb-2.5">
            <span class="w-5 h-5 mr-1">
                {{ ux_icon('error') }}
            </span>
            <span>
                {% if this.outOfStock %}
                    {{ this.title }}
                    {{ 'is no longer available and cannot be ordered.'|trans }}
                {% else %}
                    {{ (this.cartItem.stock > 1 ? 'only_n_left_in_stock' : 'only_one_left_in_stock')|trans({'%title%': this.title, '%count%': this.cartItem.stock}) }}
                {% endif %}
            </span>
        </div>
    {% endif %}

    <div
        class="CartItem {{ this.outOfStock ? 'CartItem--outOfStock' : '' }} {{ this.isOffered ? 'CartItem--offered' : '' }}"
        {% if this.isOffered %}data-cart-item-offered="true"{% endif %}
    >
        <div class="CartItem-mainContent">
            <a class="CartItem-imgLink" href="{{ this.url }}">
                {% if this.pseImageId %}
                    {{ getImages({
                        source_type: 'product',
                        img_id: this.pseImageId,
                        filters: 'add_to_cart',
                        limit: 1,
                        wrapper: 'figure',
                        wrapper_attrs: {class: 'CartItem-img'},
                        img_attrs: {class: 'mx-auto', loading: 'lazy', width: '105', height: '112'},
                        placeholder: asset('images/placeholder2.webp'),
                    })|raw }}
                {% else %}
                    <figure class="CartItem-img">
                        <img class="mx-auto" src="{{ asset('images/placeholder2.webp') }}" alt="" width="105" height="112" loading="lazy">
                    </figure>
                {% endif %}
            </a>
            <div class="CartItem-desc">
                <a href="{{ this.url }}" class="CartItem-title">
                    {{ this.title }}
                </a>
                {% if this.isOffered %}
                    <twig:Molecules:Tag:Base
                        color="success"
                        customText="{{ 'Offered'|trans }}"
                        class="mb-1"
                    />
                {% endif %}
                <div class="CartItem-orderInfos paragraph-6">
                    {% if this.desc %}
                        <span>{{ this.desc }}</span>
                    {% endif %}
                    {% if this.attributesAv|length %}
                        <span>
                            {%- set attrs = [] -%}
                            {%- for attribute, value in this.attributesAv -%}
                                {%- set attrs = attrs|merge([attribute ~ ' : ' ~ value]) -%}
                            {%- endfor -%}
                            {{ attrs|join(', ') }}
                        </span>
                    {% endif %}
                    {% if this.cartItem.quantity %}
                        <span>
                            {{ 'Quantity:'|trans }}
                            {{ this.cartItem.quantity }}
                        </span>
                    {% endif %}
                </div>

                {# What a module attached to this line: paid options, engraving, anything
                   that describes the line without owning its price. Mirrors the point the
                   account order lines already declare in Layouts/OrderProducts. #}
                {{ theme_hook('cart.item.bottom', {cartItem: this.cartItem}) }}

                <div class="CartItem-footer">
                    {# A gift is priced by the line and not by the unit: what the promotion
                       takes off covers the whole line. Given outright the line falls to zero,
                       given at a discount it keeps what is left to pay — the price the gift
                       would have cost is struck beside it either way. #}
                    {% if this.isOffered %}
                        <div class="CartItem-footerRight">
                            {% if this.offeredIsDiscounted %}
                                <div class="CartItem-price">
                                    <span class="sr-only">{{ 'This product is offered by a promotion, the discount is deducted in the order summary.'|trans }}</span>
                                    {{ this.prices.offeredEffectiveTaxedPrice|format_currency('EUR', locale: lang_code) }}
                                </div>
                                <div class="CartItem-originalPrice">
                                    {{ this.prices.offeredTaxedPrice|format_currency('EUR', locale: lang_code) }}
                                </div>
                            {% else %}
                                <div class="CartItem-price">
                                    <span class="sr-only">{{ 'This product was added to your cart by a promotion.'|trans }}</span>
                                    {{ this.prices.offeredTaxedPrice|format_currency('EUR', locale: lang_code) }}
                                </div>
                            {% endif %}
                        </div>
                    {% elseif this.promo %}
                        <div class="CartItem-footerRight">
                            <div class="CartItem-price">
                                {{ this.prices.promoTaxedPrice|format_currency('EUR', locale: lang_code) }}
                            </div>
                            <div class="CartItem-originalPrice">
                                {{ this.prices.taxedPrice|format_currency('EUR', locale: lang_code) }}
                            </div>
                        </div>
                    {% else %}
                        <div class="CartItem-price">
                            {{ this.prices.taxedPrice|format_currency('EUR', locale: lang_code) }}
                        </div>
                    {% endif %}

                    {% if this.outOfStock %}
                        <div class="CartItem-unavailable">
                            {{ 'Unavailable'|trans }}
                        </div>
                    {% elseif not readOnly %}
                        <div class="CartItem-quantity" {{ stimulus_controller('Organisms--CartItem--quantity') }}>
                            <button
                                type="button"
                                aria-label="{{ 'Decrease quantity'|trans }}"
                                data-action="live#action"
                                data-live-action-param="minus"
                                data-live-index-param="{{ index }}"
                                {% if this.cartItem.quantity <= 0 %}class="invisible"{% endif %}
                            >&minus;</button>

                            <input
                                type="number"
                                aria-label="{{ 'Quantity'|trans }}"
                                data-model="on(change)|items[{{ index }}].quantity"
                                data-action="input->Organisms--CartItem--quantity#enforce change->live#action"
                                data-live-action-param="onQuantityChanged"
                                data-live-index-param="{{ index }}"
                                data-live-base-quantity-param="{{ this.cartItem.quantity }}"
                                value="{{ this.cartItem.quantity }}"
                                min="0"
                                {% if this.cartItem.stockManaged %}max="{{ this.cartItem.stock }}"{% endif %}
                            >

                            <button
                                type="button"
                                aria-label="{{ 'Increase quantity'|trans }}"
                                data-action="live#action"
                                data-live-action-param="plus"
                                data-live-index-param="{{ index }}"
                                {% if this.cartItem.stockManaged and this.cartItem.quantity >= this.cartItem.stock %}class="invisible"{% endif %}
                            >+</button>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        {% if not disabled %}
            <div class="CartItem-actions">
                <a href="{{ this.url }}">
                    <span>{{ ux_icon('show') }}</span>
                    {{ 'View product'|trans }}
                </a>
                {# An offered line keeps its way to the product sheet and loses its way out of
                   the cart: the promotion decides whether it belongs there. #}
                {% if not readOnly %}
                    <button type="button" {{ live_action('remove', {index}) }}>
                        <span>{{ ux_icon('delete') }}</span>
                        {{ 'Delete'|trans }}
                    </button>
                {% endif %}
            </div>
        {% endif %}
    </div>
</div>
