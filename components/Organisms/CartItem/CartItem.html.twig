{% if cartItem %}
	{% set outOfStock = outOfStock|default(cartItem.productSaleElements.quantity <= 0) %}
	{% set product = cartItem.product %}
	{% set secondaryTitle = product.i18ns.chapo %}
	{% set pseImage = resources('/api/front/product_sale_elements_product_image',{'productSaleElementsId':cartItem.productSaleElements.id})|first %}

	<div class='{{ outOfStock ? 'CartItem-outOfStock' :'' }} {% if hide %}hidden{% endif %}' {{ attributes }}>
		{% if outOfStock %}
			<div class='flex paragraph-4'>
				<span class='w-5 h-5'>{{ ux_icon("error") }}</span>
				<span>[{{ title }}]
					{{ 'is no longer available and cannot be ordered.' |trans }}</span>
			</div>
		{% endif %}
		<div class="CartItem {{ classes }}">
			<div class="CartItem-mainContent">
				<a class="CartItem-imgLink" href="{{ product.publicUrl }}">
					{{getImages({
						'source_type': 'product',
						'img_id': pseImage.productImageId,
						'filters': 'add_to_cart',
						'limit':1,
						'wrapper': 'figure',
						'wrapper_attrs': {
							'class': 'CartItem-img'
						},
						'img_attrs': {
							'class': 'mx-auto',
							'loading': 'lazy',
							'widht': '105',
							'height': '112'
						},
						'placeholder': asset('dist/images/placeholder.webp')
					})|raw}}
				</a>
				<div class="CartItem-desc">
					<a href="{{ product.publicUrl }}" class="ProductCard-title">{{ product.i18ns.title }}</a>

					{% if secondaryTitle %}
						<div class="block CartItem-subTitle paragraph-3 md:hidden">{{ secondaryTitle }}</div>
					{% endif %}
					<div class="CartItem-orderInfos paragraph-6">

						{% if secondaryTitle %}
							<span class="hidden CartItem-secondaryTitle md:inline">{{ secondaryTitle }}</span>
						{% endif %}
						{% for attribute,value in attributesAv %}
							<span class="CartItem-secondarySize">{{ attribute }}
								:
								{{ value }}</span>
						{% endfor %}
						{% if cartItem.quantity %}
							<span>{{ 'Quantity:' |trans }}
								{{ cartItem.quantity }}</span>
						{% endif %}

						{% if attributesAvColor %}

							<span class="flex items-center CartItem-secondarySize">
								<span class="mr-1 Colors-item" style="background-color:{{ attributesAvColor.hexa }}"></span>
								{{ t('Color') }}:
								{{ attributesAvColor.name }}</span>
						{% endif %}
					</div>


					<div class="CartItem-footer">
						{% if cartItem.promo %}
							<div class="CartItem-footerRight">
								<div class="CartItem-price">{{ cartItem.promoPrice|format_currency('EUR', locale: lang_code) }}</div>
								<div class="CartItem-originalPrice">{{ cartItem.price|format_currency('EUR', locale: lang_code) }}</div>
							</div>
						{% else %}
							<div class="CartItem-price">{{ cartItem.price|format_currency('EUR', locale: lang_code) }}</div>
						{% endif %}


						{% if outOfStock %}
							<div class="CartItem-unavailable">
								{{ 'Unavailable' |trans }}
							</div>
						{% else %}
							<div class="CartItem-quantity">
								{% include '@components/Molecules/Button/Quantity.html.twig' with {disabled: false, value:cartItem.quantity, classes:'Button--small Button--secondary', btnLiveAction: 'setQuantity'} %}
							</div>
						{% endif %}

					</div>
				</div>
			</div>

			<div class="bottom-card-buttons">
				<a href='{{ product.publicUrl }}' class='hover:bg-theme-lighter' {% if disabled %} disabled {% endif %} type='button'>
					<span>{{ ux_icon("show") }}</span>
					{{ 'View product'|trans }}
				</a>
				<button class='hover:bg-theme-lighter' {% if disabled %} disabled {% endif %} type='button' data-action="live#action" data-live-action-param="removeCartItem">
					<span>{{ ux_icon("delete") }}</span>
					{{ 'Delete' |trans }}
				</button>
			</div>

		</div>
		{% if outOfStock %}
			<div class='flex md:justify-end'>
				{% include '@components/Molecules/Button/Button.html.twig' with {text: 'View similar products' |trans, href: '#', classes:'md:Button--unfill Button--fill'} %}
			</div>
		{% endif %}
	</div>
{% endif %}
