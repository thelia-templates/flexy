<div {{ attributes.defaults(stimulus_controller('live-refresh-on-focus')) }} data-loading="addClass(opacity-50 pointer-events-none)">
    {% if this.totalItems %}
        {% if this.itemHasNoStockMessage %}
            <twig:Molecules:SnackBar:Base
                variant="error"
                withIcon
                class="mb-6"
                text="{{ 'Your cart contains unvailable products'|trans }}"
            />
        {% endif %}

        {% if this.itemHasInsufficientStockMessage %}
            <twig:Molecules:SnackBar:Base
                variant="error"
                withIcon
                class="mb-6"
                text="{{ 'Some products in your cart are no longer available in the requested quantity. Please adjust the quantities before ordering.'|trans }}"
            />
        {% endif %}

        {# SnackBar prints its text raw, and these labels are merchant-authored: escaped here,
           once, rather than trusted. #}
        {% for promotion in this.unavailablePromotionMessages %}
            <twig:Molecules:SnackBar:Base
                variant="warning"
                withIcon
                class="mb-6"
                data-cart-unavailable-promotion="true"
                text="{{ 'promotion_unavailable_out_of_stock'|trans({'%promotion%': promotion})|escape('html') }}"
            />
        {% endfor %}

        <div class="text-end mb-1 paragraph-6 hidden sm:block">
            <bdi>{{ this.totalItems }} {{ (this.totalItems <= 1 ? 'item' : 'items')|trans }}</bdi>
        </div>

        {% if this.pendingDelete %}
            <twig:Organisms:CartItemDelete:Base
                title="{{ this.pendingDelete.title }}"
                :productId="this.pendingDelete.productId"
                :pseId="this.pendingDelete.pseId"
                :quantity="this.pendingDelete.quantity"
                :imageId="this.pendingDelete.imageId"
            />
        {% endif %}

        <div class="flex flex-col gap-5">
            {% for index, item in this.items %}
                <twig:Organisms:CartItem:Base :cartItem="item" :index="index" :key="item.id" />
            {% endfor %}
        </div>
    {% else %}
        {% if this.pendingDelete %}
            <twig:Organisms:CartItemDelete:Base
                title="{{ this.pendingDelete.title }}"
                :productId="this.pendingDelete.productId"
                :pseId="this.pendingDelete.pseId"
                :quantity="this.pendingDelete.quantity"
                :imageId="this.pendingDelete.imageId"
            />
        {% endif %}
        <div class="my-8 text-center">
            {{ ux_icon('empty', {class: 'w-60 h-45 block mx-auto mb-14'}) }}
            <{{ this.headingLevel }} class="mb-6 h3">
                {{ 'Your cart is empty'|trans }}
            </{{ this.headingLevel }}>
            <twig:Molecules:Button:Base
                text="{{ 'Back to the store'|trans }}"
                size="large"
                href="{{ path('index') }}"
            />
        </div>
    {% endif %}
</div>
