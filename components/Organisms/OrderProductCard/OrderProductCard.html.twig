<div class="OrderProductCard">
	<div class="OrderProductCard-mainContent">
		{{getImages({
      'source_type': 'product',
      'source_id': product.id,
      'filters': 'order_card_detail',
      'wrapper': 'figure',
      'wrapper_attrs': {
        'class' : 'OrderProductCard-img'
      },
      'limit': 1,
      'img_attrs': {
          'loading': 'lazy',
          'widht': '112',
          'height': '112'
      },
      'placeholder': asset('dist/images/placeholder.webp')
    })|raw}}
		<div class="OrderProductCard-desc">
			<a href="{{product.publicUrl ~ '?ref=' ~ orderProduct.productRef }}" class="OrderProductCard-title">{{ productTitle }}</a>
			<div class="OrderProductCard-orderInfos paragraph-6">
				<span class="OrderProductCard-secondaryTitle">{{ secondaryTitle }}</span>
				{% for combination in attributeCombinations %}
					<span class="OrderProductCard-secondarySize">{{ combination.attribute.i18ns.title }}
						:
						{{ combination.attributeAv.i18ns.title }}</span>
				{% endfor %}
				{% if quantity %}
					<span>{{ 'Quantity:' |trans }}
						{{ quantity }}</span>
				{% endif %}

				{% if attributesAvColor %}

					<span class="flex items-center OrderProductCard-secondarySize">
						<span class="mr-1 Colors-item" style="background-color:{{ attributesAvColor.hexa }}"></span>
						{{ t('Color') }}:
						{{ attributesAvColor.name }}</span>
				{% endif %}
			</div>
			{% if isPromo %}
				<div class="OrderProductCard-footerRight">
					<div class="OrderProductCard-price">{{ promoPrice|format_currency('EUR', locale: lang_code) }}</div>
					<div class="OrderProductCard-originalPrice">{{ price|format_currency('EUR', locale: lang_code) }}</div>
				</div>
			{% else %}
				<div class="OrderProductCard-price">{{ price|format_currency('EUR', locale: lang_code) }}</div>
			{% endif %}
		</div>
	</div>
</div>
