{% set control = control|default('') %}

<div class="PasswordControls" {% if control %} data-control-password='{{control}}' {% endif %}>
	{{'Your Message must contain'|trans}}
	:
	<ul>
		<li id="{{ control ~"_size"}}">{{'at least 12 characters'|trans}}</li>
		<li id="{{ control ~"_uppercase"}}">{{'at least 1 capital letter'|trans}}</li>
		<li id="{{ control ~"_lowercase"}}">{{'at least 1 low-case letter'|trans}}</li>
		<li id="{{ control ~"_number"}}">{{'at least 1 digit'|trans}}</li>
		<li id="{{ control ~"_special"}}">{{'at least 1 special character'|trans}}</li>
	</ul>
</div>
