{% set control = control|default('') %}

<div class="PasswordControls" {% if control %} data-control-password='{{control}}' {% endif %}>
	Votre mot de passe doit contenir :
	<ul>
		<li id="{{ control ~"_length"}}">au moins 8 caractères</li>
		<li id="{{ control ~"_uppercase"}}">au moins 1 lettre majuscule</li>
		<li id="{{ control ~"_lowercase"}}">au moins 1 lettre minuscule</li>
		<li id="{{ control ~"_number"}}">au moins 1 chiffre</li>
		<li id="{{ control ~"_special"}}">au moins 1 caractère spécial (ex. : #, @, !...)</li>
	</ul>
</div>
