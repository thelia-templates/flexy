{# @prop items list<{strongText: string|null, text: string, icon: icon|null}> max:6 The reassurance points, side by side #}
{# @prop items.strongText The emphasised lead-in #}
{# @prop items.text The words that follow it, on the same line #}
{# @prop items.icon The icon drawn before the point #}
{% props items = [] %}

<div class="{{ ('Reinsurance ' ~ attributes.render('class'))|tailwind_merge }}" {{ attributes.without('class') }}>
    {% for item in items %}
        <div>
            {% if item.icon is defined and item.icon %}
                <span class="Reinsurance-icon">
                    {{ ux_icon(item.icon) }}
                </span>
            {% endif %}
            <span>
                {% if item.strongText is defined and item.strongText %}
                    <strong>{{ item.strongText }}</strong>
                {% endif %}
                {{ item.text }}
            </span>
        </div>
    {% endfor %}
</div>
