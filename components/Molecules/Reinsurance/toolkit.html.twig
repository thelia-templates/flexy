{% set items = [
    {icon: 'reinsurance-delivery', strongText: 'Free delivery'|trans, text: 'from 50€'|trans},
    {icon: 'reinsurance-shipping', strongText: 'Shipping'|trans, text: 'within 24 hours'|trans},
] %}

<div class="Story">
    <div class="Story-section">
        <h4 class="Story-title">base</h4>
        <twig:Molecules:Reinsurance:Base :items="items" />
    </div>

    <div class="Story-section">
        <h4 class="Story-title">single item</h4>
        <twig:Molecules:Reinsurance:Base :items="[items|first]" />
    </div>

    <div class="Story-section">
        <h4 class="Story-title">without icon</h4>
        <twig:Molecules:Reinsurance:Base :items="[{strongText: 'Free delivery'|trans, text: 'from 50€'|trans}]" />
    </div>
</div>
