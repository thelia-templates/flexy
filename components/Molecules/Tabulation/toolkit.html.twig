{% macro row(size) %}
    <div class="Story-row">
        <twig:Molecules:Tabulation:Base customText="Tab" size="{{ size }}" />
        <twig:Molecules:Tabulation:Base customText="With left icon" iconLeft="chevron-left" size="{{ size }}" />
        <twig:Molecules:Tabulation:Base customText="With right icon" iconRight="chevron-right" size="{{ size }}" />
        <twig:Molecules:Tabulation:Base customText="Both icons" iconLeft="chevron-left" iconRight="chevron-right" size="{{ size }}" />
        <twig:Molecules:Tabulation:Base customText="Disabled" size="{{ size }}" disabled />
        <twig:Molecules:Tabulation:Base customText="Disabled icon" iconLeft="chevron-left" iconRight="chevron-right" size="{{ size }}" disabled />
    </div>
{% endmacro %}

<div class="Story">
    <div class="Story-section">
        <h4 class="Story-title">Default</h4>
        {{ _self.row(null) }}
    </div>
    <div class="Story-section">
        <h4 class="Story-title">Large</h4>
        {{ _self.row('large') }}
    </div>
    <div class="Story-section">
        <h4 class="Story-title">Small</h4>
        {{ _self.row('small') }}
    </div>
</div>
