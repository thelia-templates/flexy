{% props htmlTag = 'span', customText = '', color = "neutral" %}

{% set StockTag = html_cva(
    base: 'StockTag ',
    variants: {
        color: {
            in: 'StockTag--in',
            low: 'StockTag--low',
            out: 'StockTag--out',
            preorder: 'StockTag--preorder',
        },
    }
) %}

<{{ htmlTag }} class="{{ StockTag.apply({color}, attributes.render('class')) }} "  {{ attributes.without('class') }}>
        {{ customText }}
</{{ htmlTag }}>
