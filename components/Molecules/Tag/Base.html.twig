{% props
    icon = null,
    htmlTag = 'span',
    customText = '',
    color = null,
    selected = false,
    noBackground = false,
    noBorder = false,
    close = false
%}

{% set Tag = html_cva(
    base: 'Tag',
    variants: {
        color: {
            neutral: '',
            success: 'Tag--success',
            validated: 'Tag--validated',
            error: 'Tag--error',
            warning: 'Tag--warning',
            sale: 'Tag--sale',

        },
        selected: {
            true: 'Tag--selected',
        },
        noBackground: {
            true: 'Tag--noBackground',
        },
        noBorder: {
            true: 'Tag--noBorder',
        }
    }
) %}


<{{ htmlTag }} class="{{ Tag.apply({color, selected, noBackground, noBorder}, attributes.render('class')) }} "  {{ attributes.without('class', 'data-action') }}>
        {% if icon %}
            <span class="Tag__icon">
                {{ ux_icon(icon) }}
            </span>
        {% endif %}
        {{ customText }}
        {% if attributes.has('data-action') %}
            <button
                type="button"
                class="Tag__iconClose"
                aria-label="{{ customText ? 'Remove %label%'|trans({'%label%': customText}) : 'Remove'|trans }}"
                data-action="{{ attributes.render('data-action') }}"
            >
                {{ ux_icon('close-big') }}
            </button>
        {% endif %}
</{{ htmlTag }}>
