<div class="Story">

    <div class="Story-section">
        <h4 class="Story-title">Base (mobile-only: becomes static inline content from md upward)</h4>
        <div
            class="Story-col Story-col--loose Story-col--centered Story-stage Story-stage--roomy Story-anchor"
            {{ stimulus_controller('Molecules--MobileDrawer--base') }}
        >
            <twig:Molecules:Button:Base
                class="md:hidden"
                {{ ...stimulus_action('Molecules--MobileDrawer--base', 'toggle', 'click') }}
            >
                Open the drawer
            </twig:Molecules:Button:Base>

            <twig:Molecules:MobileDrawer:Base>
                <p class="paragraph-2">Arbitrary content displayed inside the drawer.</p>
            </twig:Molecules:MobileDrawer:Base>
        </div>
    </div>

</div>
