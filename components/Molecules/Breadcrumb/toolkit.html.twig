{# The breadcrumb renders a single "back to parent" link (not a full trail): the parent is the item
   before the current page, or Home when the page is top-level. So the only meaningful variants are
   what that parent resolves to. #}
{% set topLevel = [
    {url: '/men', title: 'Men'}
] %}

{% set nested = [
    {url: '/men', title: 'Men'},
    {url: '/men/shirts', title: 'Shirts'}
] %}

<div class="Story">
    <div class="Story-section">
        <h4 class="Story-title">Base</h4>

        {# .Breadcrumb is position:absolute (it overlays the Subheader in real use), so each example
           needs its own relative box with reserved height, otherwise they overlap. #}
        {% set examples = [
            { label: 'top-level page → back to Home', items: topLevel },
            { label: 'nested page → back to parent', items: nested }
        ] %}

        {% for example in examples %}
            <div class="Story-col">
                <span class="Story-label">{{ example.label }}</span>
                <div class="Story-canvas Story-anchor Story-reserve">
                    <twig:Molecules:Breadcrumb:Base :items="example.items" />
                </div>
            </div>
        {% endfor %}
    </div>
</div>
