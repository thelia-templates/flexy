{% use '@formTwig/flexy_form_theme.html.twig' %}

{% set classes = '' %}
{% if errors|length %}
  {% set attr = attr|merge({class: attr.class~' is-error'}) %}
{% endif %}
{% if success %}
  {% set classes = classes ~ ' FieldSelect--success' %}
{% endif %}
{% if size %}
  {% set classes = classes ~ ' FieldSelect--' ~ size %}
{% endif %}
<div class='FieldSelect{{ classes }}' {% if disabled %} disabled {% endif %}>
  <select {{ block('widget_attributes') }}{% if multiple %} multiple="multiple"{% endif %}>
    {% if attr.placeholder %}
      <option class='FieldSelect-placeholder' selected>
        {{ attr.placeholder }}
        {% if not required and not label %}
          ({{ 'optional' | trans }})
        {% endif %}
      </option>
    {% endif %}
    {% for choice in choices %}
      <option value="{{ choice.value }}" {% if value == choice.value %}selected{% endif %}>{{ choice.label }}</option>
    {% endfor %}
  </select>
</div>
