{% use 'frontOffice/work/flexy_form_theme.html.twig' %}
{% set type = type|default(attr.type|default('text')) %}
{% set unit = unit|default(null) %}

{% if errors.errors|length %}
	{% set classes = classes ~ ' FieldInput--error' %}
{% endif %}

{% if unit or type == 'password' %}
  {% set attr = attr|merge({class: attr.class~' FieldInput-input--unit'}) %}
{% endif %}

<div class='FieldInput-blockInput' {% if type == 'password' %}data-password-target="wrapper"{% endif %}>
  <input type="{{ type }}" {{ block('widget_attributes') }} {% if value is not empty %} value="{{ value }}" {% endif %}/>
  {% if unit %}
    <div class="absolute top-1/2 transform -translate-y-1/2 right-4">{{ unit }}</div>
  {% endif %}
  {% if type == 'password' %}
    <div class="FieldInput-button FieldInput-buttonIcon">
      <button type="button" class="w-4 FieldInput-togglePassword" aria-label="{{ name }}" data-id="{{ id }}" {% if type == 'password' %} data-password-target="toggler" {% endif %}>
        <span>{{ ux_icon('show') }}</span>
      </button>
    </div>
  {% endif %}
</div>

