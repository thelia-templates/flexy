<div class="Story">

    {# ── Base — arbitrary triggers ─────────────────────────────────────── #}

    <div class="Story-section">
        <h4 class="Story-title">Base</h4>
        <div class="Story-row Story-stage Story-stage--roomy">

            <div class="Story-col Story-col--centered">
                <span class="Story-label">text button — top</span>
                <twig:Molecules:Tooltip:Base tooltip="Triggered by a text button.">
                    <button type="button" {{ stimulus_action('Molecules--Tooltip--base', 'toggle', 'click') }}>
                        Learn more
                    </button>
                </twig:Molecules:Tooltip:Base>
            </div>

            <div class="Story-col Story-col--centered">
                <span class="Story-label">badge — top</span>
                <twig:Molecules:Tooltip:Base tooltip="This product benefits from an exceptional discount this month.">
                    <span class="Tag Tag--promo" {{ stimulus_action('Molecules--Tooltip--base', 'toggle', 'click') }}>
                        -20%
                    </span>
                </twig:Molecules:Tooltip:Base>
            </div>

            <div class="Story-col Story-col--centered">
                <span class="Story-label">text button — bottom</span>
                <twig:Molecules:Tooltip:Base tooltip="Tooltip below the trigger." position="bottom">
                    <button type="button" {{ stimulus_action('Molecules--Tooltip--base', 'toggle', 'click') }}>
                        View details
                    </button>
                </twig:Molecules:Tooltip:Base>
            </div>

        </div>
    </div>

    {# ── Help ───────────────────────────────────────────────────────────── #}

    <div class="Story-section">
        <h4 class="Story-title">Help</h4>
        <div class="Story-row Story-stage Story-stage--roomy">

            <div class="Story-col Story-col--centered">
                <span class="Story-label">top position (default)</span>
                <twig:Molecules:Tooltip:Help tooltip="This field is used for billing purposes only." />
            </div>

            <div class="Story-col Story-col--centered">
                <span class="Story-label">bottom position</span>
                <twig:Molecules:Tooltip:Help tooltip="Tooltip displayed at the bottom." position="bottom" />
            </div>

        </div>
    </div>

</div>
