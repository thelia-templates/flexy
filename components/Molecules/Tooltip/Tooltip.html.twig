{% set position = position|default('top') %}
{% set tooltip = tooltip|default('') %}

{% set classes = '' %}
{% set classes = classes ~ ' Tooltip-text--' ~ position %}

<div class='Tooltip' {{ stimulus_controller('tooltip') }}>
  <button type="button" class='Tooltip-icon' data-action="tooltip#toggle">{{ ux_icon("help") }}</button>
  <span class='Tooltip-text {{ classes }}' data-tooltip-target="text">
    <button type="button" class='Tooltip-close' data-action="tooltip#toggle">{{ ux_icon("close") }}</button>
    {{ tooltip }}
  </span>
</div>
