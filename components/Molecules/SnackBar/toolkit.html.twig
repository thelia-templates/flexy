<div class="Story">

    <div class="Story-section">
        <h4 class="Story-title">variant</h4>
        <div class="Story-col">
            <twig:Molecules:SnackBar:Base variant="neutral-light" text="Neutral light" />
            <twig:Molecules:SnackBar:Base variant="neutral-dark" text="Neutral dark" />
            <twig:Molecules:SnackBar:Base variant="error" withIcon text="Error" />
            <twig:Molecules:SnackBar:Base variant="warning" withIcon text="Warning" />
            <twig:Molecules:SnackBar:Base variant="success" withIcon text="Success" />
            <twig:Molecules:SnackBar:Base variant="informative" withIcon text="Informative" />
        </div>
    </div>

    <div class="Story-section">
        <h4 class="Story-title">with button</h4>
        <div class="Story-col">
            <twig:Molecules:SnackBar:Base variant="error" withIcon text="Error message to help the user fix their mistake." button="Button" />
        </div>
    </div>

    <div class="Story-section">
        <h4 class="Story-title">without icon</h4>
        <div class="Story-col">
            <twig:Molecules:SnackBar:Base variant="informative" text="Informative, no icon" />
        </div>
    </div>

</div>
