<div class="Story">

    {# ── Base ────────────────────────────────────────────────────────────── #}

    <div class="Story-section">
        <h4 class="Story-title">Base</h4>
        <div class="Story-row Story-stage Story-stage--roomy">

            <div class="Story-col Story-col--centered">
                <span class="Story-label">
                    Opened by id via <code>open_controller.js</code> (<code>Molecules--Modal--open</code>) —
                    the trigger and the dialog don't need to share a DOM ancestor.
                </span>
                <twig:Molecules:Button:Base
                    {{ ...stimulus_controller('Molecules--Modal--open', {id: 'toolkitModal'}) }}
                    {{ ...stimulus_action('Molecules--Modal--open', 'open', 'click') }}
                >
                    Open the modal
                </twig:Molecules:Button:Base>

                <twig:Molecules:Modal:Base id="toolkitModal">
                    <p class="paragraph-2">Arbitrary content displayed inside the modal.</p>
                    <div class="Story-row">
                        <twig:Molecules:Button:Base
                            color="secondary"
                            {{ ...stimulus_action('Molecules--Modal--base', 'close', 'click') }}
                        >
                            Cancel
                        </twig:Molecules:Button:Base>
                        <twig:Molecules:Button:Base
                            {{ ...stimulus_action('Molecules--Modal--base', 'close', 'click') }}
                        >
                            Confirm
                        </twig:Molecules:Button:Base>
                    </div>
                </twig:Molecules:Modal:Base>
            </div>

        </div>
    </div>

</div>
