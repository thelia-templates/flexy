{# One sign-in button carrying a provider's brand mark, so the network is recognisable at
   a glance. It composes Molecules:Button:Base (secondary style, rectangular per Apple's
   guidelines, full width) and drops the mark into the button's own icon slot, so sizing
   and spacing come from the button, not from here.

   Google keeps its official colours; Facebook keeps its brand blue; Apple follows the
   button's text colour so it stays legible when the button darkens. A provider with no
   mark still renders, just without a logo.

   The marks below are the fallback, used when no official artwork was supplied: brand
   guidelines (Apple's in particular) require the logo downloaded from the provider's own
   design resources and forbid recreating it, so a shop supplies it in the back office
   (Modules > SocialLogin, "logo (SVG)" per provider) and it arrives here as
   `trustedLogoSvg`. Google's guidelines also ask for the Google Sans font and the "G" on a
   light background. #}
{% set marks = {
    google: '<svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.28-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>',
    facebook: '<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="#1877F2" d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.96.93-1.96 1.89v2.25h3.33l-.53 3.49h-2.8V24C19.61 23.1 24 18.1 24 12.07z"/></svg>',
    apple: '<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M16.365 1.43c0 1.14-.42 2.2-1.13 2.98-.79.87-2.08 1.55-3.15 1.47-.13-1.09.42-2.24 1.09-2.95.77-.83 2.14-1.46 3.19-1.5zM20.5 17.4c-.53 1.23-.79 1.78-1.47 2.87-.95 1.52-2.29 3.42-3.95 3.43-1.47.02-1.85-.96-3.85-.95-2 .01-2.41.97-3.88.94-1.66-.02-2.93-1.74-3.88-3.26-2.66-4.24-2.94-9.22-1.3-11.87 1.17-1.88 3.01-2.98 4.74-2.98 1.76 0 2.87.97 4.33.97 1.42 0 2.28-.97 4.32-.97 1.54 0 3.17.84 4.33 2.29-3.81 2.09-3.19 7.53.48 9.5z"/></svg>',
} %}

{# Captured here, at the component's own scope: inside the inner button's slot `this` is
   the button, not this component, so these must be plain variables — and `labelText`, not
   `text`, so a future public `$text` on Button cannot shadow it through the slot context.

   `this.trustedLogoSvg`, when set, is the merchant's official logo, supplied ALREADY
   SANITIZED by the caller (the SocialLogin module). Its declared type is `Twig\Markup`, so
   a caller handing over an unsanitized string never gets past mounting the component. Both
   branches below are safe to print with |raw: a Markup from the module, or one of the
   static built-in marks above. Null falls back to those built-in marks. #}
{% set mark = this.trustedLogoSvg|default('') ?: (marks[this.provider] is defined ? marks[this.provider] : null) %}
{% set labelText = this.label ?? this.provider|capitalize %}

<twig:Molecules:Button:Base href="{{ this.href }}" color="secondary" rectangle fill="true" class="social-button">
    {% if mark %}<span class="icon icon-left">{{ mark|raw }}</span>{% endif %}{{ labelText }}
</twig:Molecules:Button:Base>
