{% set classes = classes|default('') %}
{% set text = text|default('') %}
{% set disabled = disabled|default(false) %}
{% set href = href|default(false) %}
{% set liveAction = liveAction|default(null) %}
{% set liveEvent = liveEvent|default(null) %}
{% set inLiveComp = inLiveComp|default(false) %}
{% set type = type|default(inLiveComp ? 'submit':'button') %}
{% set icon_left = icon_left|default(false) %}
{% set icon_right = icon_right|default(false) %}
{% set fill = fill|default(false) %}
{% set variant = variant|default('primary') %}
{% set rectangle = rectangle|default(false) %}
{% set sharp = sharp|default(false) %}
{% set round = round|default(false) %}
{% set name = name|default('') %}
{% set onClick = onClick|default({}) %}
{% set toggleDrawer = toggleDrawer|default(null) %}
{% set props = props|default([]) %}


{% if variant and variant != 'primary' %}
  {% set classes = classes ~ ' Button--' ~ variant %}
{% endif %}
{% if fill %}
  {% set classes = classes ~ ' Button--fill' %}
{% endif %}
{% if rectangle %}
  {% set classes = classes ~ ' Button--rectangle' %}
{% endif %}
{% if sharp %}
  {% set classes = classes ~ ' Button--sharp' %}
{% endif %}
{% if round %}
  {% set classes = classes ~ ' Button--round' %}
{% endif %}
{% set tag = 'button' %}
{% if href %}
  {% set tag = 'a' %}
{% endif %}

{% if liveEvent %}
  {% set props = props|merge({'data-action': "live#emit",'data-live-event-param': liveEvent}) %}
{% endif %}

<{{ tag }} class='Button {{ classes }}'  {% for key,value in props %}{{ key }}="{{ value }}"{% endfor %} {% if disabled %} disabled {% endif %} {% if href %} href='{{ href }}' {% else %} type='{{ type }}' {% endif %} {% if onClick %} onclick="{{ onClick }}" {% endif %} {% if name %} data-id="{{ name }}" {% endif %} {% if liveAction %} data-action="live#action" data-live-action-param="{{ liveAction }}" {% endif %} {% if toggleDrawer %} data-drawer-toggle="{{ toggleDrawer }}" {% endif %}>
{% if icon_left %}
  <span class='icon icon-left'>
			{{ ux_icon(icon_left) }}
		</span>
{% endif %}
	{{ text|striptags('<span>')|raw }}
	{% if icon_right %}
    <span class='icon icon-right'>
			{{ ux_icon(icon_right) }}
		</span>
  {% endif %}
</{{ tag }}>
