{% props href, customText, iconLeft = null, iconRight = null, size = null %}

{% set link = html_cva(
    base: 'Link',
    variants: {
        size: {
            medium: 'Link--medium',
            small: 'Link--small',
        },
    },
) %}

{% import '@Flexy/Atoms/Icon/direction.html.twig' as icon_direction %}
{% set mirrorLeft = icon_direction.mirror_class(iconLeft) %}
{% set mirrorRight = icon_direction.mirror_class(iconRight) %}

<a href="{{ href }}" class="{{ link.apply({size}, attributes.render('class')) }} " {{ attributes.without('class') }}>
    {% if iconLeft %}
        <span class="Link-icon {{ mirrorLeft }}">
            {{ ux_icon(iconLeft) }}
        </span>
    {% endif %}

    {{ customText }}

    {% if iconRight %}
        <span class="Link-icon {{ mirrorRight }}">
            {{ ux_icon(iconRight) }}
        </span>
    {% endif %}
</a>
