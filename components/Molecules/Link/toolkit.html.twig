{% macro row(size) %}
    <div class="Story-row">
        <twig:Molecules:Link:Base href="#" customText="Link" size="{{ size }}" />
        <twig:Molecules:Link:Base href="#" customText="With left icon" iconLeft="chevron-left" size="{{ size }}" />
        <twig:Molecules:Link:Base href="#" customText="With right icon" iconRight="chevron-right" size="{{ size }}" />
        <twig:Molecules:Link:Base href="#" customText="Both icons" iconLeft="chevron-left" iconRight="chevron-right" size="{{ size }}" />
        <twig:Molecules:Link:Base href="#" customText="Disabled" size="{{ size }}" disabled />
        <twig:Molecules:Link:Base href="#" customText="Disabled icon" iconLeft="chevron-left" iconRight="chevron-right" size="{{ size }}" disabled />
        <twig:Molecules:Link:Base href="https://example.com" customText="External" target="_blank" size="{{ size }}" />
    </div>
{% endmacro %}

<div class="Story">
    <div class="Story-section">
        <h4 class="Story-title">Large (default)</h4>
        {{ _self.row(null) }}
    </div>
    <div class="Story-section">
        <h4 class="Story-title">Medium</h4>
        {{ _self.row('medium') }}
    </div>
    <div class="Story-section">
        <h4 class="Story-title">Small</h4>
        {{ _self.row('small') }}
    </div>
</div>
