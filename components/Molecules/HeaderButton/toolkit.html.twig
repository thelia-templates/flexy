<div class="Story">
    <div class="Story-section">
        <h4 class="Story-title">Colors</h4>
        <div class="Story-bar">
            <twig:Molecules:HeaderButton:Base icon="heart-fill" text="Wishlist" color="light" />
            <twig:Molecules:HeaderButton:Base icon="account" text="Login" color="theme" />
            <twig:Molecules:HeaderButton:Base icon="cart" text="Cart" color="dark" />
        </div>
    </div>

    <div class="Story-section">
        <h4 class="Story-title">With subtext</h4>
        <div class="Story-bar">
            <twig:Molecules:HeaderButton:Base icon="cart" text="Cart" subText="(€2,000.00)" color="dark" />
        </div>
    </div>

    <div class="Story-section">
        <h4 class="Story-title">Small (text hidden from md)</h4>
        <div class="Story-bar">
            <twig:Molecules:HeaderButton:Base icon="menu" text="Menu" color="light" small="true" />
        </div>
    </div>

    <div class="Story-section">
        <h4 class="Story-title">Link (href)</h4>
        <div class="Story-bar">
            <twig:Molecules:HeaderButton:Base href="#" icon="account" text="My account" color="theme" />
        </div>
    </div>
</div>
