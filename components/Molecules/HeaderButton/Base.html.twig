{% props
    icon = null,
    color = null,
    small = false,
    subText = null,
%}
{% set headerButton = html_cva(
    base: 'HeaderButton',
    variants: {
        color: {
            dark: 'HeaderButton--dark',
            light: 'HeaderButton--light',
            theme: 'HeaderButton--theme',
        },
        small: {
            true: 'HeaderButton--small',
            false: null,
        },
    },
) %}

<{{ tag }} class="{{ headerButton.apply({color, small}, attributes.render('class')) }}" {% if tag == 'button' %}type="button"{% endif %} {{ attributes.without('class') }}>
    {% if icon %}
        {{ ux_icon(icon, { class: "HeaderButton-icon" }) }}
    {% endif %}

    <span class="HeaderButton-content">
        {# Translatable, and a count glued to a word ("2 items") for the cart caller: <bdi>
           isolates the label and reads its direction off its own first strong character, so the
           figure stays in front of the noun on a right-to-left page. Inline, so the block keeps
           resolving its own text-align against the page. #}
        <span class="HeaderButton-text">
            <bdi>{{ this.text }}</bdi>
        </span>
        {% if subText %}
            {# The only caller passes the cart amount: a value, not a sentence. The class
               blockifies this span (flex item, line-clamp), so dir="ltr" goes on an inner
               inline span rather than on the box that resolves its own alignment. #}
            <span class="HeaderButton-subText">
                <span dir="ltr">{{ subText }}</span>
            </span>
        {% endif %}
    </span>
</{{ tag }}>
