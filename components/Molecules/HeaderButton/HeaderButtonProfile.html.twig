{% set menuItems = [
  { customText: "My orders"|trans, href: path('account_orders'), variant: 'white' },
  { customText: "My profile"|trans, href: path('account_index'), variant: 'white' },
  { customText: "My delivery addresses"|trans, href: path('account_addresses'), variant: 'white' },
  { customText: "Logout"|trans, href: path('customer_logout'), variant: 'white', icon: true, classes: "!justify-center !underline font-semibold" }
] %}

{% set customer = getCurrentCustomer() %}
{% set headerButtonConfig = {
  icon: 'account-logged',
  inactive: inactive|default(true),
  text: customer.firstname~' '~customer.lastname|first|upper~'.',
  classes: "HeaderNav-btn HeaderButton--theme profile w-full",
  attributes: {
    'data-action':'drawer#toggle profile#toggle'
  }
} %}

<div class="relative flex-1 h-full" {{stimulus_controller('drawer profile')}}>
	{% include '@components/Molecules/HeaderButton/HeaderButton.html.twig' with headerButtonConfig %}
	<div class="MobileDrawer md:reset-drawer" data-drawer-target="drawer">
		<div class='MobileDrawer-header'>
			<strong class="block text-center text-black h3">{{'hy_customer'|trans({"%firstname%": customer.firstname})}}</strong>
			<button class='MobileDrawer-close' type='button' data-action="drawer#close">{{ ux_icon("close") }}</button>
		</div>
		<ul class="DropdownProfile" data-profile-target="dropdown">
			{% for item in menuItems %}
				<li class="DropdownProfile-item">
					{% include '@components/Molecules/UserMenu/UserMenu.html.twig' with item %}
				</li>
			{% endfor %}
		</ul>
	</div>
</div>
