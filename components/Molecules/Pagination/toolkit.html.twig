<div class="Story">

    {# ── Default ─────────────────────────────────────────────────────────── #}

    <div class="Story-section">
        <h4 class="Story-title">Default</h4>
        <div class="Story-col">
            <span class="Story-label">100 items, 10 per page, on page 1</span>
            <twig:Molecules:Pagination:Base :totalItems="100" :itemsPerPage="10" :currentPage="1" />
        </div>
    </div>

    {# ── Middle of a large catalogue ─────────────────────────────────────── #}

    <div class="Story-section">
        <h4 class="Story-title">Large catalogue</h4>
        <div class="Story-col">
            <span class="Story-label">5000 items, 10 per page, on page 250</span>
            <twig:Molecules:Pagination:Base :totalItems="5000" :itemsPerPage="10" :currentPage="250" />
        </div>
        <div class="Story-col">
            <span class="Story-label">same, on the last page</span>
            <twig:Molecules:Pagination:Base :totalItems="5000" :itemsPerPage="10" :currentPage="500" />
        </div>
    </div>

    {# ── Bounding ────────────────────────────────────────────────────────── #}

    <div class="Story-section">
        <h4 class="Story-title">Out-of-range page numbers</h4>
        <div class="Story-col">
            <span class="Story-label">page 999 of 10 — clamped to the last page</span>
            <twig:Molecules:Pagination:Base :totalItems="100" :itemsPerPage="10" :currentPage="999" />
        </div>
        <div class="Story-col">
            <span class="Story-label">page -3 — clamped to the first page</span>
            <twig:Molecules:Pagination:Base :totalItems="100" :itemsPerPage="10" :currentPage="-3" />
        </div>
    </div>

    {# ── Nothing to page through ─────────────────────────────────────────── #}

    <div class="Story-section">
        <h4 class="Story-title">Nothing rendered</h4>
        <div class="Story-col">
            <span class="Story-label">a single page — no nav at all</span>
            <twig:Molecules:Pagination:Base :totalItems="5" :itemsPerPage="10" :currentPage="1" />
        </div>
        <div class="Story-col">
            <span class="Story-label">a page size of zero — no nav, and no division by it</span>
            <twig:Molecules:Pagination:Base :totalItems="100" :itemsPerPage="0" :currentPage="1" />
        </div>
    </div>

    {# ── With a query string ─────────────────────────────────────────────── #}

    <div class="Story-section">
        <h4 class="Story-title">Carrying a query string</h4>
        <div class="Story-col">
            <span class="Story-label">baseUrl="?sort=price" — the page parameter is appended to it</span>
            <twig:Molecules:Pagination:Base :totalItems="100" :itemsPerPage="10" :currentPage="3" baseUrl="?sort=price" />
        </div>
    </div>

</div>
