<div class="Story">

    <div class="Story-section">
        <h4 class="Story-title">First page</h4>
        <twig:Molecules:Pagination:Base totalItems="100" itemsPerPage="10" currentPage="1" />
    </div>

    <div class="Story-section">
        <h4 class="Story-title">Middle page</h4>
        <twig:Molecules:Pagination:Base totalItems="100" itemsPerPage="10" currentPage="5" />
    </div>

    <div class="Story-section">
        <h4 class="Story-title">Last page</h4>
        <twig:Molecules:Pagination:Base totalItems="100" itemsPerPage="10" currentPage="10" />
    </div>

    <div class="Story-section">
        <h4 class="Story-title">Few pages (3)</h4>
        <twig:Molecules:Pagination:Base totalItems="30" itemsPerPage="10" currentPage="2" />
    </div>

    <div class="Story-section">
        <h4 class="Story-title">Many pages — middle (page 8 of 20)</h4>
        <twig:Molecules:Pagination:Base totalItems="200" itemsPerPage="10" currentPage="8" />
    </div>

    <div class="Story-section">
        <h4 class="Story-title">With baseUrl</h4>
        <twig:Molecules:Pagination:Base totalItems="50" itemsPerPage="10" currentPage="3" baseUrl="/catalog/category/shoes" />
    </div>

    <div class="Story-section">
        <h4 class="Story-title">Single page — hidden (totalPages = 1)</h4>
        <twig:Molecules:Pagination:Base totalItems="8" itemsPerPage="10" currentPage="1" />
        <span class="Story-label">(nothing rendered when only 1 page)</span>
    </div>

</div>
