{# @prop totalItems int Total number of items to page through #}
{# @prop itemsPerPage int Items shown on one page. Below 1, nothing is rendered #}
{# @prop currentPage int Page to mark as current. Bounded to the available pages #}
{# @prop baseUrl string|null Query string the page parameter is appended to, opening with `?` #}
{% if this.totalPages > 1 %}
    <nav class="Pagination" aria-label="{{ 'Pagination'|trans }}">
        <ul class="Pagination-list">
            {% if this.current > 1 %}
                <li class="mr-3">
                    <twig:Molecules:Button:Base
                        text="{{ 'Previous'|trans }}"
                        icon_left="chevron-left"
                        color="minimal"
                        href="{{ this.url(this.current - 1) }}"
                        rel="prev"
                        aria-label="{{ 'Previous page'|trans }}"
                    />
                </li>
            {% endif %}

            {% for entry in this.trail %}
                {% if entry.gap %}
                    <li class="Pagination-gap" aria-hidden="true">&hellip;</li>
                {% endif %}
                <li>
                    {% if entry.page == this.current %}
                        <span class="Pagination-item Pagination-item--active" aria-current="page">{{ entry.page }}</span>
                    {% else %}
                        <a href="{{ this.url(entry.page) }}" class="Pagination-item">{{ entry.page }}</a>
                    {% endif %}
                </li>
            {% endfor %}

            {% if this.current < this.totalPages %}
                <li class="ml-3">
                    <twig:Molecules:Button:Base
                        text="{{ 'Next'|trans }}"
                        icon_right="chevron-right"
                        color="minimal"
                        href="{{ this.url(this.current + 1) }}"
                        rel="next"
                        aria-label="{{ 'Next page'|trans }}"
                    />
                </li>
            {% endif %}
        </ul>
    </nav>
{% endif %}
