<div class="Story">
    <div class="Story-section">
        <h4 class="Story-title">container-l</h4>

        <div class="Layout-ruler Layout-ruler--l">
            <span class="Layout-rulerLabel">max-width 1366px</span>
        </div>

        <div class="Layout-viewport Layout-viewport--l">
            <div class="container-l Layout-slot">
                <div class="Layout-block"></div>

                <div class="Layout-gutter Layout-gutter--start">
                    <span class="Layout-gutterValue--sm">24px</span>
                    <span class="Layout-gutterValue--md">52px</span>
                    <span class="Layout-gutterValue--lg">80px</span>
                </div>
                <div class="Layout-gutter Layout-gutter--end">
                    <span class="Layout-gutterValue--sm">24px</span>
                    <span class="Layout-gutterValue--md">52px</span>
                    <span class="Layout-gutterValue--lg">80px</span>
                </div>
            </div>
        </div>
    </div>

    <div class="Story-section">
        <h4 class="Story-title">container-m</h4>

        <div class="Layout-ruler Layout-ruler--m">
            <span class="Layout-rulerLabel">max-width 540px</span>
        </div>

        <div class="Layout-viewport Layout-viewport--m">
            <div class="container-m Layout-slot">
                <div class="Layout-block"></div>

                <div class="Layout-gutter Layout-gutter--narrow Layout-gutter--start">24px</div>
                <div class="Layout-gutter Layout-gutter--narrow Layout-gutter--end">24px</div>
            </div>
        </div>
    </div>

    <div class="Story-section">
        <h4 class="Story-title">container-s</h4>

        <div class="Layout-ruler Layout-ruler--s">
            <span class="Layout-rulerLabel">max-width 400px</span>
        </div>

        <div class="Layout-viewport Layout-viewport--s">
            <div class="container-s Layout-slot">
                <div class="Layout-block"></div>

                <div class="Layout-gutter Layout-gutter--narrow Layout-gutter--start">24px</div>
                <div class="Layout-gutter Layout-gutter--narrow Layout-gutter--end">24px</div>
            </div>
        </div>
    </div>

    <div class="Story-section">
        <div class="Story-heading">
        <h4 class="Story-title">container-double-1</h4>
            <p class="Story-note">
                Checkout tunnel. The 1st/2nd child is the full column — background-styleable, here
                only B has one — and needs one nested wrapper div for the centered fixed-width content.
            </p>
        </div>

        <div class="Layout-viewport">
            <div class="container-double-1">
                <div>
                    <div class="Layout-block">A — 444px / 540px</div>
                </div>
                <div class="Layout-column">
                    <div class="Layout-block Layout-block--alt">B — 328px / 400px</div>
                </div>
            </div>
        </div>
    </div>

    <div class="Story-section">
        <div class="Story-heading">
        <h4 class="Story-title">container-double-2</h4>
            <p class="Story-note">Category page.</p>
        </div>

        <div class="Layout-viewport">
            <div class="container-double-2">
                <div class="Layout-block">A</div>
                <div class="Layout-block Layout-block--alt">B</div>
            </div>
        </div>

        <div class="Layout-viewport">
            <div class="container-double-2">
                <div class="Layout-block Layout-block--alt">B alone — should stay centered</div>
            </div>
        </div>
    </div>

    <div class="Story-section">
        <div class="Story-heading">
        <h4 class="Story-title">container-double-3</h4>
            <p class="Story-note">Text content page.</p>
        </div>

        <div class="Layout-viewport">
            <div class="container-double-3">
                <div class="Layout-block">A — 406/496/676px</div>
                <div class="Layout-block Layout-block--alt">B — 206/280/350px</div>
            </div>
        </div>

        <div class="Layout-viewport">
            <div class="container-double-3">
                <div class="Layout-block">A alone — should stay centered</div>
            </div>
        </div>
    </div>

    <div class="Story-section">
        <div class="Story-heading">
        <h4 class="Story-title">container-single-3</h4>
            <p class="Story-note">
                Single-column text content page (e.g. FAQ). Matches container-double-3's slot A
                width, without its two-column wrapper.
            </p>
        </div>

        <div class="Layout-viewport">
            <div class="container-single-3">
                <div class="Layout-block">406/496/676px</div>
            </div>
        </div>
    </div>
</div>
