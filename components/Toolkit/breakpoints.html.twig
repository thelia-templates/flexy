<table class="Breakpoints">
    <thead>
        <tr>
            <th>Name</th>
            <th>rem</th>
            <th>px</th>
            <th>Category</th>
        </tr>
    </thead>
    <tbody>
        {% for breakpoint in breakpoints %}
            <tr>
                <td class="Breakpoints-name">{{ breakpoint.name }}</td>
                <td class="Breakpoints-num">{{ breakpoint.rem }}rem</td>
                <td class="Breakpoints-num">{{ breakpoint.px }}px</td>
                <td>{{ breakpoint.label ?? '—' }}</td>
            </tr>
        {% endfor %}
    </tbody>
</table>
