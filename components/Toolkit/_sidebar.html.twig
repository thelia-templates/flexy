{# Sidebar #}
<aside class="w-64 shrink-0 top-0 h-screen bg-white border-r border-medium fixed flex flex-col">
    <div class="shrink-0 bg-medium p-6">
        <p class="text-xs font-semibold uppercase tracking-widest text-grey mb-1">Toolkit</p>
        <h1 class="Toolkit-logo mb-4">
            <img src="{{ asset('images/logo.png') }}" alt="Flexy design system">
        </h1>

        <select {{ stimulus_target('Toolkit--preview', 'select') }} {{ stimulus_action('Toolkit--preview', 'setWidth', 'change') }}
                class="w-full text-xs border border-base rounded-lg px-3 py-1 bg-white outline-dark">
            <option value="">Responsive</option>
            {% for bp in breakpoints %}
                {% if bp.label %}
                    <option value="{{ bp.px }}">{{ bp.label }} ({{ bp.px }}px)</option>
                {% endif %}
            {% endfor %}
        </select>
    </div>

    <nav class="flex-1 overflow-y-auto space-y-6 p-6">
        {# The pages that are not components, grouped as the controller declares them. #}
        {% for group, items in sections %}
            <div>
                <p class="text-xs font-semibold uppercase tracking-widest text-base mb-2">{{ group }}</p>
                <ul class="space-y-1">
                    {% for slug, item in items %}
                        <li>
                            <a href="{{ path('toolkit_show', {slug: slug}) }}"
                               class="flex items-center gap-2 px-3 py-1.5 rounded-lg text-sm transition-colors {{ currentSlug == slug ? 'bg-grey-lightest text-black font-medium' : 'text-grey-darker hover:bg-grey-lightest hover:text-black' }}">
                                {{ item.name }}
                                {% if item.status %}
                                    <span class="Toolkit-statusMark Toolkit-statusMark--{{ item.status }}" aria-hidden="true">
                                        {{ ux_icon(item.status == 'ready' ? 'checkmark' : 'clock') }}
                                    </span>
                                    <span class="sr-only">{{ item.status }}</span>
                                {% endif %}
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        {% endfor %}

        {% for category, components in grouped %}
            <div class="mb-6">
                <p class="text-xs font-semibold uppercase tracking-widest text-base mb-2">{{ category }}</p>
                <ul class="space-y-1">
                    {% for component in components %}
                        <li>
                            <a href="{{ path('toolkit_show', {slug: component.slug}) }}"
                               class="flex items-center gap-2 px-3 py-1.5 rounded-lg text-sm transition-colors {{ currentSlug == component.slug ? 'bg-grey-lightest text-black font-medium' : 'text-grey-darker hover:bg-grey-lightest hover:text-black' }}">
                                {{ component.name }}
                                {% if component.status %}
                                    <span class="Toolkit-statusMark Toolkit-statusMark--{{ component.status }}" aria-hidden="true">
                                        {{ ux_icon(component.status == 'ready' ? 'checkmark' : 'clock') }}
                                    </span>
                                    <span class="sr-only">{{ component.status }}</span>
                                {% endif %}
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        {% endfor %}
    </nav>
</aside>
