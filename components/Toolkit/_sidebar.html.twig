{# One shape, so sections and components cannot drift apart. #}
{% macro navLink(slug, name, status, currentSlug) %}
    <li>
        <a href="{{ path('toolkit_show', {slug: slug}) }}"
           class="Toolkit-navLink"
           {% if currentSlug == slug %}aria-current="page"{% endif %}
        >
            {{ name }}
            {% if status %}
                <span class="Toolkit-statusMark Toolkit-statusMark--{{ status }}" aria-hidden="true">
                    {{ ux_icon(status == 'ready' ? 'checkmark' : 'clock') }}
                </span>
                <span class="sr-only">{{ status }}</span>
            {% endif %}
        </a>
    </li>
{% endmacro %}

<aside class="Toolkit-aside">
    <div class="Toolkit-asideHeader">
        <p class="Toolkit-asideTitle">Toolkit</p>
        <h1 class="Toolkit-brand">
            <img class="Toolkit-logo" src="{{ asset('images/logo.png') }}" alt="Flexy design system">
        </h1>

        <span class="Toolkit-selectWrap">
            <select class="Toolkit-select"
                    {{ stimulus_target('Toolkit--preview', 'select') }}
                    {{ stimulus_action('Toolkit--preview', 'setWidth', 'change') }}>
                <option value="">Responsive</option>
                {% for bp in breakpoints %}
                    {% if bp.label %}
                        <option value="{{ bp.px }}">{{ bp.label }} ({{ bp.px }}px)</option>
                    {% endif %}
                {% endfor %}
            </select>
            <span class="Toolkit-selectIcon" aria-hidden="true">{{ ux_icon('chevron-down') }}</span>
        </span>
    </div>

    <nav class="Toolkit-nav">
        {% for group, items in sections %}
            <div class="Toolkit-navGroup">
                <p class="Toolkit-navGroupTitle">{{ group }}</p>
                <ul class="Toolkit-navList">
                    {% for slug, item in items %}
                        {{ _self.navLink(slug, item.name, item.status, currentSlug) }}
                    {% endfor %}
                </ul>
            </div>
        {% endfor %}

        {% for category, components in grouped %}
            <div class="Toolkit-navGroup">
                <p class="Toolkit-navGroupTitle">{{ category }}</p>
                <ul class="Toolkit-navList">
                    {% for component in components %}
                        {{ _self.navLink(component.slug, component.name, component.status, currentSlug) }}
                    {% endfor %}
                </ul>
            </div>
        {% endfor %}
    </nav>
</aside>

{# Inline and before the first paint, or the list is seen jumping — a lazy controller fires too
   late, an eager one would ship on every shop page.

   scrollTop by hand: scrollIntoView({block: 'center'}) centers in *every* scrolling ancestor,
   so the document would scroll to no effect, carrying the main column with it. #}
<script>
    (() => {
        const nav = document.querySelector('.Toolkit-nav');
        const current = nav?.querySelector('.Toolkit-navLink[aria-current="page"]');

        if (current) {
            nav.scrollTop = current.offsetTop - nav.offsetTop - (nav.clientHeight - current.offsetHeight) / 2;
        }
    })();
</script>
