<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>Design System — Toolkit</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Roboto+Condensed:ital,wght@0,100..900;1,100..900&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}" blocking="render">
    {{ importmap('app') }}
    <style>
        html {
            scrollbar-gutter: stable;
        }
    </style>
</head>
<body class="flex min-h-screen bg-lightest text-black" {{ stimulus_controller('Toolkit--preview', {}, {previewing: 'bg-black'}) }}>

    {% if not embed %}
        {# Sidebar #}
        <aside class="w-64 shrink-0 top-0 h-screen bg-white border-r border-medium fixed flex flex-col">
            <div class="shrink-0 bg-medium p-6">
                <p class="text-xs font-semibold uppercase tracking-widest text-grey mb-1">Flexy</p>
                <h1 class="text-xl font-bold mb-4 text-dark">Design System</h1>

                <select {{ stimulus_target('Toolkit--preview', 'select') }} {{ stimulus_action('Toolkit--preview', 'setWidth', 'change') }}
                        class="w-full text-xs border border-base rounded-lg px-3 py-1 bg-white outline-dark">
                    <option value="">Responsive</option>
                    {% for bp in breakpoints %}
                        {% if bp.label %}
                            <option value="{{ bp.px }}">{{ bp.label }} ({{ bp.px }}px)</option>
                        {% endif %}
                    {% endfor %}
                </select>
            </div>

            <nav class="flex-1 overflow-y-auto space-y-6 p-6">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-widest text-base mb-2">Design tokens</p>
                    <ul class="space-y-1">
                        <li>
                            <a href="#breakpoints" {{ stimulus_action('Toolkit--preview', 'navigate', 'click') }}
                               class="block px-3 py-1.5 rounded-lg text-sm text-grey-darker hover:bg-grey-lightest hover:text-black transition-colors">
                                Breakpoints
                            </a>
                        </li>
                        <li>
                            <a href="#layout" {{ stimulus_action('Toolkit--preview', 'navigate', 'click') }}
                               class="block px-3 py-1.5 rounded-lg text-sm text-grey-darker hover:bg-grey-lightest hover:text-black transition-colors">
                                Layout
                            </a>
                        </li>
                    </ul>
                </div>

                {% for category, components in grouped %}
                    <div class="mb-6">
                        <p class="text-xs font-semibold uppercase tracking-widest text-base mb-2">{{ category }}</p>
                        <ul class="space-y-1">
                            {% for component in components %}
                                <li>
                                    <a href="#{{ component.slug }}" {{ stimulus_action('Toolkit--preview', 'navigate', 'click') }}
                                       class="block px-3 py-1.5 rounded-lg text-sm text-grey-darker hover:bg-grey-lightest hover:text-black transition-colors">
                                        {{ component.name }}
                                    </a>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endfor %}
            </nav>
        </aside>
    {% endif %}

    {# Main content #}
    <main {{ stimulus_target('Toolkit--preview', 'main') }}
          class="flex-1 py-10 px-2.5 md:px-5 lg:px-10 overflow-y-auto transition-colors{{ embed ? '' : ' ml-64' }}">

        <div {{ stimulus_target('Toolkit--preview', 'content') }} class="space-y-16">
            {% include '@Flexy/Toolkit/breakpoints.html.twig' %}
            {% include '@Flexy/Toolkit/layout.html.twig' %}

            {% for category, components in grouped %}

                <section>
                    <h2 class="text-2xl font-bold mb-8 pb-3 border-b text-base border-grey-lighter">{{ category }}</h2>

                    <div class="space-y-12">
                        {% for component in components %}
                            <div id="{{ component.slug }}">
                                <h3 class="text-lg font-semibold mb-4 text-grey-darker">{{ component.name }}</h3>

                                <div class="bg-white rounded-2xl border border-grey-lighter p-4 lg:p-8">
                                    {% include component.twigPath ignore missing %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </section>

            {% else %}
                <p class="text-grey">No toolkit files found.</p>
            {% endfor %}
        </div>

        <iframe
            hidden
            {{ stimulus_target('Toolkit--preview', 'frame') }}
            class="mx-auto block ring-1 ring-grey-lighter rounded-2xl bg-white"
            style="height: calc(100vh - 6rem);"
            title="Aperçu responsive"
        />

    </main>

</body>
</html>
