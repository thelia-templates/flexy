<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>{{ page.category ? page.category ~ ' / ' : '' }}{{ page.name }} — Toolkit</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Roboto+Condensed:ital,wght@0,100..900;1,100..900&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}" blocking="render">
    <link rel="stylesheet" href="{{ asset('styles/toolkit.css') }}" blocking="render">
    {{ importmap('app') }}
</head>
<body {{ stimulus_controller('Toolkit--preview', {}, {previewing: 'Toolkit-main--previewing'}) }}>

    {% if not embed %}
        {# CSS alone: reaching another story reopens the panel anyway, so there is no state
           worth carrying across a load. #}
        <input type="checkbox" id="toolkitSidebar" class="Toolkit-sidebarState">
        <label for="toolkitSidebar" class="Toolkit-sidebarToggle" title="Show or hide the navigation">
            <span class="Toolkit-sidebarToggleIcon">{{ ux_icon('chevron-down') }}</span>
        </label>

        {% include '@Flexy/Toolkit/_sidebar.html.twig' %}
    {% endif %}

    <main {{ stimulus_target('Toolkit--preview', 'main') }}
          class="Toolkit-main{{ embed ? '' : ' Toolkit-main--offset' }}">

        <div {{ stimulus_target('Toolkit--preview', 'content') }}>
            {% if page.standalone|default(false) %}
                {% include page.twigPath %}
            {% else %}
                {% set heading = page.category ?? page.group|default(null) %}

                <section>
                    {% if heading %}
                        <h2 class="Toolkit-sectionTitle">{{ heading }}</h2>
                    {% endif %}

                    <div {% if source %}{{ stimulus_controller('Toolkit--copy') }}{% endif %}>
                        <div class="Toolkit-storyHeader">
                            <h3 class="Toolkit-componentTitle">
                                {{ page.name }}
                                {% if page.status %}
                                    <span class="Toolkit-statusBadge Toolkit-statusBadge--{{ page.status }}">{{ page.status }}</span>
                                {% endif %}
                            </h3>

                            {% if source %}
                                <button
                                    type="button"
                                    class="Toolkit-codeToggle"
                                    aria-expanded="false"
                                    aria-controls="story-source"
                                    {{ stimulus_target('Toolkit--copy', 'toggleButton') }}
                                    {{ stimulus_action('Toolkit--copy', 'toggle', 'click') }}
                                >
                                    <span {{ stimulus_target('Toolkit--copy', 'toggleLabel') }}>Show the code</span>
                                    <span class="Toolkit-codeToggleIcon" aria-hidden="true">{{ ux_icon('chevron-down') }}</span>
                                </button>
                            {% endif %}
                        </div>

                        {% if source %}
                            <div id="story-source" class="Toolkit-codePanel" {{ stimulus_target('Toolkit--copy', 'panel') }} hidden>
                                <button type="button" class="Toolkit-codeCopy" {{ stimulus_action('Toolkit--copy', 'copy', 'click') }}>
                                    <span {{ stimulus_target('Toolkit--copy', 'copyLabel') }}>Copy</span>
                                </button>
                                <pre class="Toolkit-code"><code {{ stimulus_target('Toolkit--copy', 'source') }}>{{ source }}</code></pre>
                            </div>
                        {% endif %}
                    </div>

                    <div class="Toolkit-canvas">
                        {% include page.twigPath ignore missing %}
                    </div>
                </section>
            {% endif %}
        </div>

        <iframe
            hidden
            {{ stimulus_target('Toolkit--preview', 'frame') }}
            class="Toolkit-frame"
            title="Responsive preview"
        ></iframe>

    </main>

</body>
</html>
