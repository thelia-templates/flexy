{% extends 'base.html.twig' %}

{% block javascripts %}
	{{ parent() }}
{% endblock %}

{% block title %}
	{{'Your password has been reset!'|trans}}
{% endblock %}

{% block body %}
	<div class="w-full max-w-[400px] px-[25px] pt-[30px] pb-[54px] lg:px-0 lg:pt-[50px] lg:pb-[120px] mx-auto">
		<h1 class="mb-4 text-black h2">{{'Your password has been reset!'|trans}}</h1>
		<p class="mb-8">
			{{'You can now log in to your account.'|trans}}
		</p>
		{% include "@components/Molecules/Button/Button.html.twig" with {href: path('customer_login'), text: "Login"|trans, variant: "large", classes: "self-start" } %}
	</div>
{% endblock %}
