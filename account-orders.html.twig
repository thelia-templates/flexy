{% extends 'base.html.twig' %}

{% block title %}{{ 'My orders'|trans }}{% endblock %}

{% block body %}
    <twig:Layouts:Subheader:Account
        title="{{ 'My orders'|trans }}"
        selected="orders"
        :breadcrumb="[
            {title: 'My account'|trans, url: path('account_index')},
            {title: 'My orders'|trans},
        ]"
    />

    <div class="container-l pt-6 pb-20 md:pt-11 md:pb-30">
        {# A buyer whose role reads the orders of the company has the two lists; nobody else has a tab. #}
        {% if company_account().canViewCompanyOrders %}
            {% set onCompany = app.request.query.get('scope') == 'company' %}
            <nav aria-label="{{ 'My orders'|trans }}" class="mb-8">
                <ul class="flex flex-wrap justify-center gap-3">
                    <li>
                        <twig:Molecules:Button:Base
                            text="{{ 'My orders'|trans }}"
                            href="{{ path('account_orders', {scope: 'own'}) }}"
                            size="small"
                            color="{{ onCompany ? 'secondary' : 'base' }}"
                            {{ ...(onCompany ? {} : {'aria-current': 'page'}) }}
                        />
                    </li>
                    <li>
                        <twig:Molecules:Button:Base
                            text="{{ 'Orders of the company'|trans }}"
                            href="{{ path('account_orders', {scope: 'company'}) }}"
                            size="small"
                            color="{{ onCompany ? 'base' : 'secondary' }}"
                            {{ ...(onCompany ? {'aria-current': 'page'} : {}) }}
                        />
                    </li>
                </ul>
            </nav>
        {% endif %}

        <twig:Layouts:AccountOrders:Base />
    </div>
{% endblock %}

{% block footer %}
    <twig:Layouts:Footer:Checkout />
{% endblock %}
