<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1"/> {% block meta %}{% endblock %}
		<title>
			{% block title %}Welcome!
			{% endblock %}
		</title>
		<link rel="icon" type="image/png" href="{{asset("dist/favicons/favicon-96x96.png")}}" sizes="96x96"/>
		<link rel="icon" type="image/svg+xml" href="{{asset("dist/favicons/favicon.svg")}}"/>
		<link rel="shortcut icon" href="/favicon.ico"/>
		<link rel="apple-touch-icon" sizes="180x180" href="{{asset("dist/favicons/apple-touch-icon.png")}}"/>
		<link rel="manifest" href="{{asset("dist/favicons/site.webmanifest")}}"/>
		{% block stylesheets %}
			{{ encore_entry_link_tags('app') }}
		{% endblock %}
		{% block javascripts %}
			{{ encore_entry_script_tags('app') }}
		{% endblock %}
	</head>
	<body class="no-js">
		{% block header %}
			{% include '@components/Layout/Header/Header.html.twig' with { type: "generic" } %}
		{% endblock %}

		{% block body %}{% endblock %}

		{% block footer %}
			{% include '@components/Layout/Footer/Footer.html.twig' %}
		{% endblock %}

		{% block modals %}{% endblock %}
	</body>
</html>
