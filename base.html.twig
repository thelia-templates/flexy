{% set breadcrumb = SEOneBreadcrumb() %}
{% set logo = media_url('logo') %}
<!DOCTYPE html>
<html lang="{{ lang_code }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

        {# Title, description, canonical, hreflang and the breadcrumb JSON-LD are rendered by
           whoever answers this hook — the SEOne module does, and falls back to its own
           SEOnePage*() values for anything a page leaves unset. #}
        {{ theme_hook('layout.head.top', {
            breadcrumb,
            title:       block('title') is defined ? block('title')|trim : null,
            description: block('meta_description') is defined ? block('meta_description')|trim : null,
            og_type:     block('og_type') is defined ? block('og_type')|trim : null,
        }) }}

        {# Empty by default: pages that must not be indexed (internal search) fill it in #}
        {% block robots %}{% endblock %}

        {# Empty by default: pages whose own URL is a secret (a password reset link) use it
           to keep that URL out of the Referer header sent to whatever they link to #}
        {% block head_meta %}{% endblock %}

        {% set ogImage %}{% block og_image %}{{ logo }}{% endblock %}{% endset %}
        {% if ogImage|trim is not empty %}
            <meta property="og:image" content="{{ ogImage|trim }}">
            <meta name="twitter:image" content="{{ ogImage|trim }}">
        {% endif %}
        <meta property="og:locale" content="{{ current_locale() }}">
        <meta property="og:site_name" content="{{ attr('config', 'store_name')|default('') }}">
        <meta name="twitter:card" content="summary_large_image">

        <link rel="icon" type="image/png" href="{{ asset('favicons/favicon-96x96.png') }}" sizes="96x96"/>
        <link rel="icon" type="image/svg+xml" href="{{ asset('favicons/favicon.svg') }}"/>
        <link rel="shortcut icon" href="{{ asset('favicons/favicon.ico') }}"/>
        <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('favicons/apple-touch-icon.png') }}"/>
        <link rel="manifest" href="{{ asset('favicons/site.webmanifest') }}"/>

        <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Roboto+Condensed:ital,wght@0,100..900;1,100..900&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">

        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}" blocking="render">
        {% endblock %}


        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {{ theme_hook('layout.head.bottom', {breadcrumb}) }}
        {# Page-level schema.org payloads (WebSite, ContactPage, LocalBusiness…) #}
        {% block structured_data %}{% endblock %}
    </head>

    <body class="no-js {% block body_class %}{% endblock %}">
        {{ theme_hook('layout.body.top') }}
        {% block header %}
            <twig:Layouts:Header:Base />
        {% endblock %}
        {{ theme_hook('layout.header.bottom') }}

        <main {% block stimulus_controller %}{% endblock %}>
            {% block body %}{% endblock %}
        </main>

        {{ theme_hook('layout.footer.top') }}
        {% block footer %}
            <twig:Layouts:Footer:Base />
        {% endblock %}

        {% block modals %}{% endblock %}
        {{ theme_hook('layout.body.bottom') }}
    </body>
</html>
