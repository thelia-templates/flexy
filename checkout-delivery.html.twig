{% extends 'checkout-base.html.twig' %}

{% block title %}
    {{ 'Delivery'|trans }}
{% endblock %}

{% block checkoutContent %}
    {{ component('Flexy:Checkout:Delivery') }}
{% endblock %}

{% block checkoutBackButton %}
    {{ include('@components/Molecules/Link/Link.html.twig', {
        iconLeft: 'chevron-left',
        customText: 'Previous Step'|trans,
        href: path('checkout_cart'),
        classes: 'gap-2',
    }) }}
{% endblock %}

{%- block checkoutSummary -%}
    {%- if not emptyCart -%}
        {{ component('Flexy:Checkout:Summary') }}
    {%- endif -%}
{%- endblock -%}

{%- block checkoutNextButton -%}
    {%- if not emptyCart -%}
        {{ component('Flexy:Checkout:NextButton', {
            href: path('checkout_payment'),
            step: constant('FlexyBundle\\UiComponents\\Checkout\\CheckoutSteps\\CheckoutSteps::DELIVERY'),
        }) }}
    {%- endif -%}
{%- endblock -%}
