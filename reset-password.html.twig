{% extends 'base.html.twig' %}

{% block title %}{{ 'Reset your password'|trans }}{% endblock %}

{% block robots %}<meta name="robots" content="noindex, nofollow">{% endblock %}

{# The link in the address bar is what gives access to the account: keep it out of the
   Referer header this page would otherwise send to everything it links to. #}
{% block head_meta %}<meta name="referrer" content="no-referrer">{% endblock %}

{% block body %}
    <div class="container-s pt-8 pb-14 lg:pt-12 lg:pb-30">
        <h2 class="h2 text-black mb-4">{{ 'Reset your password'|trans }}</h2>

        {% if not token_is_valid %}
            <twig:Molecules:SnackBar:Base variant="error" text="{{ 'This link cannot be used any more. Links expire shortly after they are sent, and can only be used once.'|trans }}" />

            <p class="paragraph-2 text-black mt-6 mb-6">{{ 'Ask for a new one and follow the link in the e-mail you receive.'|trans }}</p>

            <twig:Molecules:Button:Base href="{{ path('password_forgotten') }}" text="{{ 'Ask for a new link'|trans }}" />
        {% else %}
            {% set form = getForm('thelia_customer_reset_password') %}
            {% form_theme form with flexy_form_themes only %}

            {% for error in form.vars.errors %}
                <twig:Molecules:SnackBar:Base variant="error" text="{{ error.message }}" />
            {% endfor %}

            <p class="paragraph-2 text-black mb-6">{{ 'Choose the password you will use from now on.'|trans }}</p>

            {{ form_start(form, {attr: {
                action: path('password_reset_action', {token: token}),
                method: 'POST',
                class: 'flex flex-col gap-6',
            }}) }}
            {{ form_row(form.success_url, {value: path('password_reset_confirm')}) }}
            {{ form_row(form.error_url, {value: path('password_reset', {token: token})}) }}
            {{ form_row(form.token, {value: token}) }}
            {{ form_row(form.password, {label: 'New password'|trans, placeholder: 'Your new password'|trans}) }}
            {{ form_row(form.password_confirm, {label: 'Confirm your new password'|trans, placeholder: 'Your new password again'|trans}) }}

            <twig:Molecules:Button:Base text="{{ 'Reset password'|trans }}" type="submit" class="w-max" />
            {{ form_end(form) }}
        {% endif %}

        <hr class="my-10" />

        <twig:Molecules:Link:Base href="{{ path('customer_login') }}" customText="{{ 'Back to login'|trans }}" />
    </div>
{% endblock %}
