{% extends 'base.html.twig' %}

{% block title %}
    {{ 'My order'|trans }}
{% endblock %}

{% block body %}
    {% set order = resources('/api/front/account/orders/' ~ orderId) %}
    <main>
        {{ component('Flexy:Button', {
          text: 'My orders'|trans,
          href: '/account/orders',
          color: 'minimal',
          icon_left: 'chevron-left',
          class: 'mt-2 lg:mt-6 lg:ml-5',
        }) }}

        <div class="lg:w-[540px] mx-6 lg:mx-auto mt-8 lg:mt-4 mb-[56px] md:mb-[94px]">
            <div class="text-black h3">
                {{ 'Order N°'|trans }}
                {{ order.ref }}
            </div>
            <p class="p3 mb-[26px] lg:mb-[44px]">
                {{ order.createdAt|format_date() }}
            </p>

            {{ component('Flexy:DeliveryTracking', {
                ref: order.ref,
                status: 1,
                trackLink: '#0'
            }) }}

            <div class="h4 mb-6 mt-[62px]">
                {{ 'Order details'|trans }}
            </div>
            <div class="flex flex-col gap-2">
                {% for orderProduct in order.orderProducts %}
                    {{ component('Flexy:OrderProductCard',{orderProduct}) }}
                {% endfor %}
                {% set summary = {
                    'Delivery' : order.totalShippingWithTaxes,

                    'Discount': order.amountDiscountWithTaxes
                } %}
                <div class="Summary">
                    <ul class="Summary-list">
                        {% for key, value in summary %}
                            {% if value %}
                                <li class="Summary-line">
                                    <b>{{ key|trans }}</b><div>{{ value|format_currency('EUR', locale: lang_code) }}</div>
                                </li>
                            {% endif %}
                        {% endfor %}
                    </ul>
                    <div class="Summary-footer">
                        <div class="Summary-total">
                            <div>
                                {{ 'Total (including VAT)'|trans }}
                            </div>
                            <div>
                                {{ (order.totalAmount)|format_currency('EUR', locale: lang_code) }}
                            </div>
                        </div>
                        <div class="italic">
                            {{ 'Taxes of'|trans }}
                            {{ (order.totalAmount - order.totalAmountWithoutTaxes)|format_currency('EUR', locale: lang_code) }}
                            {{ 'included'|trans }}
                        </div>
                    </div>
                </div>
            </div>
            <hr class="mt-[55px] lg:mt-[72px] mb-[30px] lg:mb-[54px]"/>
            <div class="mb-6 h4">
                {{ 'Delivery & payment'|trans }}
            </div>
            <div class="flex flex-col gap-2">
                {{ component('Flexy:AddressCard', {
                    addressId: order.deliveryOrderAddress.id,
                    title: 'Delivery address'|trans,
                    inOrder: true,
                }) }}
                {{ component('Flexy:AddressCard', {
                    addressId: order.invoiceOrderAddress.id,
                    title: 'Billing address'|trans,
                    inOrder: true,
                }) }}
                {% set paymentModule = resources('/api/front/modules/' ~ order.paymentModule.id) %}
            </div>
        </div>
    </main>
{% endblock %}

{% block footer %}
    {{ include('@components/Layout/Footer/FooterCheckout.html.twig') }}
{% endblock %}
