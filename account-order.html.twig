{% extends 'base.html.twig' %}

{% set order = resources('/api/front/account/orders/' ~ orderId) %}
{% set statusCode = order.orderStatus.code %}
{% set isQuotation = statusCode == 'quotation' %}
{% set isClosed = statusCode in ['canceled', 'refunded'] %}
{% set heading = (isQuotation ? 'Quote N°' : 'Order N°')|trans ~ ' ' ~ order.ref %}

{% block title %}{{ heading }}{% endblock %}

{% block body %}
    {{ theme_hook('account-order.top', {order: order}) }}

    <div class="pt-2 pb-3 md:pt-5 md:pl-5">
        <twig:Molecules:Breadcrumb:Base :items="[
            {title: 'My account'|trans, url: path('account_index')},
            {title: 'My orders'|trans, url: path('account_orders')},
            {title: heading},
        ]" />
    </div>

    <div class="container-m pb-14 md:pb-24">
        <h1 class="h3 text-black">{{ heading }}</h1>
        <p class="paragraph-3 mb-6 lg:mb-11">{{ order.createdAt|format_date() }}</p>

        {% if not isQuotation and not isClosed %}
            <twig:Organisms:DeliveryTracking:Base
                statusCode="{{ statusCode }}"
                trackingRef="{{ order.deliveryRef }}"
            />
        {% endif %}

        <h2 class="h4 mt-10 mb-6">{{ (isQuotation ? 'Quote details' : 'Order details')|trans }}</h2>

        <div class="flex flex-col gap-2">
            <twig:Layouts:OrderProducts:Base :orderProducts="order.orderProducts" :order="order" />

            <twig:Organisms:Summary:Order :order="order" />
        </div>

        {# What the buyer wrote for whoever receives the parcel, read back off the order.
           `default(null)` keeps a core whose payload predates the feature from breaking
           the page over a property it does not publish. #}
        {% if order.giftMessage|default(null) %}
            <div class="mt-6">
                <h3 class="paragraph-2 text-black">{{ 'Message for the recipient'|trans }}</h3>
                <p class="paragraph-3 whitespace-pre-line">{{ order.giftMessage }}</p>
            </div>
        {% endif %}

        {% if not isQuotation %}
            <hr class="my-10" />

            <h2 class="h4 mb-6">{{ 'Delivery & payment'|trans }}</h2>
            <div class="flex flex-col gap-2">
                <twig:Organisms:AddressCard:Base
                    :addressId="order.deliveryOrderAddress.id"
                    title="{{ 'Delivery address'|trans }}"
                    :inOrder="true"
                />
                <twig:Organisms:AddressCard:Base
                    :addressId="order.invoiceOrderAddress.id"
                    title="{{ 'Billing address'|trans }}"
                    :inOrder="true"
                />
            </div>
        {% endif %}

        {# The core refuses an invoice for an order that is not paid, so the link would
           dead-end on a 404. Mirrors Thelia's own isPaid() status set. #}
        {% if isQuotation or statusCode in ['paid', 'processing', 'sent'] %}
            <twig:Molecules:Button:Base
                text="{{ (isQuotation ? 'Download quote' : 'Download invoice')|trans }}"
                href="{{ isQuotation
                    ? path('account_order_pdf_quotation', {orderId: order.id})
                    : path('account_order_pdf_invoice', {orderId: order.id}) }}"
                icon_right="download"
                class="mt-8"
            />
        {% endif %}

        {# Returns. The component answers for itself: it renders nothing when the shop has
           the feature off, when there is nothing left to return and no return was ever
           opened, so the separator comes from inside it rather than from here. #}
        <twig:Organisms:OrderReturn:Block :orderId="order.id" class="mt-10 pt-10 border-t border-grey-lighter" />
    </div>

    {{ theme_hook('account-order.bottom', {order: order}) }}
{% endblock %}

{% block footer %}
    <twig:Layouts:Footer:Checkout />
{% endblock %}
