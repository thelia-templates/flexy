{% extends 'base.html.twig' %}

{% set order = resources('/api/front/account/orders/' ~ orderId) %}
{% set statusCode = order.orderStatus.code %}
{% set isQuotation = statusCode == 'quotation' %}
{# A custom status declared equivalent to "canceled" or "refunded" closes the order too. #}
{% set isClosed = (order.orderStatus.equivalentCode|default(null) ?: statusCode) in ['canceled', 'refunded'] %}
{# `heading` is the plain-text spelling, for the <title> and the breadcrumb: both are text slots
   where an isolation would either not render or pollute the structured data. Wherever the
   reference is rendered as markup it is isolated instead - see the <h1> below. A reference that
   begins or ends with a neutral character (#, /, -) is reordered without it. #}
{% set heading = (isQuotation ? 'Quote N°' : 'Order N°')|trans ~ ' ' ~ order.ref %}

{% block title %}{{ heading }}{% endblock %}

{% block body %}
    {{ theme_hook('account-order.top', {order: order}) }}

    <div class="pt-2 pb-3 md:pt-5 md:ps-5">
        <twig:Molecules:Breadcrumb:Base :items="[
            {title: 'My account'|trans, url: path('account_index')},
            {title: 'My orders'|trans, url: path('account_orders')},
            {title: heading},
        ]" />
    </div>

    <div class="container-m pb-14 md:pb-24">
        <h1 class="h3 text-black">{{ (isQuotation ? 'Quote N°' : 'Order N°')|trans }} <span dir="ltr">{{ order.ref }}</span></h1>
        <p class="paragraph-3 mb-6 lg:mb-11"><bdi>{{ order.createdAt|format_date() }}</bdi></p>

        {# The parcels the order left in, oldest first, a cancelled draft never counted.
           `default([])` keeps a core whose payload predates shipments from breaking the page. #}
        {% set shipments = (order.orderShipments|default([]))|filter(shipment => shipment.status|default('') != 'cancelled') %}

        {% if not isQuotation and not isClosed %}
            {% if shipments|length > 1 %}
                {# Several parcels: one card each, with its own lines, number and delivery note. #}
                <div class="flex flex-col gap-4" data-testid="order-shipments">
                    {% for shipment in shipments %}
                        {{ theme_hook('account-order.shipment.top', {order: order, shipment: shipment}) }}
                        <twig:Organisms:Shipment:Base
                            :shipment="shipment"
                            :position="loop.index"
                            :total="shipments|length"
                            deliveryNoteUrl="{{ path('account_order_pdf_delivery_shipment', {orderId: order.id, shipmentId: shipment.id}) }}"
                        />
                        {{ theme_hook('account-order.shipment.bottom', {order: order, shipment: shipment}) }}
                    {% endfor %}
                    {# What no parcel has taken yet, after the parcels: nothing when everything left. #}
                    <twig:Organisms:Shipment:Remaining :order="order" />
                </div>
            {% else %}
                {# One parcel, or none yet: the tracker the page always had, fed by that parcel
                   when there is one, by the order itself otherwise. #}
                {% set parcel = shipments|length > 0 ? shipments|first : null %}
                <twig:Organisms:DeliveryTracking:Base
                    statusCode="{{ statusCode }}"
                    trackingRef="{{ parcel ? parcel.deliveryRef|default('') : order.deliveryRef }}"
                    :trackLink="parcel ? parcel.trackingUrl|default(null) : order.deliveryTrackingUrl|default(null)"
                />
                {# A first parcel that left part of the order: what it owes, under the tracker.
                   Nothing before a parcel exists, nothing once the only parcel took everything. #}
                <twig:Organisms:Shipment:Remaining :order="order" class="mt-4" />
            {% endif %}
        {% endif %}

        {# What the shop wrote for this customer, above the order itself: a message about a
           delayed parcel or a missing size is read before the lines it talks about. The
           component answers for itself and renders nothing when there is no message, so
           the spacing travels with it. #}
        <twig:Organisms:OrderNotes:Block :orderId="order.id" class="mt-10" />

        <h2 class="h4 mt-10 mb-6">{{ (isQuotation ? 'Quote details' : 'Order details')|trans }}</h2>

        <div class="flex flex-col gap-2">
            <twig:Layouts:OrderProducts:Base :orderProducts="order.orderProducts" :order="order" />

            <twig:Organisms:Summary:Order :order="order" />
        </div>

        {# What the buyer wrote for whoever receives the parcel, read back off the order.
           `default(null)` keeps a core whose payload predates the feature from breaking
           the page over a property it does not publish. #}
        {% if order.giftMessage|default(null) %}
            <div class="mt-6">
                <h3 class="paragraph-2 text-black">{{ 'Message for the recipient'|trans }}</h3>
                <p class="paragraph-3 whitespace-pre-line">{{ order.giftMessage }}</p>
            </div>
        {% endif %}

        {% if not isQuotation %}
            <twig:Organisms:SaveToPurchaseList:Base
                action="{{ path('account_purchase_list_from_order', {orderId: order.id}) }}"
                defaultTitle="{{ 'Order %ref%'|trans({'%ref%': order.ref}) }}"
                class="mt-6"
            />
        {% endif %}

        {% if not isQuotation %}
            <hr class="my-10" />

            <h2 class="h4 mb-6">{{ 'Delivery & payment'|trans }}</h2>
            {% if order.deliveryDate is defined and order.deliveryDate %}
                <p class="paragraph-3 mb-4" data-testid="order-delivery-date">
                    {{ 'Requested delivery'|trans }}: <strong>{{ order.deliveryDate|format_date('full') }}</strong>
                    {% if order.deliverySlotStart is defined and order.deliverySlotStart %}
                        <span dir="ltr">{{ 'from %start% to %end%'|trans({'%start%': order.deliverySlotStart, '%end%': order.deliverySlotEnd ?? ''}) }}</span>
                    {% endif %}
                </p>
            {% endif %}
            <div class="flex flex-col gap-2">
                <twig:Organisms:AddressCard:Base
                    :addressId="order.deliveryOrderAddress.id"
                    title="{{ 'Delivery address'|trans }}"
                    :inOrder="true"
                />
                <twig:Organisms:AddressCard:Base
                    :addressId="order.invoiceOrderAddress.id"
                    title="{{ 'Billing address'|trans }}"
                    :inOrder="true"
                />
            </div>
        {% endif %}

        {# The core refuses an invoice for an order that is not paid, so the link would
           dead-end on a 404. Mirrors Thelia's own isPaid() status set. #}
        {% if isQuotation or statusCode in ['paid', 'processing', 'sent'] %}
            <twig:Molecules:Button:Base
                text="{{ (isQuotation ? 'Download quote' : 'Download invoice')|trans }}"
                href="{{ isQuotation
                    ? path('account_order_pdf_quotation', {orderId: order.id})
                    : path('account_order_pdf_invoice', {orderId: order.id}) }}"
                icon_right="download"
                class="mt-8"
            />
        {% endif %}

        {# Returns. The component answers for itself: it renders nothing when the shop has
           the feature off, when there is nothing left to return and no return was ever
           opened, so the separator comes from inside it rather than from here. #}
        <twig:Organisms:OrderReturn:Block :orderId="order.id" class="mt-10 pt-10 border-t border-grey-lighter" />
    </div>

    {{ theme_hook('account-order.bottom', {order: order}) }}
{% endblock %}

{% block footer %}
    <twig:Layouts:Footer:Checkout />
{% endblock %}
