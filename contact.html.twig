{% extends 'base.html.twig' %}

{% block structured_data %}
    {{ SEOneContactPage() }}
    {{ SEOneBreadcrumbList([
        { name: attr('config', 'store_name'), url: absolute_url(path('index')) },
        { name: 'Contact'|trans, url: SEOnePageCanonical() },
    ]) }}
    {{ SEOneLocalBusiness(logo) }}
{% endblock %}

{% block title %}{{ 'Contact'|trans }}{% endblock %}

{% block body %}
    <div class="relative p-5">
        <twig:Molecules:Breadcrumb:Base :items="[{title: 'Contact'|trans}]" />
    </div>

    <div class="container-s pt-8 pb-14 lg:pt-12 lg:pb-30">
        {% set form = getForm('thelia.front.contact') %}
        {% form_theme form with flexy_form_themes only %}

        {% block contactFormTitle %}
            <h1 class="mb-4 h2">{{ 'Contact Us'|trans }}</h1>
        {% endblock %}

        {% block contactForm %}
            {{ form_start(form, {attr: {class: 'flex flex-col gap-4'}}) }}

            {# RGAA 11.13: the purpose of the name field is declared for autofill. #}
            {{ form_row(form.name, {attr: {autocomplete: 'name'}}) }}
            {{ form_rest(form) }}

            <twig:Molecules:Button:Base
                text="{{ 'Send'|trans }}"
                type="submit"
                class="w-max max-w-full mt-6"
            />

            {{ form_end(form) }}
        {% endblock %}
    </div>
{% endblock %}
