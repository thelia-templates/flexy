{% extends 'contact.html.twig' %}

{% block contactFormTitle %}
    <div class="my-12 mb-12 text-center">
        <h2 class="mb-4 h2">{{ 'Thanks !'|trans }}</h2>
    </div>
{% endblock %}

{% block contactForm %}
    <div class="my-12 mb-12 flex flex-col items-center gap-6 text-center">
        <p class="text-lg font-medium">{{ 'Thanks for your message, we will contact you as soon as possible.'|trans }}</p>

        <twig:Molecules:Button:Base
            text="{{ 'Homepage'|trans }}"
            href="/"
            icon_left="chevron-left"
        />
    </div>
{% endblock %}
