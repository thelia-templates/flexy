{% extends 'checkout-base.html.twig' %}

{% block title %}
    {{ 'Cart'|trans }}
{% endblock %}

{% block checkoutContent %}
    {{ theme_hook('cart.top') }}
    {{ component('Flexy:Checkout:Cart') }}
    {{ theme_hook('cart.bottom') }}
{% endblock %}

{%- block checkoutSummary -%}
    {%- if not emptyCart -%}
        {{ component('Flexy:Checkout:Summary') }}
    {%- endif -%}
{%- endblock -%}

{%- block checkoutNextButton -%}
    {%- if not emptyCart -%}
        {{ component('Flexy:Checkout:NextButton', {
            href: path('checkout_delivery'),
            step: constant('FlexyBundle\\UiComponents\\Checkout\\CheckoutSteps\\CheckoutSteps::CART'),
        }) }}
    {%- endif -%}
{%- endblock -%}
