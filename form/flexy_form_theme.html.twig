{% use 'form_div_layout.html.twig' %}

{# ROW — label/error are rendered by the widget components themselves, no extra wrapper needed #}

{%- block form_row -%}
    {{- form_widget(form) -}}
{%- endblock form_row -%}

{% block form_errors %}{% endblock form_errors %}

{# WIDGETS #}

{%- block form_widget_simple -%}
    {%- set type = type|default('text') -%}
    {% if type in ['range', 'file', 'hidden'] %}
        <input type="{{ type }}" {{ block('widget_attributes') }} {% if value is not empty %}value="{{ value }}"{% endif %}/>
    {% else %}
        {{ component('Fields:Input:Base', {
            label: label,
            name: full_name,
            id: id,
            type: type,
            value: value,
            placeholder: placeholder ?? attr.placeholder ?? null,
            error: errors|first.message|default(false),
            disabled: disabled,
            required: required,
            help: help ?? null,
        }) }}
    {% endif %}
{%- endblock form_widget_simple -%}

{%- block password_widget -%}
    {{ component('Fields:Input:Password', {
        label: label,
        name: full_name,
        id: id,
        value: value,
        placeholder: placeholder ?? attr.placeholder ?? null,
        error: errors|first.message|default(false),
        disabled: disabled,
        required: required,
        help: help ?? null,
        showCriteria: attr.password_control|default(false),
    }) }}
{%- endblock password_widget -%}

{%- block textarea_widget -%}
    {{ component('Fields:TextArea:Base', {
        label: label,
        name: full_name,
        id: id,
        value: value,
        placeholder: placeholder ?? attr.placeholder ?? null,
        error: errors|first.message|default(false),
        disabled: disabled,
        required: required,
        help: help ?? null,
    }) }}
{%- endblock textarea_widget -%}

{%- block choice_widget_collapsed -%}
    {% set choicesList = [] %}
    {% for group_label, choice in choices %}
        {% set choicesList = choicesList|merge([{value: choice.value, label: choice.label|trans}]) %}
    {% endfor %}
    {{ component('Fields:Select:Base', {
        label: label,
        choices: choicesList,
        value: value,
        placeholder: placeholder ?? null,
        error: errors|first.message|default(false),
        disabled: disabled,
        help: help ?? null,
        'select:name': full_name,
    }) }}
{%- endblock choice_widget_collapsed -%}

{%- block choice_widget_expanded -%}
    <div class="flex flex-col gap-2">
        {%- for child in form %}
            {{- form_row(child) -}}
        {% endfor -%}
    </div>
{%- endblock choice_widget_expanded -%}

{%- block checkbox_widget -%}
    {{ component('Fields:Checkbox:Base', {
        label: label,
        error: errors|first.message|default(false),
        required: required,
        'input:name': full_name,
        'input:value': value,
        'input:checked': checked,
    }) }}
{%- endblock checkbox_widget -%}

{%- block radio_widget -%}
    {{ component('Fields:Checkbox:Base', {
        type: 'radio',
        label: label,
        error: errors|first.message|default(false),
        required: required,
        'input:name': full_name,
        'input:value': value,
        'input:checked': checked,
    }) }}
{%- endblock radio_widget -%}

{%- block submit_widget -%}
    {{ component('Molecules:Button:Base', {
        text: label,
        type: 'submit',
    }) }}
{%- endblock submit_widget -%}

{# PRODUCT FILTERS — fed by FlexyBundle\Service\FormService, consumed by Layouts/ProductListing.
   Each filter is a collapsible section; the CSS for .Fieldset/.FilterAccordion lives with that component. #}

{%- block pill_widget -%}
    {# `Accordion:Item` takes a `value` prop, which shadows this widget's own `value` var inside the
       component's slots. Aliased here so the selected-state tests below can't read the item id
       instead — `in` against that string would silently do a substring match. #}
    {% set selectedValues = value %}
    {% if choices|length %}
        <twig:Molecules:Accordion:Base id="{{ id }}-accordion">
            <twig:Molecules:Accordion:Item
                value="{{ id }}"
                :open="choices|filter(choice => choice.value in selectedValues)|length > 0"
                class="FilterAccordion"
            >
                <twig:Molecules:Accordion:Trigger iconClosed="plus" iconOpen="minus" class="paragraph-2 py-3">
                    {{ label|trans }}
                </twig:Molecules:Accordion:Trigger>
                <twig:Molecules:Accordion:Content>
                    <ul class="flex flex-wrap gap-2">
                        {% for choice in choices %}
                            <li>
                                {{ component('Molecules:FilterPill:Base', {
                                    label: choice.label|trans,
                                    count: choice.attr['data-count']|default(null),
                                    close: true,
                                    color: attr.colors[choice.value]|default(null),
                                    'input:name': full_name,
                                    'input:value': choice.value,
                                    'input:checked': choice.value in selectedValues,
                                }) }}
                            </li>
                        {% endfor %}
                    </ul>
                </twig:Molecules:Accordion:Content>
            </twig:Molecules:Accordion:Item>
        </twig:Molecules:Accordion:Base>
    {% endif %}
{%- endblock pill_widget -%}

{%- block fieldset_row -%}
    {% set attr = attr|merge({class: (attr.class|default('') ~ ' Fieldset')|trim}) %}
    <fieldset {{ block('attributes') }}>
        {% if label %}
            <legend class="{{ ('Fieldset-legend ' ~ form.vars.label_attr.class|default(''))|trim }}">{{ label|trans }}</legend>
        {% endif %}
        <ul class="Fieldset-group">
            {% for child in form %}
                <li>{{ form_row(child) }}</li>
            {% endfor %}
        </ul>
    </fieldset>
{%- endblock fieldset_row -%}

{%- block range_group_row -%}
    <twig:Molecules:Accordion:Base id="{{ id }}-accordion">
        <twig:Molecules:Accordion:Item value="{{ id }}" class="FilterAccordion">
            <twig:Molecules:Accordion:Trigger iconClosed="plus" iconOpen="minus" class="paragraph-2 py-3">
                {{ label|trans }}
            </twig:Molecules:Accordion:Trigger>
            <twig:Molecules:Accordion:Content>
                <twig:Fields:RangeSlider:Base
                    nameMin="{{ form.min.vars.full_name }}"
                    nameMax="{{ form.max.vars.full_name }}"
                    :min="form.min.vars.attr.min"
                    :max="form.max.vars.attr.max"
                    :valueMin="form.min.vars.value"
                    :valueMax="form.max.vars.value"
                    class="py-2"
                />
            </twig:Molecules:Accordion:Content>
        </twig:Molecules:Accordion:Item>
    </twig:Molecules:Accordion:Base>
{%- endblock range_group_row -%}

{%- block range_filter_row -%}
    <twig:Molecules:Accordion:Base id="{{ id }}-accordion">
        <twig:Molecules:Accordion:Item value="{{ id }}" class="FilterAccordion">
            <twig:Molecules:Accordion:Trigger iconClosed="plus" iconOpen="minus" class="paragraph-2 py-3">
                {{ label|trans }}
            </twig:Molecules:Accordion:Trigger>
            <twig:Molecules:Accordion:Content>
                {{ form_widget(form) }}
            </twig:Molecules:Accordion:Content>
        </twig:Molecules:Accordion:Item>
    </twig:Molecules:Accordion:Base>
{%- endblock range_filter_row -%}
