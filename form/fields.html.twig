{% block form_row %}
  {% set type = form.vars.block_prefixes|slice(-2, 1)[0] %}
  {% set widget_value = form.vars.value %}
  {% set widget_attr = form.vars.attr %}
  {% set label = label is defined ? label : form.vars.label %}
  {% set placeholder = placeholder is defined ? placeholder : form.vars.placeholder is defined ? form.vars.placeholder :  form.vars.help is defined ? form.vars.help : null %}

  {% set errors = [] %}

  {% for error in form.vars.errors %}
    {% set errors = errors + [error.message] %}
  {% endfor %}

	{% if type == 'checkbox' %}
		{% include "@components/Atoms/Form/Checkbox.html.twig" with {
      name: form.vars.full_name,
    } %}
	{% elseif type == 'filter' %}
		{% include '@formTwig/fields/filter.html.twig' with {choices: form.vars.choices, title: form.vars.label, values: widget_value} %}
		{{ form_errors(form) }}
	{% elseif type == 'sort' %}
		{% include '@formTwig/fields/sort.html.twig' with {choices: form.vars.choices, title: form.vars.label, values: widget_value} %}
		{{ form_errors(form) }}
  {% elseif type == 'choice' %}
    {% if form.vars.expanded %}
      {% include '@formTwig/fields/choice.html.twig' with {choices: form.vars.choices, title: form.vars.label, values: widget_value } %}
    {% else %}
      {% include '@formTwig/fields/select.html.twig' with {choices: form.vars.choices, title: form.vars.label,  value: form.vars.value, required: form.vars.required } %}
    {% endif %}
    {{ form_errors(form) }}
	{% elseif type == 'pill' %}
		{% include '@formTwig/fields/choice.html.twig' with {choices: form.vars.choices, title: form.vars.label, values: widget_value } %}
    
  {% elseif type == 'search' %}
    {% include "@components/Molecules/Fields/FieldInput/FieldInput.html.twig" with {
      label:  label,
      name: form.vars.full_name,
      id: form.vars.id,
      type: type,
      placeholder: placeholder,
      required: form.vars.required,
      errors: errors,
      iconButton: "search"
  } %}
	{% elseif type == 'text' or type == 'email' %}
		{% include "@components/Molecules/Fields/FieldInput/FieldInput.html.twig" with {
      label:  label,
      name: form.vars.full_name,
      id: form.vars.id,
      type: type,
      placeholder: placeholder,
      required: form.vars.required,
      errors: errors
    } %}

	{% elseif type == 'password' %}
		{% include "@components/Molecules/Fields/FieldInput/FieldInput.html.twig" with {
      label: label,
      name: form.vars.full_name,
      id: form.vars.id,
      type: type,
      placeholder: placeholder,
      required: form.vars.required,
      errors: errors
    } %}
		{% if widget_attr.password_control %}
			{% include "@components/Molecules/PasswordControls/PasswordControls.html.twig" with {
          control : form.vars.id,
        } %}
		{% endif %}
	{% elseif type == 'textarea'  %}
		{% include "@components/Molecules/Fields/FieldTextArea/FieldTextArea.html.twig" with {
        label: label,
        name: form.vars.full_name,
        placeholder: placeholder,
        required: form.vars.required,
        errors: errors
      } %}
	{% elseif  type == 'tel' %}
		{% include "@components/Molecules/Fields/FieldInput/FieldInput.html.twig" with {
      label: label,
      name: form.vars.full_name,
      id: form.vars.id,
      type,
      placeholder: placeholder,
      required: form.vars.required,
    } %}
	{%  else %}
		{# Appel du rendu par défaut si vous n'avez pas besoin de personnaliser davantage #}
		{{ block('form_widget_simple') }}
		{{ form_errors(form) }}
	{% endif %}


{% endblock %}

{% block form_errors %}
  {% for error in errors %}
    {% include "@components/Organisms/SnackBar/SnackBar.html.twig" with {text: error.message, variant: 'error', withIcon:true,size: "full"} %}
  {% endfor %}
{% endblock %}


{% block fieldset_row %}
  {% set class = form.vars.attr.class|default('') %}
  {% set label = form.vars.label|default(null) %}
  <fieldset {% if class %} class="Fieldset {{ class }}" {% endif %}>
    {% if label %}
      <legend class="Fieldset-legend {{ form.vars.label_attr.class|default(" ") }}">{{ label }}</legend>
    {% endif %}
    <ul class="Fieldset-group">
      {% for row in form.vars.form.children %}
        <li>
          {{ form_row(row) }}
        </li>
      {% endfor %}
    </ul>
  </fieldset>
{% endblock %}
