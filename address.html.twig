{% extends 'base.html.twig' %}

{% block title %}{{ 'New Address'|trans }}{% endblock %}

{% block body %}
    <div class="pt-2 pb-3 md:pt-5 md:ps-5">
        <twig:Molecules:Breadcrumb:Base :items="[
            {title: 'My addresses'|trans, url: path('account_addresses')},
            {title: 'New Address'|trans},
        ]" />
    </div>

    <div class="container-s pb-20">
        <h1 class="h3 text-black mt-4 mb-6 lg:mt-8 lg:mb-11">{{ 'New Address'|trans }}</h1>

        <twig:Forms:Address:Account
            action="{{ path('account_address_create') }}"
            successUrl="{{ path('account_addresses', {create_success: true}) }}"
            errorUrl="{{ path('account_address_new') }}"
        />
    </div>
{% endblock %}

{% block footer %}
    <twig:Layouts:Footer:Checkout />
{% endblock %}
