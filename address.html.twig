{% extends 'base.html.twig' %}

{% block title %}
    {{ 'New Address'|trans }}
{% endblock %}

{% block body %}
    <main>
        {{ component('Flexy:Button', {
            text: 'My delivery addresses'|trans,
            href: path('account_addresses'),
            color: 'minimal',
            icon_left: 'chevron-left',
            class: 'mt-2 lg:mt-6 lg:ml-5',
        }) }}

        <div class="lg:w-[400px] mx-6 lg:mx-auto mt-4 lg:mt-8 lg:mt-120 mb-20">
            <div class="text-black h3 mb-6 lg:mb-[44px]">
                {{ 'New Address'|trans }}
            </div>
            {{ component('Flexy:AccountAddressForm',{
                successParam: 'create_success'
            }) }}
        </div>
    </main>
{% endblock %}

{% block footer %}
    {{ include('@components/Layout/Footer/FooterCheckout.html.twig') }}
{% endblock %}
