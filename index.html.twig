{% extends 'base.html.twig' %}

{% block structured_data %}
    {{ SEOneWebSite() }}
    {{ SEOneWebPage() }}
    {{ SEOneLocalBusiness(logo) }}
{% endblock %}

{% block breadcrumb_json %}{% endblock %}

{% block body %}
    {% import '@Flexy/Atoms/StoreName/label.html.twig' as store_name %}
    {# The home page has no visible title; its sections are h2 and need one above them (RGAA 9.1). #}
    <h1 class="sr-only">{{ store_name.label() }}</h1>
    {{ theme_hook('home.top') }}

    <twig:Layouts:CrossSelling:Base :filters="{'productSaleElements.newness': true}" title="{{ 'New products'|trans }}" />

    <div class="bg-lighter">
        <twig:Layouts:CrossSelling:Base :filters="{'productSaleElements.promo': true}" title="{{ 'Promotions'|trans }}" />
    </div>

    <twig:Layouts:ProductCategory:Base title="{{ 'Our product categories'|trans }}" />

    <div class="bg-lighter">
        <twig:Layouts:SimilarContent:Base title="{{ 'Our news'|trans }}" />
    </div>

    {{ theme_hook('home.bottom') }}
{% endblock %}
