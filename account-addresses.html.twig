{% extends 'base.html.twig' %}

{% block title %}
    {{ 'My delivery addresses'|trans }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}

{% block body %}
    {% set addresses = resources('/api/front/account/addresses', {'customer.id': attr('customer', 'id')}) %}

    {{ component('Flexy:AccountHero', {
        title: 'My addresses'|trans,
        selected: "addresses",
        breadcrumb: [
            {
                title: 'My account'|trans,
                url: path('account_index')
            },
            {
                title: 'My addresses'|trans
            }]
    }) }}
    {% if addresses|length %}
        <div class="flex flex-col items-center justify-center mt-6 md:mt-11 mb-[80px] md:mb-[120px] px-6">
            <ul class="grid w-full max-w-screen-lg grid-cols-1 gap-6 mx-auto sm:grid-cols-2">
                {% if app.request.get('delete_success') %}
                    <div class="col-span-full">
                        {{ include('@components/Organisms/SnackBar/SnackBar.html.twig', {text: 'Your address has been deleted'|trans, variant: 'validated', withIcon: true, size: 'full'}) }}
                    </div>
                {% endif %}
                {% if app.request.get('create_success') %}
                    <div class="col-span-full">
                        {{ include('@components/Organisms/SnackBar/SnackBar.html.twig', {text: 'Your address has been created'|trans, variant: 'validated', withIcon: true, size: 'full'}) }}
                    </div>
                {% endif %}
                {% if app.request.get('update_success') %}
                    <div class="col-span-full">
                        {{ include('@components/Organisms/SnackBar/SnackBar.html.twig', {text: 'Your address has been updaded'|trans, variant: 'validated', withIcon: true, size: 'full'}) }}
                    </div>
                {% endif %}
                {% if app.request.get('default_success') %}
                    <div class="col-span-full">
                        {{ include('@components/Organisms/SnackBar/SnackBar.html.twig', {text: 'Your default address has been updaded'|trans, variant: 'validated', withIcon: true, size: 'full'}) }}
                    </div>
                {% endif %}
                {% if app.request.get('error') %}
                    <div class="col-span-full">
                        {{ include('@components/Organisms/SnackBar/SnackBar.html.twig', {text: 'An error has occurred, please try again later'|trans, variant: 'warning', withIcon: true, size: 'full'}) }}
                    </div>
                {% endif %}
                {% for address in addresses %}
                    {% set country = resources('/api/front/countries/' ~ address.country.id) %}
                    <li>
                        {{ component('Flexy:AddressCard', {
                            addressId: address.id,
                            class: 'h-full',
                            withModal: true,
                        }) }}
                    </li>
                {% endfor %}
            </ul>

            {{ component('Flexy:Button', {
                text: 'Add an address'|trans,
                class: 'mt-8 w-[340px]',
                href: path('account_address_new'),
            }) }}
        </div>
    {% else %}
        <div class="flex flex-col items-center justify-center mb-20 text-center mt-11 lg:mt-12">
            <div class="w-[135px] h-[140px] lg:w-[244px] lg:h-[253px]">
                {{ source('assets/images/nothing.svg') }}
            </div>
            <h3 class="mt-4 mb-6 h3">
                {{ 'You have no registered address yet'|trans }}
            </h3>
            {{ component('Flexy:Button', {
                text: 'Add an address'|trans,
                class: 'mt-8 w-[340px]',
                href: path('account_address_new'),
            }) }}
        </div>
    {% endif %}
{% endblock %}

{% block footer %}
    {{ include('@components/Layout/Footer/FooterCheckout.html.twig') }}
{% endblock %}

{% block modals %}
    {% set deleteModalContent %}
        <div class="h4">
            {{ 'Are you sure you want to delete this address ?'|trans }}
        </div>
        <div class="grid md:grid-cols-2 gap-4 mt-8">
            <button type="button" class="Button Button--secondary Button--fill" data-action="modal#close">
                {{ 'Cancel'|trans }}
            </button>
            <form method="post" action="" data-modal-target="confirm">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_address') }}">
                <button type="submit" class="Button Button--fill w-full">
                    {{ 'Yes'|trans }}
                </button>
            </form>
        </div>
    {% endset %}

    {{ include('@components/Molecules/Modal/Modal.html.twig', {
        name: 'confirmDeleteAddress',
        content: deleteModalContent,
    }) }}

    {% set setDefaultModalContent %}
        <div class="h4">
            {{ 'Are you sure you want to choose this address by default ?'|trans }}
        </div>
        <div class="grid md:grid-cols-2 gap-4 mt-8">
            <button type="button" class="Button Button--secondary Button--fill" data-action="modal#close">
                {{ 'Cancel'|trans }}
            </button>
            <form method="post" action="" data-modal-target="confirm">
                <input type="hidden" name="_token" value="{{ csrf_token('default_address') }}">
                <button type="submit" class="Button Button--fill w-full">
                    {{ 'Yes'|trans }}
                </button>
            </form>
        </div>
    {% endset %}

    {{ include('@components/Molecules/Modal/Modal.html.twig', {
        name: 'confirmDefaultAdress',
        content: setDefaultModalContent,
    }) }}
{% endblock %}
