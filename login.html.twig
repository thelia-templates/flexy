{% extends 'base.html.twig' %}

{% block title %}
	{{ 'Login' | trans }}
{% endblock %}

{% block body %}
	<div class="max-w-[400px] px-[25px] pt-[30px] pb-[54px] lg:px-0 lg:pt-[50px] lg:pb-[120px] mx-auto">
		{% set form = getForm("thelia.front.customer.login") %}

		{{ form_start(form, {attr: {novalidate: true}}) }}
		<h2 class="mb-4 text-black h2">{{ 'Log in' | trans }}</h2>
		<div class="flex flex-col gap-6 mb-3">
			{{ form_errors(form) }}
			<div class="flex flex-col gap-6 mb-3">
				{{ form_row(form.error_url, { value: path('customer_login') }) }}
				{{ form_row(form.success_url, { value: path('account_index') }) }}
				{{ form_row(form.email, { 'label': 'Email' | trans, placeholder: 'Your email' | trans }) }}
				{{ form_row(form.password, { 'label': 'Password' | trans, placeholder: 'Your password' | trans }) }}
				{{ form_row(form.remember_me) }}
			</div>
			<input name="{{ field_name(form.account) }}" value="1" type='hidden'>
		</div>

		<div class="flex flex-col gap-[30px]">
			{% include "@components/Molecules/Link/Link.html.twig" with {
        customText: 'Forgot password?' | trans,
        href: path('password_forgotten')
      } %}

			{% include "@components/Molecules/Button/Button.html.twig" with { text: 'Log in' | trans, classes: "w-max", type: "submit" } %}
		</div>

		{{ form_end(form) }}

		<hr class="my-[40px]"/>

		<h4 class="mb-4 text-black h4">{{ 'Don’t have an account yet?' | trans }}</h4>

		{% include "@components/Molecules/Button/Button.html.twig" with { href: path('customer_register'), text: "Sign up" | trans, variant: "secondary" } %}
	</div>
{% endblock %}
